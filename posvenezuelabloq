            self.create_product_card(product)
    
    def add_to_cart(self, product):
        """Agrega un producto al carrito"""
        # Verificar stock
        if product['stock'] <= 0:
            messagebox.showwarning("Sin Stock", f"El producto '{product['name']}' no tiene stock disponible")
            return
        
        # Buscar si el producto ya está en el carrito
        for item in self.current_cart:
            if item['id'] == product['id']:
                if item['quantity'] < product['stock']:
                    item['quantity'] += 1
                    item['total_price'] = item['quantity'] * item['unit_price']
                else:
                    messagebox.showwarning("Stock Insuficiente", 
                                         f"No hay suficiente stock para '{product['name']}'")
                    return
                break
        else:
            # Producto nuevo en el carrito
            cart_item = {
                'id': product['id'],
                'name': product['name'],
                'unit_price': product['price_usd'],
                'quantity': 1,
                'total_price': product['price_usd'],
                'max_stock': product['stock']
            }
            self.current_cart.append(cart_item)
        
        self.update_cart_display()
        self.calculate_totals()
    
    def update_cart_display(self):
        """Actualiza la visualización del carrito"""
        # Limpiar carrito actual
        for widget in self.cart_list_frame.winfo_children():
            widget.destroy()
        
        if not self.current_cart:
            CustomLabel(self.cart_list_frame, "Carrito vacío", 
                       label_type="normal").pack(pady=20)
            return
        
        for item in self.current_cart:
            self.create_cart_item(item)
    
    def create_cart_item(self, item):
        """Crea un elemento del carrito"""
        item_frame = CustomFrame(self.cart_list_frame, frame_type="card")
        item_frame.pack(fill="x", pady=2, padx=5)
        
        # Información del producto
        info_frame = CustomFrame(item_frame)
        info_frame.pack(fill="x", padx=10, pady=5)
        
        # Nombre
        CustomLabel(info_frame, item['name'], label_type="normal").pack(anchor="w")
        
        # Precio unitario
        CustomLabel(info_frame, f"${item['unit_price']:.2f} c/u", 
                   label_type="small").pack(anchor="w")
        
        # Controles de cantidad
        quantity_frame = CustomFrame(info_frame)
        quantity_frame.pack(fill="x", pady=(5, 0))
        
        # Botón disminuir
        CustomButton(quantity_frame, "➖", 
                    command=lambda i=item: self.decrease_quantity(i), 
                    button_type="warning").pack(side="left")
        
        # Cantidad actual
        CustomLabel(quantity_frame, f"  {item['quantity']}  ", 
                   label_type="normal").pack(side="left")
        
        # Botón aumentar
        CustomButton(quantity_frame, "➕", 
                    command=lambda i=item: self.increase_quantity(i), 
                    button_type="success").pack(side="left")
        
        # Total del item
        CustomLabel(quantity_frame, f"${item['total_price']:.2f}", 
                   label_type="normal").pack(side="right")
        
        # Botón eliminar
        CustomButton(quantity_frame, "🗑️", 
                    command=lambda i=item: self.remove_from_cart(i), 
                    button_type="danger").pack(side="right", padx=(10, 0))
    
    def increase_quantity(self, item):
        """Aumenta la cantidad de un producto en el carrito"""
        if item['quantity'] < item['max_stock']:
            item['quantity'] += 1
            item['total_price'] = item['quantity'] * item['unit_price']
            self.update_cart_display()
            self.calculate_totals()
        else:
            messagebox.showwarning("Stock Insuficiente", 
                                 f"No hay más stock disponible para '{item['name']}'")
    
    def decrease_quantity(self, item):
        """Disminuye la cantidad de un producto en el carrito"""
        if item['quantity'] > 1:
            item['quantity'] -= 1
            item['total_price'] = item['quantity'] * item['unit_price']
            self.update_cart_display()
            self.calculate_totals()
        else:
            self.remove_from_cart(item)
    
    def remove_from_cart(self, item):
        """Elimina un producto del carrito"""
        self.current_cart.remove(item)
        self.update_cart_display()
        self.calculate_totals()
    
    def clear_cart(self):
        """Limpia todo el carrito"""
        if self.current_cart:
            if messagebox.askyesno("Confirmar", "¿Está seguro de que desea limpiar el carrito?"):
                self.current_cart.clear()
                self.update_cart_display()
                self.calculate_totals()
    
    def calculate_totals(self):
        """Calcula y actualiza los totales"""
        subtotal = sum(item['total_price'] for item in self.current_cart)
        self.current_total = subtotal
        
        # Actualizar labels
        self.subtotal_label.config(text=f"Subtotal: ${subtotal:.2f}")
        self.total_usd_label.config(text=f"Total USD: ${self.current_total:.2f}")
        
        total_ves = self.exchange_manager.convert_usd_to_ves(self.current_total)
        self.total_ves_label.config(text=f"Total VES: Bs. {total_ves:,.2f}")
    
    def apply_discount(self):
        """Aplica un descuento al total"""
        if not self.current_cart:
            messagebox.showwarning("Carrito Vacío", "No hay productos en el carrito")
            return
        
        discount_dialog = DiscountDialog(self.root, self.current_total)
        self.root.wait_window(discount_dialog.window)
        
        if discount_dialog.result and discount_dialog.discount_percentage > 0:
            discount_amount = self.current_total * (discount_dialog.discount_percentage / 100)
            self.current_total -= discount_amount
            
            # Actualizar displays
            self.total_usd_label.config(text=f"Total USD: ${self.current_total:.2f} (Desc. {discount_dialog.discount_percentage}%)")
            total_ves = self.exchange_manager.convert_usd_to_ves(self.current_total)
            self.total_ves_label.config(text=f"Total VES: Bs. {total_ves:,.2f}")
    
    def process_payment(self):
        """Procesa el pago de la venta"""
        if not self.current_cart:
            messagebox.showwarning("Carrito Vacío", "No hay productos en el carrito")
            return
        
        # Diálogo de pago
        payment_dialog = PaymentDialog(self.root, self.current_total, self.exchange_manager)
        self.root.wait_window(payment_dialog.window)
        
        if payment_dialog.result and payment_dialog.payment_data:
            # Procesar la venta
            sale_data = {
                'items': self.current_cart.copy(),
                'subtotal': sum(item['total_price'] for item in self.current_cart),
                'total': self.current_total,
                'payment_info': payment_dialog.payment_data,
                'exchange_rate': self.exchange_manager.current_rate
            }
            
            # Guardar la venta
            sale_id = self.sales_manager.record_sale(sale_data)
            
            # Actualizar inventario
            for item in self.current_cart:
                self.inventory_manager.update_stock(item['id'], -item['quantity'])
            
            # Mostrar recibo
            sale_record = self.sales_manager.get_sale(sale_id)
            receipt_dialog = ReceiptDialog(self.root, sale_record, self.exchange_manager.current_rate)
            self.root.wait_window(receipt_dialog.window)
            
            # Limpiar carrito y actualizar displays
            self.current_cart.clear()
            self.current_total = 0.0
            self.update_cart_display()
            self.calculate_totals()
            self.refresh_products()
            
            messagebox.showinfo("Venta Completada", f"Venta #{sale_id} procesada exitosamente")
    
    def add_product_dialog(self):
        """Muestra el diálogo para agregar productos"""
        dialog = AddProductDialog(self.root, self.exchange_manager)
        self.root.wait_window(dialog.window)
        
        if dialog.result and dialog.product_data:
            product_id = self.inventory_manager.add_product(dialog.product_data)
            if product_id:
                messagebox.showinfo("Producto Agregado", 
                                  f"Producto '{dialog.product_data['name']}' agregado exitosamente")
                self.refresh_products()
            else:
                messagebox.showerror("Error", "No se pudo agregar el producto")
    
