        cancel_btn = CustomButton(buttons_frame, "❌ Cancelar", 
                                 command=self._on_cancel, button_type="secondary")
        cancel_btn.pack(side="right", padx=(10, 0))
        
        save_btn = CustomButton(buttons_frame, "💾 Guardar", 
                               command=self._save_product, button_type="success")
        save_btn.pack(side="right")
    
    def _update_ves_price(self, event=None):
        """Actualiza el precio en VES cuando cambia el precio USD"""
        try:
            usd_price = float(self.price_usd_entry.get() or 0)
            profit_percent = float(self.profit_entry.get() or 0)
            
            # Aplicar porcentaje de ganancia
            final_usd_price = usd_price * (1 + profit_percent / 100)
            ves_price = self.exchange_manager.convert_usd_to_ves(final_usd_price)
            
            self.price_ves_label.config(text=f"Bs. {ves_price:,.2f}")
        except ValueError:
            self.price_ves_label.config(text="Bs. 0.00")
    
    def _update_final_price(self, event=None):
        """Actualiza el precio final cuando cambia el porcentaje de ganancia"""
        self._update_ves_price()
    
    def _save_product(self):
        """Guarda el producto"""
        try:
            name = self.name_entry.get().strip()
            price_usd = float(self.price_usd_entry.get() or 0)
            stock = int(float(self.stock_entry.get() or 0))
            profit_percent = float(self.profit_entry.get() or 0)
            
            if not name:
                messagebox.showerror("Error", "El nombre del producto es obligatorio")
                return
            
            if price_usd <= 0:
                messagebox.showerror("Error", "El precio debe ser mayor que cero")
                return
            
            if stock < 0:
                messagebox.showerror("Error", "El stock no puede ser negativo")
                return
            
            # Aplicar porcentaje de ganancia al precio
            final_price_usd = price_usd * (1 + profit_percent / 100)
            
            self.product_data = {
                'name': name,
                'price_usd': final_price_usd,
                'stock': stock,
                'profit_percentage': profit_percent
            }
            
            self.result = True
            self.window.destroy()
            
        except ValueError:
            messagebox.showerror("Error", "Por favor ingrese valores numéricos válidos")

