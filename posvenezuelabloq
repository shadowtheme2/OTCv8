            },
            {
                'name': 'Atún en Lata',
                'price_usd': 2.25,
                'stock': 22,
                'profit_percentage': 0
            },
            {
                'name': 'Jabón de Baño',
                'price_usd': 1.00,
                'stock': 35,
                'profit_percentage': 0
            }
        ]
        
        for product_data in sample_products:
            self.add_product(product_data)
    
    def add_product(self, product_data):
        """Agrega un nuevo producto al inventario"""
        try:
            product_id = self.next_id
            
            # Validar datos requeridos
            if not product_data.get('name'):
                raise ValueError("El nombre del producto es requerido")
            
            if not isinstance(product_data.get('price_usd'), (int, float)) or product_data['price_usd'] <= 0:
                raise ValueError("El precio debe ser un número positivo")
            
            if not isinstance(product_data.get('stock'), int) or product_data['stock'] < 0:
                raise ValueError("El stock debe ser un número entero no negativo")
            
            # Crear el producto
            product = {
                'id': product_id,
                'name': product_data['name'].strip(),
                'price_usd': float(product_data['price_usd']),
                'stock': int(product_data['stock']),
                'profit_percentage': float(product_data.get('profit_percentage', 0)),
                'created_at': datetime.now().isoformat(),
                'updated_at': datetime.now().isoformat()
            }
            
            # Verificar que no exista un producto con el mismo nombre
            for existing_product in self.products.values():
                if existing_product['name'].lower() == product['name'].lower():
                    raise ValueError(f"Ya existe un producto con el nombre '{product['name']}'")
            
            # Agregar al inventario
            self.products[product_id] = product
            self.next_id += 1
            
            # Guardar cambios
            self.save_inventory()
            
            return product_id
            
        except Exception as e:
            print(f"Error agregando producto: {e}")
            return None
    
    def get_product(self, product_id):
        """Obtiene un producto por su ID"""
        return self.products.get(product_id)
    
    def get_all_products(self):
        """Obtiene todos los productos como lista"""
        return list(self.products.values())
    
    def update_product(self, product_id, updates):
        """Actualiza un producto existente"""
        try:
            if product_id not in self.products:
                raise ValueError(f"Producto con ID {product_id} no encontrado")
            
            product = self.products[product_id]
            
            # Actualizar campos permitidos
            allowed_fields = ['name', 'price_usd', 'stock', 'profit_percentage']
            
            for field, value in updates.items():
                if field in allowed_fields:
                    if field == 'name' and value:
                        # Verificar nombre único (excluyendo el producto actual)
                        for pid, existing_product in self.products.items():
                            if pid != product_id and existing_product['name'].lower() == value.lower():
                                raise ValueError(f"Ya existe un producto con el nombre '{value}'")
                        product[field] = value.strip()
                    
                    elif field == 'price_usd':
                        if not isinstance(value, (int, float)) or value <= 0:
                            raise ValueError("El precio debe ser un número positivo")
                        product[field] = float(value)
                    
                    elif field == 'stock':
                        if not isinstance(value, int) or value < 0:
                            raise ValueError("El stock debe ser un número entero no negativo")
                        product[field] = int(value)
                    
                    elif field == 'profit_percentage':
                        product[field] = float(value)
            
            # Actualizar timestamp
            product['updated_at'] = datetime.now().isoformat()
            
            # Guardar cambios
            self.save_inventory()
            
            return True
            
        except Exception as e:
            print(f"Error actualizando producto: {e}")
            return False
    
    def update_stock(self, product_id, quantity_change):
        """Actualiza el stock de un producto (puede ser positivo o negativo)"""
        try:
            if product_id not in self.products:
                raise ValueError(f"Producto con ID {product_id} no encontrado")
            
            product = self.products[product_id]
            new_stock = product['stock'] + quantity_change
            
            if new_stock < 0:
                raise ValueError(f"Stock insuficiente. Stock actual: {product['stock']}, cambio solicitado: {quantity_change}")
            
            product['stock'] = new_stock
            product['updated_at'] = datetime.now().isoformat()
            
            # Guardar cambios
            self.save_inventory()
            
            return True
            
        except Exception as e:
            print(f"Error actualizando stock: {e}")
            return False
    
    def delete_product(self, product_id):
        """Elimina un producto del inventario"""
        try:
            if product_id not in self.products:
                raise ValueError(f"Producto con ID {product_id} no encontrado")
            
            deleted_product = self.products.pop(product_id)
            
            # Guardar cambios
            self.save_inventory()
            
            return deleted_product
            
        except Exception as e:
            print(f"Error eliminando producto: {e}")
            return None
    
    def search_products(self, search_term):
        """Busca productos por nombre"""
        search_term = search_term.lower().strip()
        results = []
        
        for product in self.products.values():
            if search_term in product['name'].lower():
                results.append(product)
        
        return results
    
    def get_low_stock_products(self, threshold=5):
        """Obtiene productos con stock bajo"""
        low_stock = []
        
        for product in self.products.values():
            if product['stock'] <= threshold:
                low_stock.append(product)
        
        return low_stock
    
    def get_out_of_stock_products(self):
        """Obtiene productos sin stock"""
        return [product for product in self.products.values() if product['stock'] == 0]
    
    def get_inventory_value(self, exchange_manager=None):
        """Calcula el valor total del inventario"""
        total_usd = 0
        
        for product in self.products.values():
            total_usd += product['price_usd'] * product['stock']
        
        result = {'total_usd': total_usd}
        
        if exchange_manager:
            result['total_ves'] = exchange_manager.convert_usd_to_ves(total_usd)
        
        return result
    
    def get_inventory_summary(self):
        """Obtiene un resumen del inventario"""
        total_products = len(self.products)
        total_items = sum(product['stock'] for product in self.products.values())
        low_stock_count = len(self.get_low_stock_products())
        out_of_stock_count = len(self.get_out_of_stock_products())
        
        return {
            'total_products': total_products,
            'total_items': total_items,
            'low_stock_count': low_stock_count,
            'out_of_stock_count': out_of_stock_count
        }
    
    def export_inventory(self, filename=None):
        """Exporta el inventario a un archivo CSV"""
        try:
            if not filename:
                from datetime import datetime
                timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
                filename = f"data/inventory_export_{timestamp}.csv"
            
            import csv
            
            # Crear directorio si no existe
            os.makedirs(os.path.dirname(filename), exist_ok=True)
            
            with open(filename, 'w', newline='', encoding='utf-8') as csvfile:
                fieldnames = ['ID', 'Nombre', 'Precio USD', 'Stock', 'Porcentaje Ganancia', 'Creado', 'Actualizado']
                writer = csv.DictWriter(csvfile, fieldnames=fieldnames)
                
                writer.writeheader()
                for product in self.products.values():
                    writer.writerow({
                        'ID': product['id'],
                        'Nombre': product['name'],
                        'Precio USD': product['price_usd'],
                        'Stock': product['stock'],
                        'Porcentaje Ganancia': product['profit_percentage'],
                        'Creado': product['created_at'],
                        'Actualizado': product['updated_at']
                    })
            
            return filename
            
        except Exception as e:
            print(f"Error exportando inventario: {e}")
            return None
    
    def backup_inventory(self):
        """Crea una copia de seguridad del inventario"""
        try:
            from datetime import datetime
            timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
            backup_filename = f"data/inventory_backup_{timestamp}.json"
            
            # Crear directorio si no existe
            os.makedirs(os.path.dirname(backup_filename), exist_ok=True)
            
            # Copiar archivo actual
            import shutil
            if os.path.exists(self.data_file):
                shutil.copy2(self.data_file, backup_filename)
                return backup_filename
            
        except Exception as e:
            print(f"Error creando backup: {e}")
            return None


class ExchangeManager:
    def __init__(self):
        self.current_rate = 36.0  # Tasa por defecto
        self.last_update = None
        self.api_url = "https://api.exchangerate-api.com/v4/latest/USD"
        self.backup_apis = [
            "https://api.fixer.io/latest?base=USD&symbols=VES",
            "https://v6.exchangerate-api.com/v6/YOUR_API_KEY/latest/USD"
        ]
    
    def update_exchange_rate(self):
        """Actualiza la tasa de cambio desde APIs externas"""
        try:
            # Intentar con la API principal
            response = requests.get(self.api_url, timeout=10)
            
            if response.status_code == 200:
                data = response.json()
                
                # Buscar tasa VES
                if 'rates' in data and 'VES' in data['rates']:
                    new_rate = float(data['rates']['VES'])
                    
                    # Validar que la tasa sea razonable (entre 1 y 1000)
                    if 1 <= new_rate <= 1000:
                        self.current_rate = new_rate
                        self.last_update = datetime.now()
                        print(f"Tasa actualizada: 1 USD = {self.current_rate:.2f} VES")
                        return True
                
            # Si falla, usar tasa por defecto con incremento aleatorio
            self._use_fallback_rate()
            return False
            
        except requests.exceptions.RequestException as e:
            print(f"Error conectando a API de cambio: {e}")
            self._use_fallback_rate()
            return False
        except Exception as e:
            print(f"Error actualizando tasa de cambio: {e}")
            self._use_fallback_rate()
            return False

    def update_rate(self):
        """Alias para update_exchange_rate()"""
        return self.update_exchange_rate()

    def _use_fallback_rate(self):
        """Usa una tasa de respaldo con variación simulada"""
        import random
        
        # Simular variación del mercado (±5%)
        base_rate = 36.0
        variation = random.uniform(-0.05, 0.05)
        self.current_rate = base_rate * (1 + variation)
        self.last_update = datetime.now()
        print(f"Usando tasa de respaldo: 1 USD = {self.current_rate:.2f} VES")
    
    def convert_usd_to_ves(self, usd_amount):
        """Convierte USD a VES"""
        return usd_amount * self.current_rate
    
    def convert_ves_to_usd(self, ves_amount):
        """Convierte VES a USD"""
        ves_amount = float(ves_amount) if ves_amount else 0
        return ves_amount / self.current_rate
    
    def get_rate_info(self):
        """Obtiene información sobre la tasa actual"""
        return {
            'rate': self.current_rate,
            'last_update': self.last_update,
            'formatted_rate': f"1 USD = {self.current_rate:,.2f} VES"
        }
    
    def is_rate_stale(self, max_age_minutes=30):
        """Verifica si la tasa necesita actualización"""
        if not self.last_update:
            return True
        
        from datetime import timedelta
        age = datetime.now() - self.last_update
        return age > timedelta(minutes=max_age_minutes)

