        self.exchange_manager = exchange_manager
        self.payment_data = None
        super().__init__(parent, "💳 Procesar Pago", "600x500")
        self.setup_ui()
    
    def setup_ui(self):
        """Configura la interfaz de pago"""
        main_frame = CustomFrame(self.window)
        main_frame.pack(fill="both", expand=True, padx=20, pady=20)
        
        # Título
        CustomLabel(main_frame, "Procesar Pago", label_type="title").pack(pady=(0, 20))
        
        # Totales
        total_ves = self.exchange_manager.convert_usd_to_ves(self.total_usd)
        
        totals_frame = CustomFrame(main_frame, frame_type="card")
        totals_frame.pack(fill="x", pady=(0, 20))
        
        CustomLabel(totals_frame, f"Total a Pagar: ${self.total_usd:.2f} | Bs. {total_ves:,.2f}", 
                   label_type="large").pack(pady=10)
        
        # Método de pago
        CustomLabel(main_frame, "Método de Pago:", label_type="subtitle").pack(anchor="w", pady=(10, 5))
        
        self.payment_method = tk.StringVar(value="USD")
        
        methods_frame = CustomFrame(main_frame)
        methods_frame.pack(fill="x", pady=(0, 20))
        
        tk.Radiobutton(methods_frame, text="💵 Solo USD", variable=self.payment_method, 
                      value="USD", font=self.style_manager.fonts["normal"],
                      command=self._on_method_change).pack(side="left", padx=(0, 20))
        
        tk.Radiobutton(methods_frame, text="💰 Solo Bolívares", variable=self.payment_method, 
                      value="VES", font=self.style_manager.fonts["normal"],
                      command=self._on_method_change).pack(side="left", padx=(0, 20))
        
        tk.Radiobutton(methods_frame, text="🔄 Mixto", variable=self.payment_method, 
                      value="MIXTO", font=self.style_manager.fonts["normal"],
                      command=self._on_method_change).pack(side="left")
        
        # Frame para montos recibidos
        self.amounts_frame = CustomFrame(main_frame)
        self.amounts_frame.pack(fill="x", pady=(0, 20))
        
        # Frame para cambio
        self.change_frame = CustomFrame(main_frame)
        self.change_frame.pack(fill="x", pady=(0, 20))
        
        # Inicializar campos
        self._setup_payment_fields()
        
        # Botones
        buttons_frame = CustomFrame(main_frame)
        buttons_frame.pack(fill="x", pady=20)
        
        cancel_btn = CustomButton(buttons_frame, "❌ Cancelar", 
                                 command=self._on_cancel, button_type="secondary")
        cancel_btn.pack(side="right", padx=(10, 0))
        
        process_btn = CustomButton(buttons_frame, "✅ Procesar Pago", 
                                  command=self._process_payment, button_type="success")
        process_btn.pack(side="right")
    
    def _setup_payment_fields(self):
        """Configura los campos de pago según el método seleccionado"""
        # Limpiar frames
        for widget in self.amounts_frame.winfo_children():
            widget.destroy()
        for widget in self.change_frame.winfo_children():
            widget.destroy()
        
        method = self.payment_method.get()
        
        if method == "USD":
            self._setup_usd_only()
        elif method == "VES":
            self._setup_ves_only()
        else:  # MIXTO
            self._setup_mixed_payment()
    
    def _setup_usd_only(self):
        """Configura pago solo en USD"""
        CustomLabel(self.amounts_frame, "Monto Recibido USD:", label_type="normal").pack(anchor="w")
        self.usd_received_entry = tk.Entry(self.amounts_frame, font=self.style_manager.fonts["normal"])
        self.usd_received_entry.pack(pady=(5, 10), fill="x")
        self.usd_received_entry.insert(0, str(self.total_usd))
        self.usd_received_entry.bind('<KeyRelease>', self._calculate_change)
        self.usd_received_entry.focus_set()
        
        # Cambio
        CustomLabel(self.change_frame, "Cambio:", label_type="subtitle").pack(anchor="w")
        self.change_usd_label = CustomLabel(self.change_frame, "USD: $0.00", label_type="normal")
        self.change_usd_label.pack(anchor="w")
        self.change_ves_label = CustomLabel(self.change_frame, "VES: Bs. 0.00", label_type="normal")
        self.change_ves_label.pack(anchor="w")
    
    def _setup_ves_only(self):
        """Configura pago solo en Bolívares"""
        total_ves = self.exchange_manager.convert_usd_to_ves(self.total_usd)
        
        CustomLabel(self.amounts_frame, "Monto Recibido VES:", label_type="normal").pack(anchor="w")
        self.ves_received_entry = tk.Entry(self.amounts_frame, font=self.style_manager.fonts["normal"])
        self.ves_received_entry.pack(pady=(5, 10), fill="x")
        self.ves_received_entry.insert(0, f"{total_ves:.2f}")
        self.ves_received_entry.bind('<KeyRelease>', self._calculate_change)
        self.ves_received_entry.focus_set()
        
        # Cambio
        CustomLabel(self.change_frame, "Cambio:", label_type="subtitle").pack(anchor="w")
        self.change_ves_label = CustomLabel(self.change_frame, "VES: Bs. 0.00", label_type="normal")
        self.change_ves_label.pack(anchor="w")
    
    def _setup_mixed_payment(self):
        """Configura pago mixto"""
        # Montos recibidos
        CustomLabel(self.amounts_frame, "Montos Recibidos:", label_type="subtitle").pack(anchor="w")
        
        CustomLabel(self.amounts_frame, "USD Recibidos:", label_type="normal").pack(anchor="w")
        self.usd_received_entry = tk.Entry(self.amounts_frame, font=self.style_manager.fonts["normal"])
        self.usd_received_entry.pack(pady=(5, 10), fill="x")
        self.usd_received_entry.bind('<KeyRelease>', self._calculate_mixed_payment)
        self.usd_received_entry.focus_set()
        
        CustomLabel(self.amounts_frame, "VES Recibidos:", label_type="normal").pack(anchor="w")
        self.ves_received_entry = tk.Entry(self.amounts_frame, font=self.style_manager.fonts["normal"])
        self.ves_received_entry.pack(pady=(5, 10), fill="x")
        self.ves_received_entry.bind('<KeyRelease>', self._calculate_mixed_payment)
        
        # Cambio
        CustomLabel(self.change_frame, "Cambio:", label_type="subtitle").pack(anchor="w")
        
        CustomLabel(self.change_frame, "Cambio USD (editable):", label_type="normal").pack(anchor="w")
        self.change_usd_entry = tk.Entry(self.change_frame, font=self.style_manager.fonts["normal"])
        self.change_usd_entry.pack(pady=(5, 5), fill="x")
        self.change_usd_entry.bind('<KeyRelease>', self._update_ves_change)
        
        self.change_ves_label = CustomLabel(self.change_frame, "Cambio VES: Bs. 0.00", label_type="normal")
        self.change_ves_label.pack(anchor="w", pady=(5, 0))
    
    def _on_method_change(self):
        """Maneja el cambio de método de pago"""
        self._setup_payment_fields()
    
    def _calculate_change(self, event=None):
        """Calcula el cambio para pagos simples"""
        method = self.payment_method.get()
        
        try:
            if method == "USD":
                received = float(self.usd_received_entry.get() or 0)
                change_usd = max(0, received - self.total_usd)
                change_ves = self.exchange_manager.convert_usd_to_ves(change_usd)
                
                self.change_usd_label.config(text=f"USD: ${change_usd:.2f}")
                self.change_ves_label.config(text=f"VES: Bs. {change_ves:,.2f}")
                
            elif method == "VES":
                received = float(self.ves_received_entry.get() or 0)
                total_ves = self.exchange_manager.convert_usd_to_ves(self.total_usd)
                change_ves = max(0, received - total_ves)
                
                self.change_ves_label.config(text=f"VES: Bs. {change_ves:,.2f}")
                
        except ValueError:
            pass
    
    def _calculate_mixed_payment(self, event=None):
        """Calcula el pago mixto automáticamente"""
        try:
            usd_received = float(self.usd_received_entry.get() or 0)
            ves_received = float(self.ves_received_entry.get() or 0)
            
            # Convertir todo a USD para calcular
            total_received_usd = usd_received + self.exchange_manager.convert_ves_to_usd(ves_received)
            
            if total_received_usd > self.total_usd:
                # Hay cambio
                change_total_usd = total_received_usd - self.total_usd
                self.change_usd_entry.delete(0, tk.END)
                self.change_usd_entry.insert(0, f"{change_total_usd:.2f}")
                self._update_ves_change()
            else:
                # Calcular cuánto falta en VES
                remaining_usd = self.total_usd - total_received_usd
                remaining_ves = self.exchange_manager.convert_usd_to_ves(remaining_usd)
                
                if remaining_usd > 0:
                    current_ves = float(self.ves_received_entry.get() or 0)
                    suggested_ves = current_ves + remaining_ves
                    self.ves_received_entry.delete(0, tk.END)
                    self.ves_received_entry.insert(0, f"{suggested_ves:.2f}")
                
        except ValueError:
            pass
    
    def _update_ves_change(self, event=None):
        """Actualiza el cambio en VES basado en el cambio USD"""
        try:
            change_usd = float(self.change_usd_entry.get() or 0)
            
            # Calcular el cambio total
            usd_received = float(self.usd_received_entry.get() or 0)
            ves_received = float(self.ves_received_entry.get() or 0)
            total_received_usd = usd_received + self.exchange_manager.convert_ves_to_usd(ves_received)
            
            total_change_usd = total_received_usd - self.total_usd
            remaining_change_usd = max(0, total_change_usd - change_usd)
            change_ves = self.exchange_manager.convert_usd_to_ves(remaining_change_usd)
            
            self.change_ves_label.config(text=f"Cambio VES: Bs. {change_ves:,.2f}")
            
        except ValueError:
            self.change_ves_label.config(text="Cambio VES: Bs. 0.00")
    
    def _process_payment(self):
        """Procesa el pago"""
        try:
            method = self.payment_method.get()
            
            if method == "USD":
                usd_received = float(self.usd_received_entry.get() or 0)
                if usd_received < self.total_usd:
                    messagebox.showerror("Error", "El monto recibido es insuficiente")
                    return
                
                change_usd = usd_received - self.total_usd
                
                self.payment_data = {
                    'method': 'USD',
                    'usd_received': usd_received,
                    'ves_received': 0,
                    'usd_change': change_usd,
                    'ves_change': 0
                }
                
            elif method == "VES":
                ves_received = float(self.ves_received_entry.get() or 0)
                total_ves = self.exchange_manager.convert_usd_to_ves(self.total_usd)
                
                if ves_received < total_ves:
                    messagebox.showerror("Error", "El monto recibido es insuficiente")
                    return
                
                change_ves = ves_received - total_ves
                
                self.payment_data = {
                    'method': 'VES',
                    'usd_received': 0,
                    'ves_received': ves_received,
                    'usd_change': 0,
                    'ves_change': change_ves
                }
                
            else:  # MIXTO
                usd_received = float(self.usd_received_entry.get() or 0)
                ves_received = float(self.ves_received_entry.get() or 0)
                change_usd = float(self.change_usd_entry.get() or 0)
                
                total_received_usd = usd_received + self.exchange_manager.convert_ves_to_usd(ves_received)
                
                if total_received_usd < self.total_usd:
                    messagebox.showerror("Error", "El monto total recibido es insuficiente")
                    return
                
                total_change_usd = total_received_usd - self.total_usd
                change_ves_usd = total_change_usd - change_usd
                change_ves = self.exchange_manager.convert_usd_to_ves(change_ves_usd)
                
                self.payment_data = {
                    'method': 'MIXTO',
                    'usd_received': usd_received,
                    'ves_received': ves_received,
                    'usd_change': change_usd,
                    'ves_change': change_ves
                }
            
            self.result = True
            self.window.destroy()
            
        except ValueError:
            messagebox.showerror("Error", "Por favor ingrese valores numéricos válidos")

