class DatabaseManager:
    def __init__(self):
        self.db_file = DATABASE_FILE
        self.init_database()
    
    def init_database(self):
        """Inicializa la base de datos"""
        conn = sqlite3.connect(self.db_file)
        cursor = conn.cursor()
        
        # Tabla de productos
        cursor.execute('''
            CREATE TABLE IF NOT EXISTS products (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                name TEXT NOT NULL,
                price_usd REAL NOT NULL,
                stock INTEGER NOT NULL DEFAULT 0,
                profit_percentage REAL DEFAULT 0
            )
        ''')
        
        # Tabla de ventas
        cursor.execute('''
            CREATE TABLE IF NOT EXISTS sales (
                id TEXT PRIMARY KEY,
                timestamp TEXT NOT NULL,
                total_usd REAL NOT NULL,
                total_ves REAL NOT NULL,
                payment_method TEXT NOT NULL,
                usd_received REAL DEFAULT 0,
                ves_received REAL DEFAULT 0,
                usd_change REAL DEFAULT 0,
                ves_change REAL DEFAULT 0,
                exchange_rate REAL NOT NULL,
                items TEXT NOT NULL,
                discount_percentage REAL DEFAULT 0
            )
        ''')
        
        conn.commit()
        conn.close()
    
    def add_product(self, name, price_usd, stock, profit_percentage=0):
        """Agrega un producto"""
        conn = sqlite3.connect(self.db_file)
        cursor = conn.cursor()
        cursor.execute('''
            INSERT INTO products (name, price_usd, stock, profit_percentage)
            VALUES (?, ?, ?, ?)
        ''', (name, price_usd, stock, profit_percentage))
        conn.commit()
        conn.close()
    
    def get_products(self, search_term=""):
        """Obtiene productos con búsqueda opcional"""
        conn = sqlite3.connect(self.db_file)
        cursor = conn.cursor()
        
        if search_term:
            cursor.execute('''
                SELECT * FROM products 
                WHERE name LIKE ? OR id LIKE ?
                ORDER BY name
            ''', (f'%{search_term}%', f'%{search_term}%'))
        else:
            cursor.execute('SELECT * FROM products ORDER BY name')
        
        products = cursor.fetchall()
        conn.close()
        return products
    
    def update_stock(self, product_id, quantity_sold):
        """Actualiza el stock de un producto"""
        conn = sqlite3.connect(self.db_file)
        cursor = conn.cursor()
        cursor.execute('''
            UPDATE products SET stock = stock - ? WHERE id = ?
        ''', (quantity_sold, product_id))
        conn.commit()
        conn.close()
    
    def save_sale(self, sale_data):
        """Guarda una venta"""
        conn = sqlite3.connect(self.db_file)
        cursor = conn.cursor()
        cursor.execute('''
            INSERT INTO sales (id, timestamp, total_usd, total_ves, payment_method,
                             usd_received, ves_received, usd_change, ves_change,
                             exchange_rate, items, discount_percentage)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
        ''', (
            sale_data['id'], sale_data['timestamp'], sale_data['total_usd'],
            sale_data['total_ves'], sale_data['payment_method'],
            sale_data['usd_received'], sale_data['ves_received'],
            sale_data['usd_change'], sale_data['ves_change'],
            sale_data['exchange_rate'], json.dumps(sale_data['items']),
            sale_data['discount_percentage']
        ))
        conn.commit()
        conn.close()
    
    def get_daily_sales(self, date=None):
        """Obtiene las ventas del día"""
        if date is None:
            date = datetime.datetime.now().strftime('%Y-%m-%d')
        
        conn = sqlite3.connect(self.db_file)
        cursor = conn.cursor()
        cursor.execute('''
            SELECT * FROM sales 
            WHERE date(timestamp) = ?
            ORDER BY timestamp
        ''', (date,))
        
        sales = cursor.fetchall()
        conn.close()
        return sales

class SalesManager:
    def __init__(self, data_file="data/sales.json"):
        self.data_file = data_file
        self.sales = {}
        self.next_id = 1
        self.load_sales()
    
    def load_sales(self):
        """Carga las ventas desde el archivo"""
        try:
            if os.path.exists(self.data_file):
                with open(self.data_file, 'r', encoding='utf-8') as f:
                    data = json.load(f)
                    self.sales = data.get('sales', {})
                    self.next_id = data.get('next_id', 1)
                    
                    # Convertir IDs de string a int si es necesario
                    if self.sales:
                        converted_sales = {}
                        for key, value in self.sales.items():
                            converted_sales[int(key)] = value
                        self.sales = converted_sales
            else:
                self.sales = {}
                self.next_id = 1
                
        except Exception as e:
            print(f"Error cargando ventas: {e}")
            self.sales = {}
            self.next_id = 1
    
    def save_sales(self):
        """Guarda las ventas en el archivo"""
        try:
            # Crear directorio si no existe
            os.makedirs(os.path.dirname(self.data_file), exist_ok=True)
            
            # Convertir IDs a string para JSON
            sales_for_json = {}
            for key, value in self.sales.items():
                sales_for_json[str(key)] = value
            
            data = {
                'sales': sales_for_json,
                'next_id': self.next_id
            }
            
            with open(self.data_file, 'w', encoding='utf-8') as f:
                json.dump(data, f, indent=2, ensure_ascii=False)
                
        except Exception as e:
            print(f"Error guardando ventas: {e}")
    
    def record_sale(self, sale_data):
        """Registra una nueva venta"""
        try:
            sale_id = self.next_id
            
            # Validar datos de la venta
            if not sale_data.get('items') or not isinstance(sale_data['items'], list):
                raise ValueError("La venta debe tener al menos un producto")
            
            if not isinstance(sale_data.get('total'), (int, float)) or sale_data['total'] <= 0:
                raise ValueError("El total de la venta debe ser un número positivo")
            
            # Crear registro de venta
            sale_record = {
                'id': sale_id,
                'timestamp': datetime.now().isoformat(),
                'items': sale_data['items'],
                'subtotal': float(sale_data.get('subtotal', sale_data['total'])),
                'discount_percentage': float(sale_data.get('discount_percentage', 0)),
                'total': float(sale_data['total']),
                'payment_info': sale_data.get('payment_info', {}),
                'exchange_rate': float(sale_data.get('exchange_rate', 36.0)),
                'status': 'completed'
            }
            
            # Calcular estadísticas adicionales
            sale_record['total_items'] = sum(item['quantity'] for item in sale_data['items'])
            sale_record['unique_products'] = len(sale_data['items'])
            
            # Agregar información de descuento si aplica
            if sale_record['discount_percentage'] > 0:
                discount_amount = sale_record['subtotal'] * (sale_record['discount_percentage'] / 100)
                sale_record['discount_amount'] = discount_amount
            
            # Guardar la venta
            self.sales[sale_id] = sale_record
            self.next_id += 1
            
            # Guardar en archivo
            self.save_sales()
            
            return sale_id
            
        except Exception as e:
            print(f"Error registrando venta: {e}")
            return None
    
    def get_sale(self, sale_id):
        """Obtiene una venta por su ID"""
        return self.sales.get(sale_id)
    
    def get_all_sales(self):
        """Obtiene todas las ventas como lista"""
        return list(self.sales.values())
    
    def get_sales_by_date_range(self, start_date, end_date):
        """Obtiene ventas en un rango de fechas"""
        try:
            if isinstance(start_date, str):
                start_date = datetime.fromisoformat(start_date)
            if isinstance(end_date, str):
                end_date = datetime.fromisoformat(end_date)
            
            filtered_sales = []
            
            for sale in self.sales.values():
                sale_date = datetime.fromisoformat(sale['timestamp'])
                if start_date <= sale_date <= end_date:
                    filtered_sales.append(sale)
            
            return filtered_sales
            
        except Exception as e:
            print(f"Error filtrando ventas por fecha: {e}")
            return []
    
    def get_today_sales(self):
        """Obtiene las ventas del día actual"""
        today = datetime.now().replace(hour=0, minute=0, second=0, microsecond=0)
        tomorrow = today.replace(hour=23, minute=59, second=59, microsecond=999999)
        
        return self.get_sales_by_date_range(today, tomorrow)
    
    def get_week_sales(self):
        """Obtiene las ventas de la semana actual"""
        from datetime import timedelta
        
        today = datetime.now()
        start_of_week = today - timedelta(days=today.weekday())
        start_of_week = start_of_week.replace(hour=0, minute=0, second=0, microsecond=0)
        end_of_week = start_of_week + timedelta(days=6, hours=23, minutes=59, seconds=59)
        
        return self.get_sales_by_date_range(start_of_week, end_of_week)
    
    def get_month_sales(self):
        """Obtiene las ventas del mes actual"""
        today = datetime.now()
        start_of_month = today.replace(day=1, hour=0, minute=0, second=0, microsecond=0)
        
        # Último día del mes
        if today.month == 12:
            end_of_month = today.replace(year=today.year + 1, month=1, day=1) - timedelta(days=1)
        else:
            end_of_month = today.replace(month=today.month + 1, day=1) - timedelta(days=1)
        
        end_of_month = end_of_month.replace(hour=23, minute=59, second=59, microsecond=999999)
        
        return self.get_sales_by_date_range(start_of_month, end_of_month)
    
    def get_sales_summary(self, sales_list=None):
        """Obtiene un resumen de ventas"""
        if sales_list is None:
            sales_list = list(self.sales.values())
        
        if not sales_list:
            return {
                'total_sales': 0,
                'total_revenue_usd': 0.0,
                'total_revenue_ves': 0.0,
                'total_items_sold': 0,
                'average_sale_value': 0.0,
                'payment_methods': {},
                'top_products': []
            }
        
        # Calcular estadísticas básicas
        total_sales = len(sales_list)
        total_revenue_usd = sum(sale['total'] for sale in sales_list)
        total_items_sold = sum(sale.get('total_items', 0) for sale in sales_list)
        average_sale_value = total_revenue_usd / total_sales if total_sales > 0 else 0
        
        # Calcular revenue en VES (usando la tasa promedio)
        total_revenue_ves = 0
        for sale in sales_list:
            exchange_rate = sale.get('exchange_rate', 36.0)
            total_revenue_ves += sale['total'] * exchange_rate
        
        # Métodos de pago
        payment_methods = {}
        for sale in sales_list:
            method = sale.get('payment_info', {}).get('method', 'USD')
            payment_methods[method] = payment_methods.get(method, 0) + 1
        
        # Productos más vendidos
        product_sales = {}
        for sale in sales_list:
            for item in sale.get('items', []):
                product_name = item['name']
                quantity = item['quantity']
                
                if product_name in product_sales:
                    product_sales[product_name]['quantity'] += quantity
                    product_sales[product_name]['revenue'] += item['total_price']
                else:
                    product_sales[product_name] = {
                        'quantity': quantity,
                        'revenue': item['total_price']
                    }
        
        # Top 5 productos más vendidos
        top_products = sorted(
            product_sales.items(),
            key=lambda x: x[1]['quantity'],
            reverse=True
        )[:5]
        
        return {
            'total_sales': total_sales,
            'total_revenue_usd': total_revenue_usd,
            'total_revenue_ves': total_revenue_ves,
            'total_items_sold': total_items_sold,
            'average_sale_value': average_sale_value,
            'payment_methods': payment_methods,
            'top_products': top_products
        }
    
    def get_daily_summary(self):
        """Obtiene resumen de ventas diarias"""
        return self.get_sales_summary(self.get_today_sales())
    
    def get_weekly_summary(self):
        """Obtiene resumen de ventas semanales"""
        return self.get_sales_summary(self.get_week_sales())
    
    def get_monthly_summary(self):
        """Obtiene resumen de ventas mensuales"""
        return self.get_sales_summary(self.get_month_sales())
    
    def cancel_sale(self, sale_id, reason=""):
        """Cancela una venta (marca como cancelada)"""
        try:
            if sale_id not in self.sales:
                raise ValueError(f"Venta con ID {sale_id} no encontrada")
            
            sale = self.sales[sale_id]
            
            if sale.get('status') == 'cancelled':
                raise ValueError("La venta ya está cancelada")
            
            # Marcar como cancelada
            sale['status'] = 'cancelled'
            sale['cancelled_at'] = datetime.now().isoformat()
            sale['cancellation_reason'] = reason
            
            # Guardar cambios
            self.save_sales()
            
            return True
            
        except Exception as e:
            print(f"Error cancelando venta: {e}")
            return False
    
    def search_sales(self, search_term):
        """Busca ventas por ID o productos"""
        search_term = str(search_term).lower().strip()
        results = []
        
        for sale in self.sales.values():
            # Buscar por ID
            if search_term in str(sale['id']):
                results.append(sale)
                continue
            
            # Buscar por productos
            for item in sale.get('items', []):
                if search_term in item['name'].lower():
                    results.append(sale)
                    break
        
        return results
    
    def export_sales(self, filename=None, start_date=None, end_date=None):
        """Exporta las ventas a un archivo CSV"""
        try:
            if not filename:
                timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
                filename = f"data/sales_export_{timestamp}.csv"
            
            # Filtrar ventas si se especifican fechas
            if start_date and end_date:
                sales_to_export = self.get_sales_by_date_range(start_date, end_date)
            else:
                sales_to_export = list(self.sales.values())
            
            import csv
            
            # Crear directorio si no existe
            os.makedirs(os.path.dirname(filename), exist_ok=True)
            
            with open(filename, 'w', newline='', encoding='utf-8') as csvfile:
                fieldnames = [
                    'ID', 'Fecha', 'Hora', 'Subtotal USD', 'Descuento %', 
                    'Total USD', 'Total VES', 'Método Pago', 'Items', 'Estado'
                ]
                writer = csv.DictWriter(csvfile, fieldnames=fieldnames)
                
                writer.writeheader()
                for sale in sales_to_export:
                    sale_date = datetime.fromisoformat(sale['timestamp'])
                    total_ves = sale['total'] * sale.get('exchange_rate', 36.0)
                    
                    writer.writerow({
                        'ID': sale['id'],
                        'Fecha': sale_date.strftime('%d/%m/%Y'),
                        'Hora': sale_date.strftime('%H:%M:%S'),
                        'Subtotal USD': f"${sale['subtotal']:.2f}",
                        'Descuento %': f"{sale.get('discount_percentage', 0):.1f}%",
                        'Total USD': f"${sale['total']:.2f}",
                        'Total VES': f"Bs. {total_ves:,.2f}",
                        'Método Pago': sale.get('payment_info', {}).get('method', 'USD'),
                        'Items': sale.get('total_items', 0),
                        'Estado': sale.get('status', 'completed')
                    })
            
            return filename
            
        except Exception as e:
            print(f"Error exportando ventas: {e}")
            return None
    
