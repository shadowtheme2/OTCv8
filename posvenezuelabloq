    def get_best_selling_products(self, limit=10, period_days=30):
        """Obtiene los productos más vendidos en un período"""
        try:
            from datetime import timedelta
            
            # Calcular fecha de inicio
            end_date = datetime.now()
            start_date = end_date - timedelta(days=period_days)
            
            # Obtener ventas del período
            period_sales = self.get_sales_by_date_range(start_date, end_date)
            
            # Contar productos vendidos
            product_stats = {}
            
            for sale in period_sales:
                for item in sale.get('items', []):
                    product_name = item['name']
                    quantity = item['quantity']
                    revenue = item['total_price']
                    
                    if product_name in product_stats:
                        product_stats[product_name]['quantity_sold'] += quantity
                        product_stats[product_name]['total_revenue'] += revenue
                        product_stats[product_name]['times_sold'] += 1
                    else:
                        product_stats[product_name] = {
                            'product_name': product_name,
                            'quantity_sold': quantity,
                            'total_revenue': revenue,
                            'times_sold': 1,
                            'average_price': item['unit_price']
                        }
            
            # Ordenar por cantidad vendida
            best_sellers = sorted(
                product_stats.values(),
                key=lambda x: x['quantity_sold'],
                reverse=True
            )[:limit]
            
            return best_sellers
            
        except Exception as e:
            print(f"Error obteniendo productos más vendidos: {e}")
            return []
    
