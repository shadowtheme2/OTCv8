    def _update_preview(self, event=None):
        """Actualiza la vista previa del descuento"""
        try:
            discount = float(self.discount_entry.get() or 0)
            if 0 <= discount <= 100:
                new_total = self.current_total * (1 - discount / 100)
                self.preview_label.config(text=f"Nuevo Total: ${new_total:.2f}")
            else:
                self.preview_label.config(text="Descuento inválido (0-100%)")
        except ValueError:
            self.preview_label.config(text="Nuevo Total: $0.00")
    
    def _apply_discount(self):
        """Aplica el descuento"""
        try:
            discount = float(self.discount_entry.get() or 0)
            if 0 <= discount <= 100:
                self.discount_percentage = discount
                self.result = True
                self.window.destroy()
            else:
                messagebox.showerror("Error", "El descuento debe estar entre 0 y 100%")
        except ValueError:
            messagebox.showerror("Error", "Por favor ingrese un porcentaje válido")

class PaymentDialog(BaseDialog):
    def __init__(self, parent, total_usd, exchange_manager):
