    def _filter_sales(self, period):
        """Filtra las ventas por período"""
        from datetime import datetime, timedelta
        
        all_sales = self.sales_manager.get_all_sales()
        filtered_sales = []
        
        now = datetime.now()
        
        if period == "today":
            start_date = now.replace(hour=0, minute=0, second=0, microsecond=0)
        elif period == "week":
            start_date = now - timedelta(days=7)
        elif period == "month":
            start_date = now - timedelta(days=30)
        else:  # all
            start_date = None
        
        for sale in all_sales:
            sale_date = datetime.fromisoformat(sale['timestamp'])
            if start_date is None or sale_date >= start_date:
                filtered_sales.append(sale)
        
        self._display_sales(filtered_sales)
    
    def _display_sales(self, sales):
        """Muestra las ventas en la lista"""
        # Limpiar lista actual
        for widget in self.sales_list_frame.winfo_children():
            widget.destroy()
        
        if not sales:
            CustomLabel(self.sales_list_frame, "No hay ventas para mostrar", 
                       label_type="normal").pack(pady=20)
            self.summary_label.config(text="Total: $0.00 | Ventas: 0")
            return
        
        # Mostrar ventas
        total_amount = 0
        for sale in reversed(sales):  # Más recientes primero
            sale_frame = CustomFrame(self.sales_list_frame, frame_type="card")
            sale_frame.pack(fill="x", pady=2, padx=5)
            
            # Información de la venta
            info_frame = CustomFrame(sale_frame)
            info_frame.pack(side="left", fill="x", expand=True, padx=10, pady=5)
            
            from datetime import datetime
            sale_time = datetime.fromisoformat(sale['timestamp'])
            
            CustomLabel(info_frame, f"#{sale['id']}", label_type="normal").pack(side="left", padx=(0, 20))
            CustomLabel(info_frame, sale_time.strftime('%d/%m/%Y %H:%M'), 
                       label_type="normal").pack(side="left", padx=(0, 20))
            CustomLabel(info_frame, f"${sale['total']:.2f}", 
                       label_type="normal").pack(side="left", padx=(0, 20))
            
            method = sale.get('payment_info', {}).get('method', 'USD')
            CustomLabel(info_frame, method, label_type="normal").pack(side="left")
            
            # Botón ver detalles
            CustomButton(sale_frame, "👁️ Ver", 
                        command=lambda s=sale: self._view_sale_details(s), 
                        button_type="primary").pack(side="right", padx=10, pady=5)
            
            total_amount += sale['total']
        
        # Actualizar resumen
        self.summary_label.config(text=f"Total: ${total_amount:.2f} | Ventas: {len(sales)}")
    
    def _view_sale_details(self, sale):
        """Muestra los detalles de una venta"""
        # Obtener la tasa de cambio de la venta o usar la actual
        exchange_rate = sale.get('exchange_rate', 36.0)  # Valor por defecto
        
        receipt_dialog = ReceiptDialog(self.window, sale, exchange_rate)
        self.window.wait_window(receipt_dialog.window)

