    def get_revenue_by_period(self, period='daily', num_periods=7):
        """Obtiene ingresos agrupados por período"""
        try:
            from datetime import timedelta
            import calendar
            
            revenue_data = []
            current_date = datetime.now()
            
            for i in range(num_periods):
                if period == 'daily':
                    period_start = current_date - timedelta(days=i)
                    period_end = period_start.replace(hour=23, minute=59, second=59)
                    period_start = period_start.replace(hour=0, minute=0, second=0)
                    period_label = period_start.strftime('%d/%m')
                    
                elif period == 'weekly':
                    days_since_monday = current_date.weekday()
                    week_start = current_date - timedelta(days=days_since_monday + (i * 7))
                    period_start = week_start.replace(hour=0, minute=0, second=0)
                    period_end = period_start + timedelta(days=6, hours=23, minutes=59, seconds=59)
                    period_label = f"Sem {period_start.strftime('%d/%m')}"
                    
                elif period == 'monthly':
                    if i == 0:
                        period_start = current_date.replace(day=1, hour=0, minute=0, second=0)
                    else:
                        year = current_date.year
                        month = current_date.month - i
                        if month <= 0:
                            month += 12
                            year -= 1
                        period_start = datetime(year, month, 1)
                    
                    # Último día del mes
                    last_day = calendar.monthrange(period_start.year, period_start.month)[1]
                    period_end = period_start.replace(day=last_day, hour=23, minute=59, second=59)
                    period_label = period_start.strftime('%m/%Y')
                
                # Obtener ventas del período
                period_sales = self.get_sales_by_date_range(period_start, period_end)
                period_revenue = sum(sale['total'] for sale in period_sales)
                
                revenue_data.append({
                    'period': period_label,
                    'start_date': period_start,
                    'end_date': period_end,
                    'revenue_usd': period_revenue,
                    'sales_count': len(period_sales)
                })
            
            return list(reversed(revenue_data))  # Orden cronológico
            
        except Exception as e:
            print(f"Error obteniendo ingresos por período: {e}")
            return []
    
    def get_hourly_sales_pattern(self, days_back=7):
        """Obtiene el patrón de ventas por horas del día"""
        try:
            from datetime import timedelta
            
            # Obtener ventas de los últimos días
            end_date = datetime.now()
            start_date = end_date - timedelta(days=days_back)
            recent_sales = self.get_sales_by_date_range(start_date, end_date)
            
            # Agrupar por hora
            hourly_data = {hour: {'sales_count': 0, 'revenue': 0.0} for hour in range(24)}
            
            for sale in recent_sales:
                sale_time = datetime.fromisoformat(sale['timestamp'])
                hour = sale_time.hour
                
                hourly_data[hour]['sales_count'] += 1
                hourly_data[hour]['revenue'] += sale['total']
            
            return hourly_data
            
        except Exception as e:
            print(f"Error obteniendo patrón horario: {e}")
            return {}
    
    def get_customer_analytics(self):
        """Obtiene análisis básico de clientes (basado en patrones de compra)"""
        try:
            all_sales = list(self.sales.values())
            
            if not all_sales:
                return {
                    'total_transactions': 0,
                    'average_transaction_value': 0,
                    'transaction_ranges': {}
                }
            
            # Rangos de transacciones
            ranges = {
                'small': {'min': 0, 'max': 10, 'count': 0},      # $0-10
                'medium': {'min': 10, 'max': 50, 'count': 0},    # $10-50
                'large': {'min': 50, 'max': 100, 'count': 0},    # $50-100
                'xlarge': {'min': 100, 'max': float('inf'), 'count': 0}  # $100+
            }
            
            total_transactions = len(all_sales)
            total_value = sum(sale['total'] for sale in all_sales)
            average_value = total_value / total_transactions
            
            # Clasificar transacciones por rango
            for sale in all_sales:
                total = sale['total']
                
                if total < 10:
                    ranges['small']['count'] += 1
                elif total < 50:
                    ranges['medium']['count'] += 1
                elif total < 100:
                    ranges['large']['count'] += 1
                else:
                    ranges['xlarge']['count'] += 1
            
            return {
                'total_transactions': total_transactions,
                'average_transaction_value': average_value,
                'total_revenue': total_value,
                'transaction_ranges': ranges
            }
            
        except Exception as e:
            print(f"Error en análisis de clientes: {e}")
            return {}
    
    def get_detailed_sale_report(self, sale_id):
        """Obtiene un reporte detallado de una venta específica"""
        try:
            sale = self.get_sale(sale_id)
            if not sale:
                return None
            
            # Información básica
            sale_time = datetime.fromisoformat(sale['timestamp'])
            
            report = {
                'basic_info': {
                    'id': sale['id'],
                    'date': sale_time.strftime('%d/%m/%Y'),
                    'time': sale_time.strftime('%H:%M:%S'),
                    'status': sale.get('status', 'completed')
                },
                'financial_info': {
                    'subtotal': sale['subtotal'],
                    'discount_percentage': sale.get('discount_percentage', 0),
                    'discount_amount': sale.get('discount_amount', 0),
                    'total_usd': sale['total'],
                    'exchange_rate': sale.get('exchange_rate', 36.0),
                    'total_ves': sale['total'] * sale.get('exchange_rate', 36.0)
                },
                'payment_info': sale.get('payment_info', {}),
                'items_detail': sale.get('items', []),
                'summary': {
                    'total_items': sale.get('total_items', 0),
                    'unique_products': sale.get('unique_products', 0)
                }
            }
            
            # Información de cancelación si aplica
            if sale.get('status') == 'cancelled':
                report['cancellation_info'] = {
                    'cancelled_at': sale.get('cancelled_at'),
                    'reason': sale.get('cancellation_reason', '')
                }
            
            return report
            
        except Exception as e:
            print(f"Error generando reporte detallado: {e}")
            return None
    
    def cleanup_old_sales(self, days_to_keep=365):
        """Limpia ventas antiguas (opcional, para mantenimiento)"""
        try:
            from datetime import timedelta
            
            cutoff_date = datetime.now() - timedelta(days=days_to_keep)
            sales_to_remove = []
            
            for sale_id, sale in self.sales.items():
                sale_date = datetime.fromisoformat(sale['timestamp'])
                if sale_date < cutoff_date:
                    sales_to_remove.append(sale_id)
            
            # Crear backup antes de limpiar
            if sales_to_remove:
                backup_file = self.backup_sales()
                
                # Remover ventas antiguas
                for sale_id in sales_to_remove:
                    del self.sales[sale_id]
                
                # Guardar cambios
                self.save_sales()
                
                return {
                    'removed_count': len(sales_to_remove),
                    'backup_file': backup_file
                }
            
            return {'removed_count': 0, 'backup_file': None}
            
        except Exception as e:
            print(f"Error limpiando ventas antiguas: {e}")
            return None
    
    def validate_sale_data(self, sale_data):
        """Valida los datos de una venta antes de registrarla"""
        errors = []
        
        # Validar items
        if not sale_data.get('items') or not isinstance(sale_data['items'], list):
            errors.append("La venta debe tener al menos un producto")
        else:
            for i, item in enumerate(sale_data['items']):
                if not item.get('name'):
                    errors.append(f"Item {i+1}: Nombre requerido")
                if not isinstance(item.get('quantity'), int) or item['quantity'] <= 0:
                    errors.append(f"Item {i+1}: Cantidad debe ser un entero positivo")
                if not isinstance(item.get('unit_price'), (int, float)) or item['unit_price'] <= 0:
                    errors.append(f"Item {i+1}: Precio unitario debe ser positivo")
        
        # Validar totales
        if not isinstance(sale_data.get('total'), (int, float)) or sale_data['total'] <= 0:
            errors.append("El total debe ser un número positivo")
        
        # Validar información de pago
        payment_info = sale_data.get('payment_info', {})
        if payment_info:
            method = payment_info.get('method')
            if method not in ['USD', 'VES', 'MIXTO']:
                errors.append("Método de pago inválido")
        
        return errors

class InventoryManager:
    def __init__(self, data_file="data/inventory.json"):
        self.data_file = data_file
        self.products = {}
        self.next_id = 1
        self.load_inventory()
    
    def load_inventory(self):
        """Carga el inventario desde el archivo"""
        try:
            if os.path.exists(self.data_file):
                with open(self.data_file, 'r', encoding='utf-8') as f:
                    data = json.load(f)
                    self.products = data.get('products', {})
                    self.next_id = data.get('next_id', 1)
                    
                    # Convertir IDs de string a int si es necesario
                    if self.products:
                        converted_products = {}
                        for key, value in self.products.items():
                            converted_products[int(key)] = value
                        self.products = converted_products
            else:
                # Crear algunos productos de ejemplo si no existe el archivo
                self._create_sample_products()
                
        except Exception as e:
            print(f"Error cargando inventario: {e}")
            self.products = {}
            self.next_id = 1
            self._create_sample_products()
    
    def save_inventory(self):
        """Guarda el inventario en el archivo"""
        try:
            # Crear directorio si no existe
            os.makedirs(os.path.dirname(self.data_file), exist_ok=True)
            
            # Convertir IDs a string para JSON
            products_for_json = {}
            for key, value in self.products.items():
                products_for_json[str(key)] = value
            
            data = {
                'products': products_for_json,
                'next_id': self.next_id
            }
            
            with open(self.data_file, 'w', encoding='utf-8') as f:
                json.dump(data, f, indent=2, ensure_ascii=False)
                
        except Exception as e:
            print(f"Error guardando inventario: {e}")
    
    def _create_sample_products(self):
        """Crea productos de ejemplo"""
        sample_products = [
            {
                'name': 'Coca Cola 600ml',
                'price_usd': 1.50,
                'stock': 25,
                'profit_percentage': 0
            },
            {
                'name': 'Pan de Sandwich',
                'price_usd': 2.00,
                'stock': 15,
                'profit_percentage': 0
            },
            {
                'name': 'Leche Completa 1L',
                'price_usd': 3.50,
                'stock': 20,
                'profit_percentage': 0
            },
            {
                'name': 'Arroz 1kg',
                'price_usd': 1.25,
                'stock': 30,
                'profit_percentage': 0
            },
            {
                'name': 'Aceite de Cocina 1L',
                'price_usd': 4.00,
                'stock': 12,
