    def schedule_exchange_update(self):
        """Programa la actualización automática de la tasa de cambio"""
        self.exchange_manager.update_exchange_rate()
        self.update_exchange_display()
        
        # Programar próxima actualización en 5 minutos (300000 ms)
        self.root.after(300000, self.schedule_exchange_update)
    
