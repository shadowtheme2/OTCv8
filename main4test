    def record_sale(self, sale_data):
        """Registra una venta"""
        try:
            conn = sqlite3.connect(self.db_file)
            cursor = conn.cursor()
            
            # Insertar venta principal
            cursor.execute('''
                INSERT INTO sales (id, timestamp, total_usd, total_ves, payment_method, 
                                 usd_received, ves_received, usd_change, ves_change, 
                                 exchange_rate, items, discount_percentage)
                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
            ''', (
                sale_data['id'], sale_data['timestamp'], sale_data['total_usd'],
                sale_data['total_ves'], sale_data['payment_method'],
                sale_data.get('usd_received', 0), sale_data.get('ves_received', 0),
                sale_data.get('usd_change', 0), sale_data.get('ves_change', 0),
                sale_data['exchange_rate'], json.dumps(sale_data['items']),
                sale_data.get('discount_percentage', 0)
            ))
            
            # Insertar items de venta
            for item in sale_data['items']:
                cursor.execute('''
                    INSERT INTO sale_items (sale_id, product_id, product_name, quantity,
                                          price_usd, price_ves, cost_price_usd, cost_price_ves,
                                          discount_percentage, subtotal_usd, subtotal_ves)
                    VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
                ''', (
                    sale_data['id'], item['id'], item['name'], item['quantity'],
                    item['price_usd'], item['price_ves'], item.get('cost_price_usd', 0),
                    item.get('cost_price_ves', 0), item.get('discount_percentage', 0),
                    item['subtotal_usd'], item['subtotal_ves']
                ))
                
                # Actualizar stock
                cursor.execute('''
                    UPDATE products SET stock = stock - ? WHERE id = ?
                ''', (item['quantity'], item['id']))
            
            conn.commit()
            conn.close()
            self.create_backup()
            return True
        except Exception as e:
            print(f"Error registrando venta: {e}")
            return False

    def get_daily_sales(self, date=None):
        """Obtiene ventas del día"""
        if date is None:
            date = datetime.now().strftime('%Y-%m-%d')
        
        conn = sqlite3.connect(self.db_file)
        cursor = conn.cursor()
        cursor.execute('''
            SELECT * FROM sales 
            WHERE date(timestamp) = ? AND closed = 0
            ORDER BY timestamp DESC
        ''', (date,))
        sales = cursor.fetchall()
        conn.close()
        return sales

    def get_all_sales(self):
        """Obtiene todas las ventas"""
        conn = sqlite3.connect(self.db_file)
        cursor = conn.cursor()
        cursor.execute('SELECT * FROM sales ORDER BY timestamp DESC')
        sales = cursor.fetchall()
        conn.close()
        return sales

    def get_sale_items(self, sale_id):
        """Obtiene los items de una venta específica"""
        conn = sqlite3.connect(self.db_file)
        cursor = conn.cursor()
        cursor.execute('SELECT * FROM sale_items WHERE sale_id = ?', (sale_id,))
        items = cursor.fetchall()
        conn.close()
        return items

    def close_daily_sales(self, date=None):
        """Cierra las ventas del día"""
        if date is None:
            date = datetime.now().strftime('%Y-%m-%d')
        
        try:
            conn = sqlite3.connect(self.db_file)
            cursor = conn.cursor()
            cursor.execute('''
                UPDATE sales SET closed = 1 
                WHERE date(timestamp) = ? AND closed = 0
            ''', (date,))
            conn.commit()
            conn.close()
            return True
        except Exception as e:
            print(f"Error cerrando ventas del día: {e}")
            return False

    def get_config(self, key, default_value=""):
        """Obtiene configuración"""
        conn = sqlite3.connect(self.db_file)
        cursor = conn.cursor()
        cursor.execute('SELECT value FROM config WHERE key = ?', (key,))
        result = cursor.fetchone()
        conn.close()
        return result[0] if result else default_value

    def set_config(self, key, value):
        """Establece configuración"""
        conn = sqlite3.connect(self.db_file)
        cursor = conn.cursor()
        cursor.execute('''
            INSERT OR REPLACE INTO config (key, value) VALUES (?, ?)
        ''', (key, value))
        conn.commit()
        conn.close()

    def get_shortcuts(self):
        """Obtiene atajos de teclado"""
        conn = sqlite3.connect(self.db_file)
        cursor = conn.cursor()
        cursor.execute('SELECT * FROM shortcuts')
        shortcuts = dict(cursor.fetchall())
        conn.close()
        return shortcuts

    def update_shortcut(self, action, shortcut):
        """Actualiza un atajo de teclado"""
        conn = sqlite3.connect(self.db_file)
        cursor = conn.cursor()
        cursor.execute('''
            INSERT OR REPLACE INTO shortcuts (action, shortcut) VALUES (?, ?)
        ''', (action, shortcut))
        conn.commit()
        conn.close()

class ExchangeRateManager:
    def __init__(self):
        self.current_rate = EXCHANGE_CONFIG["default_rate"]
        self.last_update = None
        self.update_timer = QTimer()
        self.update_timer.timeout.connect(self.update_rate)
        self.update_timer.start(EXCHANGE_CONFIG["update_interval"])
        self.update_rate()

    def update_rate(self):
        """Actualiza la tasa de cambio desde APIs"""
        def fetch_rate():
            try:
                # Intentar API principal
                response = requests.get(
                    EXCHANGE_CONFIG["primary_api"],
                    timeout=EXCHANGE_CONFIG["request_timeout"]
                )
                if response.status_code == 200:
                    data = response.json()
                    if 'rates' in data and 'VES' in data['rates']:
                        self.current_rate = data['rates']['VES']
                        self.last_update = datetime.now()
                        return
                
                # Intentar API de respaldo
                response = requests.get(
                    EXCHANGE_CONFIG["backup_api"],
                    timeout=EXCHANGE_CONFIG["request_timeout"]
                )
                if response.status_code == 200:
                    data = response.json()
                    if 'bpi' in data and 'VES' in data['bpi']:
                        self.current_rate = data['bpi']['VES']['rate_float']
                        self.last_update = datetime.now()
                        return
                        
            except Exception as e:
                print(f"Error actualizando tasa de cambio: {e}")
            
            # Si fallan ambas APIs, usar tasa por defecto
            if self.current_rate == 0:
                self.current_rate = EXCHANGE_CONFIG["default_rate"]

        # Ejecutar en hilo separado para no bloquear la UI
        thread = threading.Thread(target=fetch_rate)
        thread.daemon = True
        thread.start()

    def get_rate(self):
        """Obtiene la tasa actual"""
        return self.current_rate

    def usd_to_ves(self, usd_amount):
        """Convierte USD a VES"""
        return usd_amount * self.current_rate

    def ves_to_usd(self, ves_amount):
        """Convierte VES a USD"""
        return ves_amount / self.current_rate

