    def add_product_to_cart(self):
        """Agrega producto al carrito desde doble click en tabla"""
        current_row = self.products_table.currentRow()
        if current_row >= 0:
            product_id = int(self.products_table.item(current_row, 0).text())
            product = self.db_manager.get_product_by_id(product_id)
            if product:
                self.add_product_to_cart_by_data(product)

    def add_product_to_cart_by_data(self, product):
        """Agrega producto al carrito usando datos del producto"""
        if product[4] <= 0:  # Sin stock
            QMessageBox.warning(self, "Sin Stock", "Este producto no tiene stock disponible")
            return
        
        # Verificar si el producto ya está en el carrito
        for i, item in enumerate(self.cart_items):
            if item['id'] == product[0]:
                # Incrementar cantidad
                new_qty = item['quantity'] + 1
                if new_qty <= product[4]:  # Verificar stock disponible
                    item['quantity'] = new_qty
                    self.update_cart_display()
                    self.update_cart_totals()
                else:
                    QMessageBox.warning(self, "Stock Insuficiente", 
                                      f"Solo hay {product[4]:.2f} unidades disponibles")
                return
        
        # Agregar nuevo producto al carrito
        cart_item = {
            'id': product[0],
            'name': product[1],
            'price_ves': product[2],
            'price_usd': product[3],
            'quantity': 1,
            'max_stock': product[4],
            'cost_price_ves': product[6] if len(product) > 6 else 0,
            'cost_price_usd': product[7] if len(product) > 7 else 0
        }
        
        self.cart_items.append(cart_item)
        self.update_cart_display()
        self.update_cart_totals()

    def update_cart_display(self):
        """Actualiza la visualización del carrito"""
        self.cart_table.setRowCount(len(self.cart_items))
        
        for row, item in enumerate(self.cart_items):
            # Producto
            self.cart_table.setItem(row, 0, QTableWidgetItem(item['name']))
            
            # Cantidad (editable)
            qty_item = QTableWidgetItem(str(item['quantity']))
            self.cart_table.setItem(row, 1, qty_item)
            
            # Precio USD
            self.cart_table.setItem(row, 2, QTableWidgetItem(f"${item['price_usd']:.2f}"))
            
            # Precio BS
            self.cart_table.setItem(row, 3, QTableWidgetItem(f"{item['price_ves']:.2f} Bs"))
            
            # Subtotal USD
            subtotal = item['quantity'] * item['price_usd']
            self.cart_table.setItem(row, 4, QTableWidgetItem(f"${subtotal:.2f}"))

    def update_cart_totals(self):
        """Actualiza los totales del carrito"""
        # Actualizar cantidades desde la tabla
        for row in range(self.cart_table.rowCount()):
            try:
                new_qty = float(self.cart_table.item(row, 1).text())
                if new_qty > 0 and new_qty <= self.cart_items[row]['max_stock']:
                    self.cart_items[row]['quantity'] = new_qty
                elif new_qty > self.cart_items[row]['max_stock']:
                    # Restaurar cantidad máxima
                    self.cart_items[row]['quantity'] = self.cart_items[row]['max_stock']
                    self.cart_table.item(row, 1).setText(str(self.cart_items[row]['max_stock']))
                    QMessageBox.warning(self, "Stock Insuficiente", 
                                      f"Solo hay {self.cart_items[row]['max_stock']:.2f} unidades disponibles")
            except (ValueError, AttributeError):
                # Restaurar cantidad anterior si hay error
                self.cart_table.item(row, 1).setText(str(self.cart_items[row]['quantity']))
        
        # Calcular totales
        subtotal_usd = sum(item['quantity'] * item['price_usd'] for item in self.cart_items)
        subtotal_ves = sum(item['quantity'] * item['price_ves'] for item in self.cart_items)
        
        # Aplicar descuento
        discount_percent = self.discount_input.value()
        discount_usd = subtotal_usd * (discount_percent / 100)
        discount_ves = subtotal_ves * (discount_percent / 100)
        
        total_usd = subtotal_usd - discount_usd
        total_ves = subtotal_ves - discount_ves
        
        # Actualizar etiquetas
        self.subtotal_label.setText(f"Subtotal: ${subtotal_usd:.2f} / {subtotal_ves:.2f} Bs")
        self.discount_label.setText(f"Descuento ({discount_percent:.1f}%): ${discount_usd:.2f} / {discount_ves:.2f} Bs")
        self.total_label.setText(f"TOTAL: ${total_usd:.2f} / {total_ves:.2f} Bs")
        
        # Actualizar subtotales en la tabla
        self.update_cart_display()

    def apply_discount_dialog(self):
        """Muestra diálogo para aplicar descuento"""
        dialog = DiscountDialog(self, self.discount_input.value())
        if dialog.exec_() == QDialog.Accepted:
            discount = dialog.get_discount()
            self.discount_input.setValue(discount)
            self.update_cart_totals()

    def remove_selected_item(self):
        """Quita el item seleccionado del carrito"""
        current_row = self.cart_table.currentRow()
        if current_row >= 0:
            reply = QMessageBox.question(
                self, 
                "Confirmar", 
                "¿Desea quitar este producto del carrito?",
                QMessageBox.Yes | QMessageBox.No
            )
            
            if reply == QMessageBox.Yes:
                del self.cart_items[current_row]
                self.update_cart_display()
                self.update_cart_totals()

    def clear_cart(self):
        """Limpia el carrito"""
        if self.cart_items:
            reply = QMessageBox.question(
                self, 
                "Confirmar", 
                "¿Desea limpiar todo el carrito?",
                QMessageBox.Yes | QMessageBox.No
            )
            
            if reply == QMessageBox.Yes:
                self.cart_items.clear()
                self.discount_input.setValue(0)
                self.update_cart_display()
                self.update_cart_totals()

    def process_sale(self):
        """Procesa la venta"""
        if not self.cart_items:
            QMessageBox.warning(self, "Carrito Vacío", "Agregue productos al carrito antes de procesar la venta")
            return
        
        # Verificar stock disponible
        for item in self.cart_items:
            current_product = self.db_manager.get_product_by_id(item['id'])
            if not current_product or current_product[4] < item['quantity']:
                QMessageBox.warning(
                    self, 
                    "Stock Insuficiente", 
                    f"No hay suficiente stock para {item['name']}\n"
                    f"Stock disponible: {current_product[4] if current_product else 0}\n"
                    f"Cantidad solicitada: {item['quantity']}"
                )
                return
        
        # Calcular totales
        subtotal_usd = sum(item['quantity'] * item['price_usd'] for item in self.cart_items)
        subtotal_ves = sum(item['quantity'] * item['price_ves'] for item in self.cart_items)
        
        discount_percent = self.discount_input.value()
        discount_usd = subtotal_usd * (discount_percent / 100)
        discount_ves = subtotal_ves * (discount_percent / 100)
        
        total_usd = subtotal_usd - discount_usd
        total_ves = subtotal_ves - discount_ves
        
        # Mostrar diálogo de pago
        payment_dialog = PaymentDialog(
            self, 
            total_usd, 
            total_ves, 
            self.exchange_manager.get_rate()
        )
        
        if payment_dialog.exec_() == QDialog.Accepted:
            payment_data = payment_dialog.get_payment_data()
            
            try:
                # Crear venta en la base de datos
                sale_id = self.db_manager.create_sale(
                    total_usd=total_usd,
                    total_ves=total_ves,
                    discount_percent=discount_percent,
                    payment_method=payment_data['method'],
                    ves_received=payment_data['ves_received'],
                    usd_received=payment_data['usd_received'],
                    ves_change=payment_data['ves_change'],
                    usd_change=payment_data['usd_change'],
                    exchange_rate=self.exchange_manager.get_rate()
                )
                
                # Agregar items de la venta
                for item in self.cart_items:
                    self.db_manager.add_sale_item(
                        sale_id=sale_id,
                        product_id=item['id'],
                        quantity=item['quantity'],
                        price_usd=item['price_usd'],
                        price_ves=item['price_ves'],
                        cost_price_usd=item['cost_price_usd'],
                        cost_price_ves=item['cost_price_ves']
                    )
                    
                    # Actualizar stock
                    self.db_manager.update_product_stock(
                        item['id'], 
                        -item['quantity']  # Restar del stock
                    )
                
                # Mostrar ticket
                self.show_sale_ticket(sale_id, payment_data)
                
                # Limpiar carrito
                self.cart_items.clear()
                self.discount_input.setValue(0)
                self.update_cart_display()
                self.update_cart_totals()
                
                # Recargar productos para actualizar stock
                self.load_products()
                
                # Actualizar barra de estado
                self.status_label.setText(f"Venta procesada exitosamente - Ticket: {sale_id}")
                
            except Exception as e:
                QMessageBox.critical(self, "Error", f"Error procesando la venta: {e}")

    def show_sale_ticket(self, sale_id, payment_data):
        """Muestra el ticket de la venta"""
        # Obtener datos de la venta
        sale = self.db_manager.get_sale_by_id(sale_id)
        if not sale:
            return
        
        # Crear diálogo del ticket
        dialog = QDialog(self)
        dialog.setWindowTitle(f"Ticket de Venta - {sale_id}")
        dialog.setFixedSize(400, 600)
        dialog.setStyleSheet(self.style_manager.get_dialog_style())
        
        layout = QVBoxLayout()
        
        # Contenido del ticket
        ticket_text = QTextEdit()
        ticket_text.setStyleSheet("""
            QTextEdit {
                background-color: white;
                border: 2px solid #e2e8f0;
                border-radius: 6px;
                padding: 10px;
                font-family: 'Courier New', monospace;
                font-size: 12px;
            }
        """)
        ticket_text.setReadOnly(True)
        
        # Generar contenido del ticket
        ticket_content = self.generate_current_ticket_content(sale, payment_data)
        ticket_text.setPlainText(ticket_content)
        
        layout.addWidget(ticket_text)
        
        # Botones
        button_layout = QHBoxLayout()
        
        print_btn = QPushButton("Imprimir")
        print_btn.setStyleSheet(self.style_manager.get_button_style("primary"))
        print_btn.clicked.connect(lambda: self.print_current_ticket(ticket_content))
        
        close_btn = QPushButton("Cerrar")
        close_btn.setStyleSheet(self.style_manager.get_button_style())
        close_btn.clicked.connect(dialog.close)
        
        button_layout.addWidget(print_btn)
        button_layout.addWidget(close_btn)
        layout.addLayout(button_layout)
        
        dialog.setLayout(layout)
        dialog.exec_()

    def generate_current_ticket_content(self, sale, payment_data):
        """Genera el contenido del ticket actual"""
        content = []
        content.append("=" * 40)
        content.append("           TICKET DE VENTA")
        content.append("=" * 40)
        content.append("")
        
        # Información de la venta
        timestamp = datetime.fromisoformat(sale[1])
        content.append(f"Fecha: {timestamp.strftime('%d/%m/%Y')}")
        content.append(f"Hora: {timestamp.strftime('%H:%M:%S')}")
        content.append(f"Ticket: {sale[0]}")
        content.append("")
        content.append("-" * 40)
        content.append("PRODUCTOS")
        content.append("-" * 40)
        
        # Items del carrito actual
        for item in self.cart_items:
            name = item['name'][:25]  # Limitar nombre a 25 caracteres
            qty = item['quantity']
            price_usd = item['price_usd']
            price_ves = item['price_ves']
            subtotal_usd = qty * price_usd
            subtotal_ves = qty * price_ves
            
            content.append(f"{name}")
            content.append(f"  {qty} x ${price_usd:.2f} = ${subtotal_usd:.2f}")
            content.append(f"  {qty} x {price_ves:.2f}Bs = {subtotal_ves:.2f}Bs")
            content.append("")
        
        content.append("-" * 40)
        content.append(f"SUBTOTAL: ${sale[2] + (sale[2] * sale[4] / 100):.2f} / {sale[3] + (sale[3] * sale[4] / 100):.2f} Bs")
        
        if sale[4] > 0:  # Si hay descuento
            content.append(f"DESCUENTO ({sale[4]:.1f}%): ${(sale[2] + (sale[2] * sale[4] / 100)) - sale[2]:.2f} / {(sale[3] + (sale[3] * sale[4] / 100)) - sale[3]:.2f} Bs")
        
        content.append(f"TOTAL: ${sale[2]:.2f} / {sale[3]:.2f} Bs")
        content.append("")
        content.append("-" * 40)
        content.append("PAGO")
        content.append("-" * 40)
        content.append(f"Método: {payment_data['method']}")
        
        if payment_data['ves_received'] > 0:
            content.append(f"Recibido BS: {payment_data['ves_received']:.2f} Bs")
        if payment_data['usd_received'] > 0:
            content.append(f"Recibido USD: ${payment_data['usd_received']:.2f}")
        if payment_data['ves_change'] > 0:
            content.append(f"Cambio BS: {payment_data['ves_change']:.2f} Bs")
        if payment_data['usd_change'] > 0:
            content.append(f"Cambio USD: ${payment_data['usd_change']:.2f}")
        
        content.append("")
        content.append(f"Tasa de cambio: {sale[9]:.2f} Bs/$")
        content.append("")
        content.append("=" * 40)
        content.append("        ¡GRACIAS POR SU COMPRA!")
        content.append("=" * 40)
        
        return "\n".join(content)

    def print_current_ticket(self, content):
        """Imprime el ticket actual"""
        try:
            # Crear archivo temporal
            temp_file = f"ticket_{datetime.now().strftime('%Y%m%d_%H%M%S')}.txt"
            with open(temp_file, 'w', encoding='utf-8') as f:
                f.write(content)
            
            QMessageBox.information(self, "Ticket Guardado", 
                                  f"Ticket guardado como: {temp_file}")
        except Exception as e:
            QMessageBox.warning(self, "Error", f"Error guardando ticket: {e}")

    def add_new_product(self):
        """Agrega un nuevo producto"""
        dialog = ProductDialog(self, self.db_manager, self.exchange_manager.get_rate())
        if dialog.exec_() == QDialog.Accepted:
            self.load_products()
            self.status_label.setText("Producto agregado exitosamente")

    def edit_product(self, product):
        """Edita un producto existente"""
        dialog = ProductDialog(self, self.db_manager, self.exchange_manager.get_rate(), product)
        if dialog.exec_() == QDialog.Accepted:
            self.load_products()
            self.status_label.setText("Producto actualizado exitosamente")

    def add_stock_to_product(self):
        """Agrega stock a un producto seleccionado"""
        current_row = self.products_table.currentRow()
        if current_row < 0:
            QMessageBox.information(self, "Seleccionar Producto", "Seleccione un producto de la tabla")
            return
        
        product_id = int(self.products_table.item(current_row, 0).text())
        product = self.db_manager.get_product_by_id(product_id)
        
        if not product:
            QMessageBox.warning(self, "Error", "Producto no encontrado")
            return
        
        # Solicitar cantidad a agregar
        quantity, ok = QInputDialog.getDouble(
            self, 
            "Agregar Stock", 
            f"Producto: {product[1]}\nStock actual: {product[4]:.2f}\n\nCantidad a agregar:", 
            0.0, 
            0.01, 
            999999.99, 
            2
        )
        
        if ok and quantity > 0:
            try:
                self.db_manager.update_product_stock(product_id, quantity)
                self.load_products()
                self.status_label.setText(f"Stock agregado: +{quantity:.2f} a {product[1]}")
            except Exception as e:
                QMessageBox.warning(self, "Error", f"Error agregando stock: {e}")

    def configure_exchange_rate(self):
        """Configura la tasa de cambio"""
        current_rate = self.exchange_manager.get_rate()
        
        rate, ok = QInputDialog.getDouble(
            self, 
            "Configurar Tasa de Cambio", 
            f"Tasa actual: {current_rate:.2f} Bs/$\n\nNueva tasa:", 
            current_rate, 
            0.01, 
            999999.99, 
            2
        )
        
        if ok and rate != current_rate:
            self.exchange_manager.set_rate(rate)
            self.update_exchange_rate_display()
            self.status_label.setText(f"Tasa de cambio actualizada: {rate:.2f} Bs/$")

