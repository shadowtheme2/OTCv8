    def load_product_data(self):
        """Carga los datos del producto para edición"""
        if not self.product:
            return
            
        self.name_input.setText(self.product[1])  # name
        self.price_ves_input.setValue(self.product[2])  # price_ves
        self.price_usd_input.setValue(self.product[3])  # price_usd
        
        # Cargar costos si existen
        if len(self.product) > 6:
            self.cost_ves_input.setValue(self.product[6])  # cost_ves
        if len(self.product) > 7:
            self.cost_usd_input.setValue(self.product[7])  # cost_usd
        
        # Calcular ganancia inicial
        self.calculate_profit()

    def calculate_price_ves(self):
        """Calcula el precio en BS basado en USD"""
        price_usd = self.price_usd_input.value()
        price_ves = price_usd * self.exchange_rate
        self.price_ves_input.setValue(price_ves)

    def calculate_cost_ves(self):
        """Calcula el costo en BS basado en USD"""
        cost_usd = self.cost_usd_input.value()
        cost_ves = cost_usd * self.exchange_rate
        self.cost_ves_input.setValue(cost_ves)

    def calculate_profit(self):
        """Calcula y muestra la ganancia"""
        price_usd = self.price_usd_input.value()
        cost_usd = self.cost_usd_input.value()
        
        if cost_usd > 0:
            profit_usd = price_usd - cost_usd
            profit_percent = (profit_usd / cost_usd) * 100
            self.profit_label.setText(f"Ganancia: ${profit_usd:.2f} ({profit_percent:.1f}%)")
        else:
            self.profit_label.setText("Ganancia: $0.00 (0.0%)")

    def save_product(self):
        """Guarda el producto"""
        # Validar datos
        name = self.name_input.text().strip()
        if not name:
            QMessageBox.warning(self, "Error", "El nombre del producto es obligatorio")
            return
        
        price_usd = self.price_usd_input.value()
        if price_usd <= 0:
            QMessageBox.warning(self, "Error", "El precio debe ser mayor a 0")
            return
        
        try:
            if self.product:  # Editar producto existente
                self.db_manager.update_product(
                    product_id=self.product[0],
                    name=name,
                    price_ves=self.price_ves_input.value(),
                    price_usd=price_usd,
                    cost_ves=self.cost_ves_input.value(),
                    cost_usd=self.cost_usd_input.value()
                )
            else:  # Crear nuevo producto
                stock = self.stock_input.value() if hasattr(self, 'stock_input') else 0
                self.db_manager.add_product(
                    name=name,
                    price_ves=self.price_ves_input.value(),
                    price_usd=price_ves,
                    stock=stock,
                    cost_ves=self.cost_ves_input.value(),
                    cost_usd=self.cost_usd_input.value()
                )
            
            self.accept()
            
        except Exception as e:
            QMessageBox.critical(self, "Error", f"Error guardando producto: {e}")


    def get_product_data(self):
        """Retorna los datos del producto"""
        return {
            'name': self.name_input.text().strip(),
            'cost_price_ves': self.cost_ves_input.value(),
            'profit_percentage': self.profit_input.value(),
            'stock': self.stock_input.value(),
            'final_price_ves': self.final_price_ves_input.value(),
            'exchange_rate': self.exchange_rate
        }

