    def calculate_bs_change(self):
        """Calcula el cambio en BS"""
        received = self.bs_received_input.value()
        change = max(0, received - self.total_ves)
        self.bs_change_label.setText(f"{change:.2f} Bs")

    def calculate_usd_change(self):
        """Calcula el cambio en USD"""
        received = self.usd_received_input.value()
        total_change = max(0, received - self.total_usd)
        self.usd_change_input.setValue(total_change)
        self.calculate_usd_change_bs()

    def calculate_usd_change_bs(self):
        """Calcula el cambio restante en BS cuando se da cambio en USD"""
        received = self.usd_received_input.value()
        total_change = max(0, received - self.total_usd)
        usd_change_given = self.usd_change_input.value()
        
        if usd_change_given <= total_change:
            remaining_change_usd = total_change - usd_change_given
            remaining_change_bs = remaining_change_usd * self.exchange_rate
            self.usd_change_bs_label.setText(f"{remaining_change_bs:.2f} Bs")
        else:
            self.usd_change_bs_label.setText("0.00 Bs")

    def calculate_mixed_change(self):
        """Calcula el cambio para pago mixto"""
        bs_received = self.mixed_bs_input.value()
        usd_received = self.mixed_usd_input.value()
        
        total_received_usd = (bs_received / self.exchange_rate) + usd_received
        total_change = max(0, total_received_usd - self.total_usd)
        
        self.mixed_change_usd_input.setValue(total_change)
        self.calculate_mixed_change_bs()

    def calculate_mixed_change_bs(self):
        """Calcula el cambio restante en BS para pago mixto"""
        bs_received = self.mixed_bs_input.value()
        usd_received = self.mixed_usd_input.value()
        
        total_received_usd = (bs_received / self.exchange_rate) + usd_received
        total_change = max(0, total_received_usd - self.total_usd)
        usd_change_given = self.mixed_change_usd_input.value()
        
        if usd_change_given <= total_change:
            remaining_change_usd = total_change - usd_change_given
            remaining_change_bs = remaining_change_usd * self.exchange_rate
            self.mixed_change_bs_label.setText(f"{remaining_change_bs:.2f} Bs")
        else:
            self.mixed_change_bs_label.setText("0.00 Bs")

    def process_payment(self):
        """Procesa el pago"""
        method_id = self.payment_method.checkedId()
        
        if method_id == 0:  # BS
            if self.bs_received_input.value() < self.total_ves:
                QMessageBox.warning(self, "Error", "El monto recibido es insuficiente")
                return
        elif method_id == 1:  # USD
            if self.usd_received_input.value() < self.total_usd:
                QMessageBox.warning(self, "Error", "El monto recibido es insuficiente")
                return
        elif method_id == 2:  # Mixto
            bs_received = self.mixed_bs_input.value()
            usd_received = self.mixed_usd_input.value()
            total_received_usd = (bs_received / self.exchange_rate) + usd_received
            
            if total_received_usd < self.total_usd:
                QMessageBox.warning(self, "Error", "El monto total recibido es insuficiente")
                return
        
        self.accept()

    def get_payment_data(self):
        """Retorna los datos del pago"""
        method_id = self.payment_method.checkedId()
        
        if method_id == 0:  # BS
            return {
                'method': 'BS',
                'ves_received': self.bs_received_input.value(),
                'usd_received': 0,
                'ves_change': max(0, self.bs_received_input.value() - self.total_ves),
                'usd_change': 0
            }
        elif method_id == 1:  # USD
            return {
                'method': 'USD',
                'ves_received': 0,
                'usd_received': self.usd_received_input.value(),
                'ves_change': float(self.usd_change_bs_label.text().replace(' Bs', '')),
                'usd_change': self.usd_change_input.value()
            }
        elif method_id == 2:  # Mixto
            return {
                'method': 'Mixto',
                'ves_received': self.mixed_bs_input.value(),
                'usd_received': self.mixed_usd_input.value(),
                'ves_change': float(self.mixed_change_bs_label.text().replace(' Bs', '')),
                'usd_change': self.mixed_change_usd_input.value()
            }

