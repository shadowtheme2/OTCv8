        close_btn.clicked.connect(self.close)
        layout.addWidget(close_btn)
        
        self.setLayout(layout)

    def load_sales(self):
        """Carga el historial de ventas"""
        if not self.db_manager:
            return
        
        sales = self.db_manager.get_all_sales()
        self.sales_table.setRowCount(len(sales))
        
        for row, sale in enumerate(sales):
            # ID
            self.sales_table.setItem(row, 0, QTableWidgetItem(sale[0]))
            
            # Fecha/Hora
            timestamp = datetime.fromisoformat(sale[1]).strftime("%d/%m/%Y %H:%M")
            self.sales_table.setItem(row, 1, QTableWidgetItem(timestamp))
            
            # Total USD
            self.sales_table.setItem(row, 2, QTableWidgetItem(f"${sale[2]:.2f}"))
            
            # Total BS
            self.sales_table.setItem(row, 3, QTableWidgetItem(f"{sale[3]:.2f} Bs"))
            
            # Método
            self.sales_table.setItem(row, 4, QTableWidgetItem(sale[5]))
            
            # Estado
            status = "Cerrada" if len(sale) > 12 and sale[12] == 1 else "Abierta"
            self.sales_table.setItem(row, 5, QTableWidgetItem(status))
            
            # Botón ver ticket
            view_btn = QPushButton("Ver Ticket")
            view_btn.setStyleSheet(self.style_manager.get_button_style("primary"))
            view_btn.clicked.connect(lambda checked, sale_id=sale[0]: self.view_ticket(sale_id))
            self.sales_table.setCellWidget(row, 6, view_btn)

    def view_ticket(self, sale_id):
        """Muestra el ticket de una venta"""
        if not self.db_manager:
            return
        
        # Obtener datos de la venta
        conn = sqlite3.connect(self.db_manager.db_file)
        cursor = conn.cursor()
        cursor.execute('SELECT * FROM sales WHERE id = ?', (sale_id,))
        sale = cursor.fetchone()
        
        if not sale:
            conn.close()
            return
        
        # Obtener items de la venta
        items = self.db_manager.get_sale_items(sale_id)
        conn.close()
        
        # Crear diálogo del ticket
        dialog = QDialog(self)
        dialog.setWindowTitle(f"Ticket - {sale_id}")
        dialog.setFixedSize(400, 600)
        dialog.setStyleSheet(self.style_manager.get_dialog_style())
        
        layout = QVBoxLayout()
        
        # Contenido del ticket
        ticket_text = QTextEdit()
        ticket_text.setStyleSheet("""
            QTextEdit {
                background-color: white;
                border: 2px solid #e2e8f0;
                border-radius: 6px;
                padding: 10px;
                font-family: 'Courier New', monospace;
                font-size: 12px;
            }
        """)
        ticket_text.setReadOnly(True)
        
        # Generar contenido del ticket
        ticket_content = self.generate_ticket_content(sale, items)
        ticket_text.setPlainText(ticket_content)
        
        layout.addWidget(ticket_text)
        
        # Botones
        button_layout = QHBoxLayout()
        
        print_btn = QPushButton("Imprimir")
        print_btn.setStyleSheet(self.style_manager.get_button_style("primary"))
        print_btn.clicked.connect(lambda: self.print_ticket(ticket_content))
        
        close_btn = QPushButton("Cerrar")
        close_btn.setStyleSheet(self.style_manager.get_button_style())
        close_btn.clicked.connect(dialog.close)
        
        button_layout.addWidget(print_btn)
        button_layout.addWidget(close_btn)
        layout.addLayout(button_layout)
        
        dialog.setLayout(layout)
        dialog.exec_()

    def generate_ticket_content(self, sale, items):
        """Genera el contenido del ticket"""
        content = []
        content.append("=" * 40)
        content.append("           TICKET DE VENTA")
        content.append("=" * 40)
        content.append("")
        
        # Información de la venta
        timestamp = datetime.fromisoformat(sale[1])
        content.append(f"Fecha: {timestamp.strftime('%d/%m/%Y')}")
        content.append(f"Hora: {timestamp.strftime('%H:%M:%S')}")
        content.append(f"Ticket: {sale[0]}")
        content.append("")
        content.append("-" * 40)
        content.append("PRODUCTOS")
        content.append("-" * 40)
        
        # Items
        for item in items:
            name = item[3][:25]  # Limitar nombre a 25 caracteres
            qty = item[4]
            price_usd = item[5]
            price_ves = item[6]
            subtotal_usd = item[9]
            subtotal_ves = item[10]
            
            content.append(f"{name}")
            content.append(f"  {qty} x ${price_usd:.2f} = ${subtotal_usd:.2f}")
            content.append(f"  {qty} x {price_ves:.2f}Bs = {subtotal_ves:.2f}Bs")
            content.append("")
        
        content.append("-" * 40)
        content.append(f"TOTAL USD: ${sale[2]:.2f}")
        content.append(f"TOTAL BS:  {sale[3]:.2f} Bs")
        content.append("")
        content.append(f"Método de pago: {sale[5]}")
        content.append(f"Tasa de cambio: {sale[9]:.2f} Bs/$")
        content.append("")
        content.append("=" * 40)
        content.append("        ¡GRACIAS POR SU COMPRA!")
        content.append("=" * 40)
        
        return "\n".join(content)

    def print_ticket(self, content):
        """Imprime el ticket"""
        try:
            # Crear archivo temporal
            temp_file = f"ticket_{datetime.now().strftime('%Y%m%d_%H%M%S')}.txt"
            with open(temp_file, 'w', encoding='utf-8') as f:
                f.write(content)
            
            QMessageBox.information(self, "Ticket Guardado", 
                                  f"Ticket guardado como: {temp_file}")
        except Exception as e:
            QMessageBox.warning(self, "Error", f"Error guardando ticket: {e}")

