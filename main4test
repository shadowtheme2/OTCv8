class EditableTableWidget(QTableWidget):
    """Tabla personalizada que permite editar cantidad con doble click"""
    
    def __init__(self, parent=None):
        super().__init__(parent)
        self.itemDoubleClicked.connect(self.on_item_double_clicked)
        
    def on_item_double_clicked(self, item):
        """Maneja el doble click en items de la tabla"""
        if item.column() == 1:  # Columna de cantidad
            self.edit_quantity(item.row())
    
    def edit_quantity(self, row):
        """Permite editar la cantidad de un producto"""
        current_qty = float(self.item(row, 1).text())
        
        qty, ok = QInputDialog.getDouble(
            self, 
            "Editar Cantidad", 
            "Nueva cantidad:", 
            current_qty, 
            0.01, 
            999999.99, 
            2
        )
        
        if ok and qty != current_qty:
            self.item(row, 1).setText(str(qty))
            # Emitir señal personalizada para actualizar totales
            if hasattr(self.parent(), 'update_cart_totals'):
                self.parent().update_cart_totals()

