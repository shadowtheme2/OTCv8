    def load_daily_summary(self):
        """Carga el resumen del día"""
        if not self.db_manager:
            return
        
        sales = self.db_manager.get_daily_sales()
        
        total_sales = len(sales)
        total_usd = sum(sale[2] for sale in sales)
        total_ves = sum(sale[3] for sale in sales)
        
        # Calcular ganancias
        total_cost = 0
        total_profit = 0
        
        for sale in sales:
            items = self.db_manager.get_sale_items(sale[0])
            for item in items:
                cost = item[7] * item[4]  # cost_price_usd * quantity
                total_cost += cost
        
        total_profit = total_usd - total_cost
        profit_margin = (total_profit / total_usd * 100) if total_usd > 0 else 0
        
        # Generar resumen
        summary = []
        summary.append("=" * 50)
        summary.append("           RESUMEN DEL DÍA")
        summary.append("=" * 50)
        summary.append("")
        summary.append(f"Fecha: {datetime.now().strftime('%d/%m/%Y')}")
        summary.append(f"Hora de cierre: {datetime.now().strftime('%H:%M:%S')}")
        summary.append("")
        summary.append("-" * 50)
        summary.append("VENTAS")
        summary.append("-" * 50)
        summary.append(f"Total de ventas: {total_sales}")
        summary.append(f"Total en USD: ${total_usd:.2f}")
        summary.append(f"Total en BS: {total_ves:.2f} Bs")
        summary.append("")
        summary.append("-" * 50)
        summary.append("COSTOS Y GANANCIAS")
        summary.append("-" * 50)
        summary.append(f"Costo total: ${total_cost:.2f}")
        summary.append(f"Ganancia bruta: ${total_profit:.2f}")
        summary.append(f"Margen de ganancia: {profit_margin:.2f}%")
        summary.append("")
        summary.append("=" * 50)
        
        self.summary_text.setPlainText("\n".join(summary))

    def generate_report(self):
        """Genera el reporte PDF y cierra las ventas del día"""
        try:
            # Confirmar acción
            reply = QMessageBox.question(
                self, 
                "Confirmar Cierre", 
                "¿Está seguro de cerrar la caja del día?\n\nEsta acción generará un reporte PDF y marcará todas las ventas del día como cerradas.",
                QMessageBox.Yes | QMessageBox.No
            )
            
            if reply != QMessageBox.Yes:
                return
            
            # Generar PDF
            filename = f"cierre_caja_{datetime.now().strftime('%Y%m%d')}.pdf"
            
            doc = SimpleDocTemplate(filename, pagesize=A4)
            elements = []
            styles = getSampleStyleSheet()
            
            # Título
            title_style = ParagraphStyle(
                'CustomTitle',
                parent=styles['Heading1'],
                fontSize=20,
                spaceAfter=30,
                alignment=TA_CENTER
            )
            
            title = Paragraph("CIERRE DE CAJA DIARIO", title_style)
            elements.append(title)
            
            # Fecha y hora
            date_p = Paragraph(f"Fecha: {datetime.now().strftime('%d/%m/%Y %H:%M:%S')}", styles['Normal'])
            elements.append(date_p)
            elements.append(Spacer(1, 20))
            
            # Obtener datos
            sales = self.db_manager.get_daily_sales()
            
            # Resumen general
            total_sales = len(sales)
            total_usd = sum(sale[2] for sale in sales)
            total_ves = sum(sale[3] for sale in sales)
            
            summary_data = [
                ['Concepto', 'Valor'],
                ['Total de ventas', str(total_sales)],
                ['Total USD', f'${total_usd:.2f}'],
                ['Total BS', f'{total_ves:.2f} Bs'],
                ['Tasa de cambio', f'{self.exchange_rate:.2f} Bs/$']
            ]
            
            summary_table = Table(summary_data)
            summary_table.setStyle(TableStyle([
                ('BACKGROUND', (0, 0), (-1, 0), colors.grey),
                ('TEXTCOLOR', (0, 0), (-1, 0), colors.whitesmoke),
                ('ALIGN', (0, 0), (-1, -1), 'CENTER'),
                ('FONTNAME', (0, 0), (-1, 0), 'Helvetica-Bold'),
                ('FONTSIZE', (0, 0), (-1, 0), 12),
                ('BOTTOMPADDING', (0, 0), (-1, 0), 12),
                ('BACKGROUND', (0, 1), (-1, -1), colors.beige),
                ('GRID', (0, 0), (-1, -1), 1, colors.black)
            ]))
            
            elements.append(summary_table)
            elements.append(Spacer(1, 30))
            
            # Detalle de ganancias por producto
            elements.append(Paragraph("DETALLE DE GANANCIAS POR PRODUCTO", styles['Heading2']))
            elements.append(Spacer(1, 10))
            
            profit_data = [['Producto', 'Cantidad', 'Costo Unit.', 'Precio Unit.', 'Ganancia Unit.', 'Ganancia Total']]
            
            total_cost = 0
            total_profit = 0
            
            # Agrupar productos vendidos
            product_sales = {}
            
            for sale in sales:
                items = self.db_manager.get_sale_items(sale[0])
                for item in items:
                    product_name = item[3]
                    if product_name not in product_sales:
                        product_sales[product_name] = {
                            'quantity': 0,
                            'cost_usd': item[7],
                            'price_usd': item[5],
                            'total_cost': 0,
                            'total_revenue': 0
                        }
                    
                    product_sales[product_name]['quantity'] += item[4]
                    product_sales[product_name]['total_cost'] += item[7] * item[4]
                    product_sales[product_name]['total_revenue'] += item[9]
            
            for product_name, data in product_sales.items():
                cost_unit = data['cost_usd']
                price_unit = data['price_usd']
                profit_unit = price_unit - cost_unit
                profit_total = data['total_revenue'] - data['total_cost']
                
                total_cost += data['total_cost']
                total_profit += profit_total
                
                profit_data.append([
                    product_name[:20],
                    f"{data['quantity']:.2f}",
                    f"${cost_unit:.2f}",
                    f"${price_unit:.2f}",
                    f"${profit_unit:.2f}",
                    f"${profit_total:.2f}"
                ])
            
            profit_table = Table(profit_data)
            profit_table.setStyle(TableStyle([
                ('BACKGROUND', (0, 0), (-1, 0), colors.grey),
