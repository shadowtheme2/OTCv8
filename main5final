        # Método de pago
        payment_group = QGroupBox("💰 Método de Pago")
        payment_layout = QVBoxLayout(payment_group)
        
        self.payment_method_combo = QComboBox()
        self.payment_method_combo.addItems([
            "Efectivo USD", "Efectivo VES", "Efectivo Mixto",
