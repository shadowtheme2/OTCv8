class ReceiptDialog(QDialog):
    """Diálogo para mostrar y imprimir recibo"""
    
    def __init__(self, sale_id, sale_number, sale_data, sale_items, parent=None):
        super().__init__(parent)
        self.sale_id = sale_id
        self.sale_number = sale_number
        self.sale_data = sale_data
        self.sale_items = sale_items
        
        self.setup_ui()
        self.generate_receipt()
    
    def setup_ui(self):
        """Configura la interfaz del diálogo"""
        self.setWindowTitle(f"🧾 Recibo - {self.sale_number}")
        self.setModal(True)
        self.setMinimumSize(400, 600)
        
        layout = QVBoxLayout(self)
        
        # Área de texto del recibo
        self.receipt_text = QTextEdit()
        self.receipt_text.setReadOnly(True)
        self.receipt_text.setFont(QFont("Courier", 10))
        layout.addWidget(self.receipt_text)
        
        # Botones
        buttons_layout = QHBoxLayout()
        
        print_btn = ModernButton("🖨️ Imprimir", "primary")
        print_btn.clicked.connect(self.print_receipt)
        buttons_layout.addWidget(print_btn)
        
        save_btn = ModernButton("💾 Guardar", "warning")
        save_btn.clicked.connect(self.save_receipt)
        buttons_layout.addWidget(save_btn)
        
