        try:
            self.ensure_connection()
            
            cursor = self.connection.cursor()
            
            # Inicializar resultado por defecto
            result = {
                'daily_sales': [],
                'totals': {
                    'total_sales': 0,
                    'total_usd': 0.0,
                    'total_ves': 0.0,
                    'avg_sale_usd': 0.0,
                    'avg_sale_ves': 0.0
                },
                'top_products': []
            }
            
            # Query base para ventas diarias
            query = """
                SELECT 
                    DATE(s.created_at) as date,
                    COUNT(s.id) as total_sales,
                    COALESCE(SUM(s.total_usd), 0) as total_usd,
                    COALESCE(SUM(s.total_ves), 0) as total_ves,
                    COALESCE(AVG(s.total_usd), 0) as avg_sale_usd,
                    COALESCE(AVG(s.total_ves), 0) as avg_sale_ves
                FROM sales s
            """
            
            params = []
            
            # Agregar filtros de fecha
            if start_date or end_date:
                query += " WHERE "
                conditions = []
                
                if start_date:
                    conditions.append("DATE(s.created_at) >= ?")
                    params.append(start_date)
                
                if end_date:
                    conditions.append("DATE(s.created_at) <= ?")
                    params.append(end_date)
                
                query += " AND ".join(conditions)
            
            query += " GROUP BY DATE(s.created_at) ORDER BY DATE(s.created_at) DESC"
            
            cursor.execute(query, params)
            rows = cursor.fetchall()
            
            # Convertir a diccionarios
            columns = [description[0] for description in cursor.description]
            result['daily_sales'] = [dict(zip(columns, row)) for row in rows]
            
            # Obtener totales generales
            total_query = """
                SELECT 
                    COUNT(s.id) as total_sales,
                    COALESCE(SUM(s.total_usd), 0) as total_usd,
                    COALESCE(SUM(s.total_ves), 0) as total_ves,
                    COALESCE(AVG(s.total_usd), 0) as avg_sale_usd,
                    COALESCE(AVG(s.total_ves), 0) as avg_sale_ves
                FROM sales s
            """
            
            if params:
                total_query += " WHERE "
                if start_date:
                    total_query += "DATE(s.created_at) >= ?"
                if start_date and end_date:
                    total_query += " AND "
                if end_date:
                    total_query += "DATE(s.created_at) <= ?"
            
            cursor.execute(total_query, params)
            total_row = cursor.fetchone()
            
            if total_row:
                total_columns = [description[0] for description in cursor.description]
                result['totals'] = dict(zip(total_columns, total_row))
            
            return result
            
        except Exception as e:
            print(f"❌ Error generando reporte de ventas: {str(e)}")
            return {
                'daily_sales': [],
                'totals': {
                    'total_sales': 0,
                    'total_usd': 0.0,
                    'total_ves': 0.0,
                    'avg_sale_usd': 0.0,
                    'avg_sale_ves': 0.0
                },
                'top_products': []
            }
    
    def get_product(self, product_id):
        """Obtiene un producto por ID"""
        try:
            self.ensure_connection()
            
            cursor = self.connection.cursor()
            cursor.execute("""
                SELECT p.*, c.name as category_name 
                FROM products p 
                LEFT JOIN categories c ON p.category_id = c.id 
                WHERE p.id = ?
            """, (product_id,))
            
            result = cursor.fetchone()
            if result:
                product = dict(result)
                # Actualizar precio VES
                current_rate = self.get_current_exchange_rate()
                product['price_ves'] = float(product['price_usd']) * current_rate
                return product
            
            return None
            
        except Exception as e:
            print(f"❌ Error obteniendo producto: {str(e)}")
            return None
    
    def get_low_stock_products(self):
        """Obtiene productos con stock bajo"""
        try:
            self.ensure_connection()
            
            cursor = self.connection.cursor()
            cursor.execute("""
                SELECT p.*, c.name as category_name 
                FROM products p 
                LEFT JOIN categories c ON p.category_id = c.id 
                WHERE p.active = 1 AND p.track_stock = 1 AND p.stock <= p.min_stock
                ORDER BY p.stock ASC, p.name
            """)
            
            return [dict(row) for row in cursor.fetchall()]
            
        except Exception as e:
            print(f"❌ Error obteniendo productos con stock bajo: {str(e)}")
            return []

