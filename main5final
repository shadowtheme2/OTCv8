class CurrencyUtils:
    """Utilidades para manejo de monedas"""
    
    @staticmethod
    def format_currency(amount, currency='USD'):
        """Formatea un monto como moneda"""
        try:
            amount = float(amount)
            if currency == 'USD':
                return f"${amount:,.2f}"
            elif currency == 'VES':
                return f"Bs. {amount:,.2f}"
            else:
                return f"{amount:,.2f}"
        except (ValueError, TypeError):
            return f"${0.00}" if currency == 'USD' else f"Bs. 0.00"
    
    @staticmethod
    def parse_currency(text):
        """Convierte texto de moneda a float"""
        try:
            # Remover símbolos y espacios
            clean_text = text.replace('$', '').replace('Bs.', '').replace(',', '').strip()
            return float(clean_text)
        except (ValueError, TypeError):
            return 0.0

class DateUtils:
    """Utilidades para manejo de fechas"""
    
    @staticmethod
    def format_datetime(dt):
        """Formatea fecha y hora"""
        if isinstance(dt, str):
            try:
                dt = datetime.fromisoformat(dt.replace('Z', '+00:00'))
            except:
                return dt
        return dt.strftime("%d/%m/%Y %H:%M")
    
    @staticmethod
    def format_date(dt):
        """Formatea solo la fecha"""
        if isinstance(dt, str):
            try:
                dt = datetime.fromisoformat(dt.replace('Z', '+00:00'))
            except:
                return dt
        return dt.strftime("%d/%m/%Y")

