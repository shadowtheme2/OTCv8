                no_products_item.setTextAlignment(Qt.AlignCenter)
                self.products_table.setItem(0, 0, no_products_item)
                self.products_table.setSpan(0, 0, 1, 6)
                return
            
            for row, product in enumerate(products):
                # Producto
                self.products_table.setItem(row, 0, QTableWidgetItem(product['name']))
                
                # Categoría
                category_name = product['category_name'] or 'Sin categoría'
                self.products_table.setItem(row, 1, QTableWidgetItem(category_name))
                
                # Stock actual
                stock_item = QTableWidgetItem(str(product['stock']))
                if product['stock'] == 0:
                    stock_item.setBackground(QColor('#ffcdd2'))  # Rojo claro
                else:
                    stock_item.setBackground(QColor('#fff3e0'))  # Naranja claro
                self.products_table.setItem(row, 2, stock_item)
                
                # Stock mínimo
                self.products_table.setItem(row, 3, QTableWidgetItem(str(product['min_stock'])))
                
                # Diferencia
                difference = product['stock'] - product['min_stock']
                diff_item = QTableWidgetItem(str(difference))
                if difference < 0:
                    diff_item.setBackground(QColor('#ffcdd2'))
                self.products_table.setItem(row, 4, diff_item)
                
                # Estado
                if product['stock'] == 0:
                    status = "Sin Stock"
                    status_color = QColor('#ffcdd2')
                elif product['stock'] <= product['min_stock']:
                    status = "Stock Bajo"
                    status_color = QColor('#fff3e0')
                else:
                    status = "Normal"
                    status_color = QColor('#e8f5e8')
                
                status_item = QTableWidgetItem(status)
                status_item.setBackground(status_color)
                self.products_table.setItem(row, 5, status_item)
            
            # Ajustar columnas
            self.products_table.resizeColumnsToContents()
            
        except Exception as e:
            QMessageBox.critical(self, "Error", f"Error cargando productos: {str(e)}")

