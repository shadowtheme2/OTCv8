        close_btn = ModernButton("❌ Cerrar", "danger")
        close_btn.clicked.connect(self.close)
        buttons_layout.addWidget(close_btn)
        
        layout.addLayout(buttons_layout)
    
    def load_sales(self):
        """Carga las ventas en la tabla"""
        try:
            start_date = self.start_date.date().toString("yyyy-MM-dd")
            end_date = self.end_date.date().toString("yyyy-MM-dd")
            
            sales = self.db_manager.get_sales_history(start_date, end_date)
            
            self.sales_table.setRowCount(len(sales))
            
            for row, sale in enumerate(sales):
                # ID
                self.sales_table.setItem(row, 0, QTableWidgetItem(str(sale['id'])))
                
                # Número
                self.sales_table.setItem(row, 1, QTableWidgetItem(sale['sale_number']))
                
                # Fecha
                try:
                    dt = datetime.fromisoformat(sale['created_at'].replace('Z', '+00:00'))
                    formatted_date = dt.strftime('%d/%m/%Y %H:%M')
                except:
                    formatted_date = sale['created_at']
                self.sales_table.setItem(row, 2, QTableWidgetItem(formatted_date))
                
                # Cliente
                customer = sale['customer_name'] or 'Cliente General'
                self.sales_table.setItem(row, 3, QTableWidgetItem(customer))
                
                # Total USD
                total_usd = CurrencyUtils.format_currency(sale['total_usd'], 'USD')
                self.sales_table.setItem(row, 4, QTableWidgetItem(total_usd))
                
                # Total VES
                total_ves = CurrencyUtils.format_currency(sale['total_ves'], 'VES')
                self.sales_table.setItem(row, 5, QTableWidgetItem(total_ves))
                
                # Método de pago
                self.sales_table.setItem(row, 6, QTableWidgetItem(sale['payment_method']))
                
                # Items
                items_count = self.db_manager.get_sale_items_count(sale['id'])
                self.sales_table.setItem(row, 7, QTableWidgetItem(str(items_count)))
                
                # Botones de acciones
                actions_widget = QWidget()
                actions_layout = QHBoxLayout(actions_widget)
                actions_layout.setContentsMargins(5, 2, 5, 2)
                
                view_btn = ModernButton("👁️", "info")
                view_btn.setMaximumSize(30, 25)
                view_btn.setToolTip("Ver detalles")
                view_btn.clicked.connect(lambda checked, sale_id=sale['id']: self.view_sale_details(sale_id))
                actions_layout.addWidget(view_btn)
                
                receipt_btn = ModernButton("🧾", "primary")
                receipt_btn.setMaximumSize(30, 25)
                receipt_btn.setToolTip("Ver recibo")
                receipt_btn.clicked.connect(lambda checked, sale_id=sale['id']: self.show_receipt(sale_id))
                actions_layout.addWidget(receipt_btn)
                
                self.sales_table.setCellWidget(row, 8, actions_widget)
            
            # Ajustar columnas
            self.sales_table.resizeColumnsToContents()
            
        except Exception as e:
            QMessageBox.critical(self, "Error", f"Error cargando ventas: {str(e)}")
    
    def view_sale_details(self, sale_id):
        """Muestra los detalles de una venta"""
        try:
            sale = self.db_manager.get_sale(sale_id)
            if sale:
                dialog = SaleDetailsDialog(sale, self.db_manager, self)
                dialog.exec_()
        except Exception as e:
            QMessageBox.critical(self, "Error", f"Error mostrando detalles: {str(e)}")
    
    def show_receipt(self, sale_id):
        """Muestra el recibo de una venta"""
        try:
            sale = self.db_manager.get_sale(sale_id)
            if sale:
                dialog = ReceiptDialog(sale, self.db_manager, self)
                dialog.exec_()
        except Exception as e:
            QMessageBox.critical(self, "Error", f"Error mostrando recibo: {str(e)}")
    
    def export_sales(self):
        """Exporta las ventas a CSV"""
        try:
            start_date = self.start_date.date().toString("yyyy-MM-dd")
            end_date = self.end_date.date().toString("yyyy-MM-dd")
            
            filename, _ = QFileDialog.getSaveFileName(
                self, "Exportar Ventas",
                f"ventas_{start_date}_a_{end_date}.csv",
                "Archivos CSV (*.csv)"
            )
            
            if filename:
                sales = self.db_manager.get_sales_history(start_date, end_date)
                
                import csv
                with open(filename, 'w', newline='', encoding='utf-8') as csvfile:
                    writer = csv.writer(csvfile)
                    
                    # Encabezado
                    writer.writerow([
                        "ID", "Número", "Fecha", "Cliente", "Total USD", "Total VES",
                        "Método Pago", "Subtotal USD", "Subtotal VES", "Impuestos USD", "Impuestos VES"
                    ])
                    
                    # Datos
                    for sale in sales:
                        try:
                            dt = datetime.fromisoformat(sale['created_at'].replace('Z', '+00:00'))
                            formatted_date = dt.strftime('%d/%m/%Y %H:%M')
                        except:
                            formatted_date = sale['created_at']
                        
                        writer.writerow([
                            sale['id'],
                            sale['sale_number'],
                            formatted_date,
                            sale['customer_name'] or 'Cliente General',
                            f"${sale['total_usd']:.2f}",
                            f"Bs. {sale['total_ves']:.2f}",
                            sale['payment_method'],
                            f"${sale['subtotal_usd']:.2f}",
                            f"Bs. {sale['subtotal_ves']:.2f}",
                            f"${sale['tax_usd']:.2f}",
                            f"Bs. {sale['tax_ves']:.2f}"
                        ])
                
                QMessageBox.information(self, "Exportación Exitosa", f"Ventas exportadas a:\n{filename}")
        
        except Exception as e:
            QMessageBox.critical(self, "Error", f"Error exportando ventas: {str(e)}")

