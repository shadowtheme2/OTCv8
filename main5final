    def backup_database(self):
        """Crea un respaldo de la base de datos"""
        try:
            filename, _ = QFileDialog.getSaveFileName(
                self, "Guardar Respaldo",
                f"pos_backup_{QDate.currentDate().toString('yyyy-MM-dd')}.db",
                "Base de Datos (*.db)"
            )
            
            if filename:
                if self.db_manager.backup_database(filename):
                    QMessageBox.information(self, "Respaldo Exitoso", 
                                          f"Base de datos respaldada en:\n{filename}")
                else:
                    QMessageBox.critical(self, "Error", "No se pudo crear el respaldo.")
        except Exception as e:
            QMessageBox.critical(self, "Error", f"Error creando respaldo: {str(e)}")
    
    def restore_database(self):
        """Restaura la base de datos desde un respaldo"""
        try:
            filename, _ = QFileDialog.getOpenFileName(
                self, "Seleccionar Respaldo",
                "", "Base de Datos (*.db)"
            )
            
            if filename:
                reply = QMessageBox.question(
                    self, "Confirmar Restauración",
                    "¿Está seguro de que desea restaurar la base de datos?\n\n"
                    "Esta acción reemplazará todos los datos actuales y no se puede deshacer.",
                    QMessageBox.Yes | QMessageBox.No,
                    QMessageBox.No
                )
                
                if reply == QMessageBox.Yes:
                    if self.db_manager.restore_database(filename):
                        QMessageBox.information(self, "Restauración Exitosa", 
                                              "Base de datos restaurada exitosamente.\n"
                                              "La aplicación se reiniciará.")
                        
                        # Reiniciar aplicación
                        QApplication.quit()
                        QApplication.instance().quit()
                    else:
                        QMessageBox.critical(self, "Error", "No se pudo restaurar la base de datos.")
        except Exception as e:
            QMessageBox.critical(self, "Error", f"Error restaurando base de datos: {str(e)}")
    
