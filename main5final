            cursor = self.connection.cursor()
            cursor.execute("""
                INSERT INTO categories (name, description) VALUES (?, ?)
            """, (name, description))
            
            category_id = cursor.lastrowid
            self.connection.commit()
            
            return category_id
            
        except Exception as e:
            print(f"❌ Error creando categoría: {str(e)}")
            return None
    
    def get_products(self, active_only=True, category_id=None, search_term=None):
        """Obtiene los productos"""
        try:
            self.ensure_connection()
            
            cursor = self.connection.cursor()
            
            query = """
                SELECT p.*, c.name as category_name 
                FROM products p 
                LEFT JOIN categories c ON p.category_id = c.id 
                WHERE 1=1
            """
            params = []
            
            if active_only:
                query += " AND p.active = 1"
            
            if category_id:
                query += " AND p.category_id = ?"
                params.append(category_id)
            
            if search_term:
                query += " AND (p.name LIKE ? OR p.description LIKE ? OR p.sku LIKE ? OR p.barcode LIKE ?)"
                search_pattern = f"%{search_term}%"
                params.extend([search_pattern, search_pattern, search_pattern, search_pattern])
            
            query += " ORDER BY p.name"
            
            cursor.execute(query, params)
            products = [dict(row) for row in cursor.fetchall()]
            
            # Actualizar precios VES con tasa actual
            current_rate = self.get_current_exchange_rate()
            for product in products:
                product['price_ves'] = float(product['price_usd']) * current_rate
            
            return products
            
        except Exception as e:
            print(f"❌ Error obteniendo productos: {str(e)}")
            return []
    
    def get_current_exchange_rate(self):
        """Obtiene la tasa de cambio actual"""
        try:
            self.ensure_connection()
            
            cursor = self.connection.cursor()
            cursor.execute("""
                SELECT rate FROM exchange_rates 
                WHERE active = 1 
                ORDER BY created_at DESC 
                LIMIT 1
            """)
            
            result = cursor.fetchone()
            return float(result['rate']) if result else 36.50
            
        except Exception as e:
            print(f"❌ Error obteniendo tasa de cambio: {str(e)}")
            return 36.50

