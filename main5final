    def update_metrics(self, sales_data):
        """Actualiza las métricas del resumen"""
        metrics = sales_data['totals']  # Cambiar 'metrics' por 'totals'
        
        self.total_sales_label.setText(str(metrics['total_sales']))
        self.total_usd_label.setText(CurrencyUtils.format_currency(metrics['total_usd'], 'USD'))
        self.total_ves_label.setText(CurrencyUtils.format_currency(metrics['total_ves'], 'VES'))
        
        avg_sale = metrics['total_usd'] / metrics['total_sales'] if metrics['total_sales'] > 0 else 0
        self.avg_sale_label.setText(CurrencyUtils.format_currency(avg_sale, 'USD'))

        
    def generate_report(self):
        """Genera el reporte para el período seleccionado"""
        try:
            start_date = self.start_date.date().toString("yyyy-MM-dd")
            end_date = self.end_date.date().toString("yyyy-MM-dd")
            
            # Obtener datos del reporte
            sales_data = self.db_manager.get_sales_report(start_date, end_date)
            
            # Actualizar métricas
            self.update_metrics(sales_data)
            
            # Actualizar tablas
            self.update_sales_table(sales_data['daily_sales'])  # Cambiar 'sales' por 'daily_sales'
            self.update_products_table(sales_data['top_products'])
            # self.update_payments_table(sales_data['payment_methods'])  # Comentar esta línea ya que no está implementada
            
        except Exception as e:
            QMessageBox.critical(self, "Error", f"Error generando reporte: {str(e)}")

    
    def update_sales_table(self, sales):
        """Actualiza la tabla de ventas"""
        self.sales_table.setRowCount(len(sales))
        
        for row, sale in enumerate(sales):
            # Número
            self.sales_table.setItem(row, 0, QTableWidgetItem(sale['sale_number']))
            
            # Fecha
            try:
                dt = datetime.fromisoformat(sale['created_at'].replace('Z', '+00:00'))
                formatted_date = dt.strftime('%d/%m/%Y %H:%M')
            except:
                formatted_date = sale['created_at']
            self.sales_table.setItem(row, 1, QTableWidgetItem(formatted_date))
            
            # Cliente
            customer = sale['customer_name'] or 'Cliente General'
            self.sales_table.setItem(row, 2, QTableWidgetItem(customer))
            
            # Total USD
            total_usd = CurrencyUtils.format_currency(sale['total_usd'], 'USD')
            self.sales_table.setItem(row, 3, QTableWidgetItem(total_usd))
            
            # Total VES
            total_ves = CurrencyUtils.format_currency(sale['total_ves'], 'VES')
            self.sales_table.setItem(row, 4, QTableWidgetItem(total_ves))
            
            # Método de pago
            self.sales_table.setItem(row, 5, QTableWidgetItem(sale['payment_method']))
            
            # Items
            self.sales_table.setItem(row, 6, QTableWidgetItem(str(sale['total_items'])))
            
            # Estado
            status_item = QTableWidgetItem("Completada")
            status_item.setBackground(QColor('#e8f5e8'))
            self.sales_table.setItem(row, 7, status_item)
        
        # Ajustar columnas
        self.sales_table.resizeColumnsToContents()
    
    def update_products_table(self, products):
        """Actualiza la tabla de productos más vendidos"""
        self.products_table.setRowCount(len(products))
        
        for row, product in enumerate(products):
            # Producto
            self.products_table.setItem(row, 0, QTableWidgetItem(product['product_name']))
            
            # Categoría
            category = product['category_name'] or 'Sin categoría'
            self.products_table.setItem(row, 1, QTableWidgetItem(category))
            
            # Cantidad vendida
            qty_item = QTableWidgetItem(str(product['total_quantity']))
            qty_item.setTextAlignment(Qt.AlignCenter)
            self.products_table.setItem(row, 2, qty_item)
            
            # Total USD
            total_usd = CurrencyUtils.format_currency(product['total_usd'], 'USD')
            self.products_table.setItem(row, 3, QTableWidgetItem(total_usd))
            
            # Total VES
            total_ves = CurrencyUtils.format_currency(product['total_ves'], 'VES')
            self.products_table.setItem(row, 4, QTableWidgetItem(total_ves))
        
        # Ajustar columnas
        self.products_table.resizeColumnsToContents()
    
    def update_payments_table(self, payments):
        """Actualiza la tabla de métodos de pago"""
        self.payments_table.setRowCount(len(payments))
        
        for row, payment in enumerate(payments):
            # Método de pago
            self.payments_table.setItem(row, 0, QTableWidgetItem(payment['payment_method']))
            
            # Cantidad de ventas
            count_item = QTableWidgetItem(str(payment['sale_count']))
            count_item.setTextAlignment(Qt.AlignCenter)
            self.payments_table.setItem(row, 1, count_item)
            
            # Total USD
            total_usd = CurrencyUtils.format_currency(payment['total_usd'], 'USD')
            self.payments_table.setItem(row, 2, QTableWidgetItem(total_usd))
            
            # Total VES
            total_ves = CurrencyUtils.format_currency(payment['total_ves'], 'VES')
            self.payments_table.setItem(row, 3, QTableWidgetItem(total_ves))
        
        # Ajustar columnas
        self.payments_table.resizeColumnsToContents()
    
    def export_report(self):
        """Exporta el reporte a CSV"""
        try:
            start_date = self.start_date.date().toString("yyyy-MM-dd")
            end_date = self.end_date.date().toString("yyyy-MM-dd")
            
            filename, _ = QFileDialog.getSaveFileName(
                self, "Exportar Reporte",
                f"reporte_ventas_{start_date}_a_{end_date}.csv",
                "Archivos CSV (*.csv)"
            )
            
            if filename:
                # Obtener datos actuales
                sales_data = self.db_manager.get_sales_report(start_date, end_date)
                
                # Exportar a CSV
                import csv
                with open(filename, 'w', newline='', encoding='utf-8') as csvfile:
                    writer = csv.writer(csvfile)
                    
                    # Escribir encabezado del reporte
                    writer.writerow([f"Reporte de Ventas - {start_date} a {end_date}"])
                    writer.writerow([])
                    
                    # Escribir métricas
                    metrics = sales_data['metrics']
                    writer.writerow(["RESUMEN"])
                    writer.writerow(["Total de Ventas", metrics['total_sales']])
                    writer.writerow(["Total USD", f"${metrics['total_usd']:.2f}"])
                    writer.writerow(["Total VES", f"Bs. {metrics['total_ves']:.2f}"])
                    avg_sale = metrics['total_usd'] / metrics['total_sales'] if metrics['total_sales'] > 0 else 0
                    writer.writerow(["Promedio por Venta", f"${avg_sale:.2f}"])
                    writer.writerow([])
                    
                    # Escribir ventas
                    writer.writerow(["VENTAS DETALLADAS"])
                    writer.writerow(["Número", "Fecha", "Cliente", "Total USD", "Total VES", "Método Pago", "Items"])
                    
                    for sale in sales_data['sales']:
                        try:
                            dt = datetime.fromisoformat(sale['created_at'].replace('Z', '+00:00'))
                            formatted_date = dt.strftime('%d/%m/%Y %H:%M')
                        except:
                            formatted_date = sale['created_at']
                        
                        writer.writerow([
                            sale['sale_number'],
                            formatted_date,
                            sale['customer_name'] or 'Cliente General',
                            f"${sale['total_usd']:.2f}",
                            f"Bs. {sale['total_ves']:.2f}",
                            sale['payment_method'],
                            sale['total_items']
                        ])
                    
                    writer.writerow([])
                    
                    # Escribir productos más vendidos
                    writer.writerow(["PRODUCTOS MÁS VENDIDOS"])
                    writer.writerow(["Producto", "Categoría", "Cantidad", "Total USD", "Total VES"])
                    
                    for product in sales_data['top_products']:
                        writer.writerow([
                            product['product_name'],
                            product['category_name'] or 'Sin categoría',
                            product['total_quantity'],
                            f"${product['total_usd']:.2f}",
                            f"Bs. {product['total_ves']:.2f}"
                        ])
                
                QMessageBox.information(self, "Exportación Exitosa", f"Reporte exportado a:\n{filename}")
        
        except Exception as e:
            QMessageBox.critical(self, "Error", f"Error exportando reporte: {str(e)}")

