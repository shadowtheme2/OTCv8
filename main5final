        self.process_btn.clicked.connect(self.process_payment)
        self.process_btn.setMinimumHeight(50)
        buttons_layout.addWidget(self.process_btn)
        
        layout.addLayout(buttons_layout)
        
        # Configurar panel inicial
        self.on_payment_method_changed()
    
    def calculate_totals(self):
        """Calcula los totales de la venta"""
        subtotal_usd = 0
        subtotal_ves = 0
        tax_usd = 0
        tax_ves = 0
        
        for item in self.cart_items:
            item_total_usd = item['quantity'] * item['unit_price_usd']
            item_total_ves = item['quantity'] * item['unit_price_ves']
            item_tax_usd = item_total_usd * (item['tax_rate'] / 100)
            item_tax_ves = item_total_ves * (item['tax_rate'] / 100)
            
            subtotal_usd += item_total_usd
            subtotal_ves += item_total_ves
            tax_usd += item_tax_usd
            tax_ves += item_tax_ves
        
        self.subtotal_usd = subtotal_usd
        self.subtotal_ves = subtotal_ves
        self.tax_usd = tax_usd
        self.tax_ves = tax_ves
        self.total_usd = subtotal_usd + tax_usd
        self.total_ves = subtotal_ves + tax_ves
        
        # Actualizar etiquetas
        self.subtotal_usd_label.setText(CurrencyUtils.format_currency(subtotal_usd, 'USD'))
        self.subtotal_ves_label.setText(CurrencyUtils.format_currency(subtotal_ves, 'VES'))
        self.tax_usd_label.setText(CurrencyUtils.format_currency(tax_usd, 'USD'))
        self.tax_ves_label.setText(CurrencyUtils.format_currency(tax_ves, 'VES'))
        self.total_usd_label.setText(CurrencyUtils.format_currency(self.total_usd, 'USD'))
        self.total_ves_label.setText(CurrencyUtils.format_currency(self.total_ves, 'VES'))
    
    def on_payment_method_changed(self):
        """Maneja el cambio de método de pago"""
        payment_method = self.payment_method_combo.currentText()
        
        # Mostrar/ocultar panel de efectivo
        is_cash = any(method in payment_method for method in ["Efectivo", "Mixto"])
        self.cash_panel.setVisible(is_cash)
        
        if is_cash:
            # Configurar valores por defecto según el método
            if "USD" in payment_method:
                self.usd_received_edit.setValue(self.total_usd)
                self.ves_received_edit.setValue(0)
            elif "VES" in payment_method:
                self.usd_received_edit.setValue(0)
                self.ves_received_edit.setValue(self.total_ves)
            else:  # Mixto
                self.usd_received_edit.setValue(0)
                self.ves_received_edit.setValue(0)
            
            self.calculate_change()
    
    def calculate_change(self):
        """Calcula el cambio a devolver"""
        try:
            usd_received = self.usd_received_edit.value()
            ves_received = self.ves_received_edit.value()
            
            # Convertir todo a USD para calcular
            total_received_usd = usd_received + (ves_received / self.exchange_rate)
            
            if total_received_usd >= self.total_usd:
                change_usd = total_received_usd - self.total_usd
                change_ves = change_usd * self.exchange_rate
                
                self.usd_change_label.setText(CurrencyUtils.format_currency(change_usd, 'USD'))
                self.ves_change_label.setText(CurrencyUtils.format_currency(change_ves, 'VES'))
                
                self.process_btn.setEnabled(True)
                self.process_btn.setText("✅ Procesar Venta")
            else:
                needed_usd = self.total_usd - total_received_usd
                needed_ves = needed_usd * self.exchange_rate
                
                self.usd_change_label.setText(f"Falta: {CurrencyUtils.format_currency(needed_usd, 'USD')}")
                self.ves_change_label.setText(f"Falta: {CurrencyUtils.format_currency(needed_ves, 'VES')}")
                
                self.process_btn.setEnabled(False)
                self.process_btn.setText("❌ Monto Insuficiente")
        
        except Exception as e:
            print(f"Error calculando cambio: {e}")
    
    def process_payment(self):
        """Procesa el pago y prepara los datos de venta"""
        try:
            payment_method = self.payment_method_combo.currentText()
            
            # Calcular cambio final
            usd_received = 0
            ves_received = 0
            usd_change = 0
            ves_change = 0
            
            if any(method in payment_method for method in ["Efectivo", "Mixto"]):
                usd_received = self.usd_received_edit.value()
                ves_received = self.ves_received_edit.value()
                
                total_received_usd = usd_received + (ves_received / self.exchange_rate)
                if total_received_usd > self.total_usd:
                    change_total_usd = total_received_usd - self.total_usd
                    usd_change = change_total_usd
                    ves_change = change_total_usd * self.exchange_rate
            
            # Preparar datos de venta
            self.sale_data = {
                'customer_name': self.customer_name_edit.text().strip() or None,
                'customer_id': self.customer_id_edit.text().strip() or None,
                'subtotal_usd': self.subtotal_usd,
                'subtotal_ves': self.subtotal_ves,
                'tax_usd': self.tax_usd,
                'tax_ves': self.tax_ves,
                'total_usd': self.total_usd,
                'total_ves': self.total_ves,
                'exchange_rate': self.exchange_rate,
                'payment_method': payment_method,
                'usd_received': usd_received,
                'ves_received': ves_received,
                'usd_change': usd_change,
                'ves_change': ves_change,
                'notes': self.notes_edit.toPlainText().strip() or None
            }
            
            self.accept()
        
        except Exception as e:
            QMessageBox.critical(self, "Error", f"Error procesando pago: {str(e)}")
    
    def get_sale_data(self):
        """Retorna los datos de la venta"""
        return self.sale_data

