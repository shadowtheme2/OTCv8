        inventory_layout.addRow(self.track_stock_check)
        
        self.stock_edit = QSpinBox()
        self.stock_edit.setMaximum(999999)
        inventory_layout.addRow("Stock actual:", self.stock_edit)
        
        self.min_stock_edit = QSpinBox()
        self.min_stock_edit.setMaximum(999999)
        self.min_stock_edit.setValue(5)
        inventory_layout.addRow("Stock mínimo:", self.min_stock_edit)
        
