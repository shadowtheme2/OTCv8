        close_btn.clicked.connect(self.accept)
        buttons_layout.addWidget(close_btn)
        
        layout.addLayout(buttons_layout)
    
    def generate_receipt(self):
        """Genera el contenido del recibo"""
        try:
            # Obtener información de la empresa desde la base de datos
            db_manager = DatabaseManager()
            company_name = db_manager.get_setting('company_name', 'Mi Empresa')
            company_address = db_manager.get_setting('company_address', '')
            company_phone = db_manager.get_setting('company_phone', '')
            company_email = db_manager.get_setting('company_email', '')
            receipt_footer = db_manager.get_setting('receipt_footer', 'Gracias por su compra')
            
            # Generar recibo
            receipt_lines = []
            receipt_lines.append("=" * 50)
            receipt_lines.append(f"{company_name}".center(50))
            
            if company_address:
                receipt_lines.append(f"{company_address}".center(50))
            if company_phone:
                receipt_lines.append(f"Tel: {company_phone}".center(50))
            if company_email:
                receipt_lines.append(f"{company_email}".center(50))
            
            receipt_lines.append("=" * 50)
            receipt_lines.append(f"RECIBO DE VENTA")
            receipt_lines.append(f"Número: {self.sale_number}")
            receipt_lines.append(f"Fecha: {datetime.now().strftime('%d/%m/%Y %H:%M:%S')}")
            
            if self.sale_data.get('customer_name'):
                receipt_lines.append(f"Cliente: {self.sale_data['customer_name']}")
            if self.sale_data.get('customer_id'):
                receipt_lines.append(f"Cédula/RIF: {self.sale_data['customer_id']}")
            
            receipt_lines.append("-" * 50)
            receipt_lines.append(f"{'PRODUCTO':<20} {'CANT':<5} {'PRECIO':<12} {'TOTAL':<12}")
            receipt_lines.append("-" * 50)
            
            for item in self.sale_items:
                name = item['product_name'][:20]
                qty = str(item['quantity'])
                price = CurrencyUtils.format_currency(item['unit_price_usd'], 'USD')
                total = CurrencyUtils.format_currency(item['total_usd'], 'USD')
                
                receipt_lines.append(f"{name:<20} {qty:<5} {price:<12} {total:<12}")
            
            receipt_lines.append("-" * 50)
            receipt_lines.append(f"{'Subtotal USD:':<30} {CurrencyUtils.format_currency(self.sale_data['subtotal_usd'], 'USD'):>19}")
            receipt_lines.append(f"{'Subtotal VES:':<30} {CurrencyUtils.format_currency(self.sale_data['subtotal_ves'], 'VES'):>19}")
            
            if self.sale_data['tax_usd'] > 0:
                receipt_lines.append(f"{'Impuestos USD:':<30} {CurrencyUtils.format_currency(self.sale_data['tax_usd'], 'USD'):>19}")
                receipt_lines.append(f"{'Impuestos VES:':<30} {CurrencyUtils.format_currency(self.sale_data['tax_ves'], 'VES'):>19}")
            
            receipt_lines.append("=" * 50)
            receipt_lines.append(f"{'TOTAL USD:':<30} {CurrencyUtils.format_currency(self.sale_data['total_usd'], 'USD'):>19}")
            receipt_lines.append(f"{'TOTAL VES:':<30} {CurrencyUtils.format_currency(self.sale_data['total_ves'], 'VES'):>19}")
            receipt_lines.append("=" * 50)
            
            receipt_lines.append(f"Método de pago: {self.sale_data['payment_method']}")
            receipt_lines.append(f"Tasa de cambio: {CurrencyUtils.format_currency(self.sale_data['exchange_rate'], 'VES')}/USD")
            
            if self.sale_data.get('usd_received', 0) > 0 or self.sale_data.get('ves_received', 0) > 0:
                receipt_lines.append("-" * 50)
                if self.sale_data.get('usd_received', 0) > 0:
                    receipt_lines.append(f"{'Recibido USD:':<30} {CurrencyUtils.format_currency(self.sale_data['usd_received'], 'USD'):>19}")
                if self.sale_data.get('ves_received', 0) > 0:
                    receipt_lines.append(f"{'Recibido VES:':<30} {CurrencyUtils.format_currency(self.sale_data['ves_received'], 'VES'):>19}")
                
                if self.sale_data.get('usd_change', 0) > 0:
                    receipt_lines.append(f"{'Cambio USD:':<30} {CurrencyUtils.format_currency(self.sale_data['usd_change'], 'USD'):>19}")
                if self.sale_data.get('ves_change', 0) > 0:
                    receipt_lines.append(f"{'Cambio VES:':<30} {CurrencyUtils.format_currency(self.sale_data['ves_change'], 'VES'):>19}")
            
            if self.sale_data.get('notes'):
                receipt_lines.append("-" * 50)
                receipt_lines.append(f"Notas: {self.sale_data['notes']}")
            
            receipt_lines.append("=" * 50)
            receipt_lines.append(f"{receipt_footer}".center(50))
            receipt_lines.append("=" * 50)
            
            self.receipt_content = "\n".join(receipt_lines)
            self.receipt_text.setPlainText(self.receipt_content)
            
            db_manager.close()
            
        except Exception as e:
            QMessageBox.critical(self, "Error", f"Error generando recibo: {str(e)}")
    
    def print_receipt(self):
        """Imprime el recibo"""
        try:
            printer = QPrinter()
            print_dialog = QPrintDialog(printer, self)
            
            if print_dialog.exec_() == QPrintDialog.Accepted:
                document = QTextDocument()
                document.setPlainText(self.receipt_content)
                document.print_(printer)
                
                QMessageBox.information(self, "Impresión", "Recibo enviado a la impresora.")
        except Exception as e:
            QMessageBox.critical(self, "Error", f"Error imprimiendo recibo: {str(e)}")
    
    def save_receipt(self):
        """Guarda el recibo como archivo de texto"""
        try:
            filename, _ = QFileDialog.getSaveFileName(
                self, "Guardar Recibo",
                f"recibo_{self.sale_number}.txt",
                "Archivos de texto (*.txt)"
            )
            
            if filename:
                with open(filename, 'w', encoding='utf-8') as f:
                    f.write(self.receipt_content)
                
                QMessageBox.information(self, "Guardado", f"Recibo guardado en:\n{filename}")
        except Exception as e:
            QMessageBox.critical(self, "Error", f"Error guardando recibo: {str(e)}")

