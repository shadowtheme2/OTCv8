        save_btn = ModernButton(save_text, "success")
        save_btn.clicked.connect(self.save_product)
        buttons_layout.addWidget(save_btn)
        
        layout.addLayout(buttons_layout)
    
    def load_categories(self):
        """Carga las categorías disponibles"""
        self.category_combo.clear()
        categories = self.db_manager.get_categories()
        
        for category in categories:
            self.category_combo.addItem(category['name'], category['id'])
    
    def load_product_data(self):
        """Carga los datos del producto para edición"""
        if not self.product:
            return
        
        self.name_edit.setText(self.product['name'])
        self.description_edit.setPlainText(self.product['description'] or '')
        self.barcode_edit.setText(self.product['barcode'] or '')
        self.cost_usd_edit.setValue(self.product['cost_usd'])
        self.price_usd_edit.setValue(self.product['price_usd'])
        self.tax_rate_edit.setValue(self.product['tax_rate'])
        self.stock_edit.setValue(self.product['stock'])
        self.min_stock_edit.setValue(self.product['min_stock'])
        self.track_stock_check.setChecked(bool(self.product['track_stock']))
        self.active_check.setChecked(bool(self.product['active']))
        
        # Seleccionar categoría
        for i in range(self.category_combo.count()):
            if self.category_combo.itemData(i) == self.product['category_id']:
                self.category_combo.setCurrentIndex(i)
                break
    
    def on_track_stock_changed(self, checked):
        """Maneja el cambio en el control de inventario"""
        self.stock_edit.setEnabled(checked)
        self.min_stock_edit.setEnabled(checked)
    
    def save_product(self):
        """Guarda el producto"""
        try:
            # Validar campos requeridos
            if not self.name_edit.text().strip():
                QMessageBox.warning(self, "Validación", "El nombre del producto es requerido.")
                return
            
            if self.category_combo.currentData() is None:
                QMessageBox.warning(self, "Validación", "Debe seleccionar una categoría.")
                return
            
            if self.price_usd_edit.value() <= 0:
                QMessageBox.warning(self, "Validación", "El precio debe ser mayor a cero.")
                return
            
            # Preparar datos
            product_data = {
                'name': self.name_edit.text().strip(),
                'description': self.description_edit.toPlainText().strip() or None,
                'category_id': self.category_combo.currentData(),
                'barcode': self.barcode_edit.text().strip() or None,
                'cost_usd': self.cost_usd_edit.value(),
                'price_usd': self.price_usd_edit.value(),
                'tax_rate': self.tax_rate_edit.value(),
                'stock': self.stock_edit.value() if self.track_stock_check.isChecked() else 0,
                'min_stock': self.min_stock_edit.value() if self.track_stock_check.isChecked() else 0,
                'track_stock': self.track_stock_check.isChecked(),
                'active': self.active_check.isChecked()
            }
            
            # Guardar producto
            if self.is_editing:
                success = self.db_manager.update_product(self.product['id'], product_data)
                message = "Producto actualizado exitosamente."
            else:
                product_id = self.db_manager.create_product(product_data)
                success = product_id is not None
                message = "Producto creado exitosamente."
            
            if success:
                QMessageBox.information(self, "Éxito", message)
                self.accept()
            else:
                QMessageBox.critical(self, "Error", "No se pudo guardar el producto.")
        
        except Exception as e:
            QMessageBox.critical(self, "Error", f"Error guardando producto: {str(e)}")

