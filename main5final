    def load_categories(self):
        """Carga las categorías en el filtro"""
        self.category_filter.clear()
        self.category_filter.addItem("Todas", None)
        
        categories = self.db_manager.get_categories()
        for category in categories:
            self.category_filter.addItem(category['name'], category['id'])
    
    def load_products(self):
        """Carga y muestra los productos"""
        try:
            # Limpiar layout actual
            for i in reversed(range(self.products_layout.count())):
                child = self.products_layout.itemAt(i).widget()
                if child:
                    child.setParent(None)
            
            # Obtener productos
            search_term = self.search_edit.text().strip()
            category_id = self.category_filter.currentData()
            
            products = self.db_manager.get_products(
                active_only=True,
                category_id=category_id,
                search_term=search_term if search_term else None
            )
            
            # Crear cards de productos
            row = 0
            col = 0
            max_cols = 3
            
            for product in products:
                card = self.create_product_card(product)
                self.products_layout.addWidget(card, row, col)
                
                col += 1
                if col >= max_cols:
                    col = 0
                    row += 1
            
            # Agregar espaciador
            self.products_layout.addItem(QSpacerItem(20, 40, QSizePolicy.Minimum, QSizePolicy.Expanding), row + 1, 0)
            
        except Exception as e:
            QMessageBox.critical(self, "Error", f"Error cargando productos: {str(e)}")
    
    def create_product_card(self, product):
        """Crea una tarjeta de producto"""
        card = QFrame()
        card.setFrameStyle(QFrame.Box)
        card.setProperty("class", "product-card")
        card.setMinimumSize(200, 150)
        card.setMaximumSize(250, 200)
        
        layout = QVBoxLayout(card)
        
        # Nombre del producto
        name_label = QLabel(product['name'])
        name_label.setProperty("class", "product-name")
        name_label.setWordWrap(True)
        name_label.setAlignment(Qt.AlignCenter)
        layout.addWidget(name_label)
        
        # Precios
        price_usd = CurrencyUtils.format_currency(product['price_usd'], 'USD')
        price_ves = CurrencyUtils.format_currency(product['price_ves'], 'VES')
        
        price_label = QLabel(f"{price_usd}\n{price_ves}")
        price_label.setProperty("class", "product-price")
        price_label.setAlignment(Qt.AlignCenter)
        layout.addWidget(price_label)
        
        # Stock
        if product['track_stock']:
            stock_text = f"Stock: {product['stock']}"
            if product['stock'] <= product['min_stock']:
                stock_text += " ⚠️"
            
            stock_label = QLabel(stock_text)
            stock_label.setProperty("class", "product-stock")
            stock_label.setAlignment(Qt.AlignCenter)
            layout.addWidget(stock_label)
        
        # Botón agregar
        add_btn = ModernButton("➕ Agregar", "success")
        add_btn.clicked.connect(lambda: self.add_to_cart(product))
        layout.addWidget(add_btn)
        
        # Verificar disponibilidad
        if product['track_stock'] and product['stock'] <= 0:
            add_btn.setEnabled(False)
            add_btn.setText("Sin Stock")
            card.setProperty("class", "product-card-disabled")
        
        return card
    
    def filter_products(self):
        """Filtra los productos según los criterios de búsqueda"""
        self.load_products()
    
    def add_to_cart(self, product):
        """Agrega un producto al carrito"""
        try:
            # Verificar stock si es necesario
            if product['track_stock']:
                # Verificar cuántos ya están en el carrito
                current_qty = sum(item['quantity'] for item in self.cart_items if item['product_id'] == product['id'])
                
                if current_qty >= product['stock']:
                    QMessageBox.warning(self, "Stock Insuficiente", 
                                      f"No hay suficiente stock disponible.\nStock actual: {product['stock']}")
                    return
            
            # Buscar si el producto ya está en el carrito
            existing_item = None
            for item in self.cart_items:
                if item['product_id'] == product['id']:
                    existing_item = item
                    break
            
            if existing_item:
                # Incrementar cantidad
                existing_item['quantity'] += 1
            else:
                # Agregar nuevo item
                cart_item = {
                    'product_id': product['id'],
                    'name': product['name'],
                    'price_usd': product['price_usd'],
                    'price_ves': product['price_ves'],
                    'tax_rate': product['tax_rate'],
                    'quantity': 1,
                    'track_stock': product['track_stock']
                }
                self.cart_items.append(cart_item)
            
            # Actualizar interfaz
            self.update_cart_display()
            self.update_totals()
            
        except Exception as e:
            QMessageBox.critical(self, "Error", f"Error agregando producto al carrito: {str(e)}")
    
    def update_cart_display(self):
        """Actualiza la visualización del carrito"""
        self.cart_list.clear()
        
        for i, item in enumerate(self.cart_items):
            # Crear widget personalizado para el item
            item_widget = QWidget()
            item_layout = QHBoxLayout(item_widget)
            item_layout.setContentsMargins(5, 5, 5, 5)
            
            # Información del producto
            info_layout = QVBoxLayout()
            
            name_label = QLabel(item['name'])
            name_label.setProperty("class", "cart-item-name")
            info_layout.addWidget(name_label)
            
            price_usd = CurrencyUtils.format_currency(item['price_usd'], 'USD')
            price_ves = CurrencyUtils.format_currency(item['price_ves'], 'VES')
            price_label = QLabel(f"{price_usd} | {price_ves}")
            price_label.setProperty("class", "cart-item-price")
            info_layout.addWidget(price_label)
            
            item_layout.addLayout(info_layout)
            
            # Controles de cantidad
            qty_layout = QHBoxLayout()
            
            minus_btn = ModernButton("➖", "warning")
            minus_btn.setMaximumSize(30, 30)
            minus_btn.clicked.connect(lambda checked, idx=i: self.decrease_quantity(idx))
            qty_layout.addWidget(minus_btn)
            
            qty_label = QLabel(str(item['quantity']))
            qty_label.setProperty("class", "cart-quantity")
            qty_label.setAlignment(Qt.AlignCenter)
            qty_label.setMinimumWidth(30)
            qty_layout.addWidget(qty_label)
            
            plus_btn = ModernButton("➕", "success")
            plus_btn.setMaximumSize(30, 30)
            plus_btn.clicked.connect(lambda checked, idx=i: self.increase_quantity(idx))
            qty_layout.addWidget(plus_btn)
            
            # Verificar stock para el botón +
            if item['track_stock']:
                product = self.db_manager.get_product(item['product_id'])
                if product and item['quantity'] >= product['stock']:
                    plus_btn.setEnabled(False)
            
            item_layout.addLayout(qty_layout)
            
            # Botón eliminar
            remove_btn = ModernButton("🗑️", "danger")
            remove_btn.setMaximumSize(30, 30)
            remove_btn.clicked.connect(lambda checked, idx=i: self.remove_from_cart(idx))
            item_layout.addWidget(remove_btn)
            
            # Agregar al list widget
            list_item = QListWidgetItem()
            list_item.setSizeHint(item_widget.sizeHint())
            self.cart_list.addItem(list_item)
            self.cart_list.setItemWidget(list_item, item_widget)
        
        # Habilitar/deshabilitar botón de checkout
        self.checkout_btn.setEnabled(len(self.cart_items) > 0)
    
    def increase_quantity(self, index):
        """Incrementa la cantidad de un item del carrito"""
        if index < len(self.cart_items):
            item = self.cart_items[index]
            
            # Verificar stock si es necesario
            if item['track_stock']:
                product = self.db_manager.get_product(item['product_id'])
                if product and item['quantity'] >= product['stock']:
                    QMessageBox.warning(self, "Stock Insuficiente", 
                                      f"No hay más stock disponible.\nStock actual: {product['stock']}")
                    return
            
            item['quantity'] += 1
            self.update_cart_display()
            self.update_totals()
    
    def decrease_quantity(self, index):
        """Decrementa la cantidad de un item del carrito"""
        if index < len(self.cart_items):
            item = self.cart_items[index]
            
            if item['quantity'] > 1:
                item['quantity'] -= 1
                self.update_cart_display()
                self.update_totals()
            else:
                self.remove_from_cart(index)
    
    def remove_from_cart(self, index):
        """Elimina un item del carrito"""
        if index < len(self.cart_items):
            self.cart_items.pop(index)
            self.update_cart_display()
            self.update_totals()
    
    def clear_cart(self):
        """Limpia el carrito"""
        if self.cart_items:
            reply = QMessageBox.question(
                self, "Limpiar Carrito",
                "¿Está seguro de que desea limpiar el carrito?",
                QMessageBox.Yes | QMessageBox.No,
                QMessageBox.No
            )
            
            if reply == QMessageBox.Yes:
                self.cart_items.clear()
                self.update_cart_display()
                self.update_totals()
    
    def update_totals(self):
        """Actualiza los totales del carrito"""
        subtotal_usd = 0
        subtotal_ves = 0
        tax_usd = 0
        tax_ves = 0
        
        for item in self.cart_items:
            item_total_usd = item['price_usd'] * item['quantity']
            item_total_ves = item['price_ves'] * item['quantity']
            
            subtotal_usd += item_total_usd
            subtotal_ves += item_total_ves
            
            # Calcular impuestos
            if item['tax_rate'] > 0:
                item_tax_usd = item_total_usd * (item['tax_rate'] / 100)
                item_tax_ves = item_total_ves * (item['tax_rate'] / 100)
                
                tax_usd += item_tax_usd
                tax_ves += item_tax_ves
        
        total_usd = subtotal_usd + tax_usd
        total_ves = subtotal_ves + tax_ves
        
        # Actualizar labels
        self.subtotal_usd_label.setText(CurrencyUtils.format_currency(subtotal_usd, 'USD'))
        self.subtotal_ves_label.setText(CurrencyUtils.format_currency(subtotal_ves, 'VES'))
        self.tax_usd_label.setText(CurrencyUtils.format_currency(tax_usd, 'USD'))
        self.tax_ves_label.setText(CurrencyUtils.format_currency(tax_ves, 'VES'))
        self.total_usd_label.setText(CurrencyUtils.format_currency(total_usd, 'USD'))
        self.total_ves_label.setText(CurrencyUtils.format_currency(total_ves, 'VES'))
    
    def update_datetime(self):
        """Actualiza la fecha y hora en la barra de estado"""
        current_time = QDateTime.currentDateTime()
        self.datetime_label.setText(current_time.toString("dd/MM/yyyy hh:mm:ss"))
    
    def update_exchange_rate_display(self):
        """Actualiza la visualización de la tasa de cambio"""
        rate_text = CurrencyUtils.format_currency(self.current_exchange_rate, 'VES')
        self.exchange_rate_label.setText(f"Tasa: {rate_text} / USD")
    
    def update_exchange_rate(self):
        """Actualiza manualmente la tasa de cambio"""
        dialog = ExchangeRateDialog(self.db_manager, self)
        if dialog.exec_() == QDialog.Accepted:
            self.current_exchange_rate = self.db_manager.get_current_exchange_rate()
            self.update_exchange_rate_display()
            
            # Recargar productos para actualizar precios en VES
            self.load_products()
            
            # Actualizar totales del carrito
            self.update_cart_totals_with_new_rate()
    
    def auto_update_exchange_rate(self):
        """Actualiza automáticamente la tasa de cambio"""
        try:
            # Aquí se podría implementar la actualización automática desde una API
            # Por ahora solo actualizamos la visualización
            self.current_exchange_rate = self.db_manager.get_current_exchange_rate()
            self.update_exchange_rate_display()
        except Exception as e:
            print(f"Error en actualización automática: {str(e)}")
    
    def update_cart_totals_with_new_rate(self):
        """Actualiza los totales del carrito con la nueva tasa"""
        # Recalcular precios VES para items en el carrito
        for item in self.cart_items:
            product = self.db_manager.get_product(item['product_id'])
            if product:
                item['price_ves'] = product['price_ves']
        
        self.update_cart_display()
        self.update_totals()
    
    def process_checkout(self):
        """Procesa el pago y finaliza la venta"""
        if not self.cart_items:
            QMessageBox.warning(self, "Carrito Vacío", "No hay productos en el carrito.")
            return
        
        try:
            # Calcular totales
            subtotal_usd = sum(item['price_usd'] * item['quantity'] for item in self.cart_items)
            subtotal_ves = sum(item['price_ves'] * item['quantity'] for item in self.cart_items)
            
            tax_usd = sum(item['price_usd'] * item['quantity'] * (item['tax_rate'] / 100) 
                         for item in self.cart_items if item['tax_rate'] > 0)
            tax_ves = sum(item['price_ves'] * item['quantity'] * (item['tax_rate'] / 100) 
                         for item in self.cart_items if item['tax_rate'] > 0)
            
            total_usd = subtotal_usd + tax_usd
            total_ves = subtotal_ves + tax_ves
            
            # Abrir diálogo de pago
            payment_dialog = PaymentDialog(
                self.cart_items, self.current_exchange_rate, self
            )

            
            if payment_dialog.exec_() == QDialog.Accepted:
                payment_info = payment_dialog.get_payment_info()
                
                # Crear la venta
                sale_data = {
                    'customer_name': payment_info.get('customer_name'),
                    'payment_method': payment_info['payment_method'],
                    'subtotal_usd': subtotal_usd,
                    'subtotal_ves': subtotal_ves,
                    'tax_usd': tax_usd,
                    'tax_ves': tax_ves,
                    'total_usd': total_usd,
                    'total_ves': total_ves,
                    'exchange_rate': self.current_exchange_rate,
                    'items': self.cart_items
                }
                
                sale_id = self.db_manager.create_sale(sale_data)
                
                if sale_id:
                    # Mostrar recibo
                    self.show_receipt(sale_id, payment_info)
                    
                    # Limpiar carrito
                    self.cart_items.clear()
                    self.update_cart_display()
                    self.update_totals()
                    
                    # Recargar productos (por si cambió el stock)
                    self.load_products()
                    
                    QMessageBox.information(self, "Venta Exitosa", 
                                          f"Venta procesada exitosamente.\nNúmero de venta: {sale_id}")
                else:
                    QMessageBox.critical(self, "Error", "No se pudo procesar la venta.")
        
        except Exception as e:
            QMessageBox.critical(self, "Error", f"Error procesando la venta: {str(e)}")
    
    def show_receipt(self, sale_id, payment_info):
        """Muestra el recibo de la venta"""
        try:
            sale = self.db_manager.get_sale(sale_id)
            if sale:
                receipt_dialog = ReceiptDialog(sale, self.db_manager, self)
                receipt_dialog.exec_()
        except Exception as e:
