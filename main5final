# ============================================================================

class ExchangeRateManager(QObject):
    """Gestor para actualización automática de tasa de cambio"""
    
    rate_updated = pyqtSignal(float)
    error_occurred = pyqtSignal(str)
    
    def __init__(self):
        super().__init__()
        self.current_rate = Config.DEFAULT_EXCHANGE_RATE
        self.timer = QTimer()
        self.timer.timeout.connect(self.update_rate)
        self.is_running = False
    
    def start(self):
        """Inicia la actualización automática"""
        self.is_running = True
        self.update_rate()  # Actualizar inmediatamente
        self.timer.start(Config.UPDATE_INTERVAL * 1000)  # Convertir a milisegundos
    
    def stop(self):
        """Detiene la actualización automática"""
        self.is_running = False
        self.timer.stop()
    
    def update_rate(self):
        """Actualiza la tasa de cambio desde APIs externas"""
        if not self.is_running:
            return
        
        # Ejecutar en hilo separado para no bloquear la UI
        thread = threading.Thread(target=self._fetch_rate)
        thread.daemon = True
        thread.start()
    
    def _fetch_rate(self):
        """Obtiene la tasa de cambio de APIs externas"""
        try:
            # Intentar con diferentes APIs
            for api_url in Config.EXCHANGE_RATE_APIS:
                try:
                    response = requests.get(api_url, timeout=10)
                    if response.status_code == 200:
                        data = response.json()
                        
                        # Procesar según la API
                        if 'rates' in data and 'VES' in data['rates']:
                            rate = float(data['rates']['VES'])
                        elif 'VES' in data:
                            rate = float(data['VES'])
                        else:
                            continue
                        
                        if rate > 0:
                            self.current_rate = rate
                            self.rate_updated.emit(rate)
                            return
                
                except Exception as e:
                    continue
            
            # Si no se pudo obtener de ninguna API, usar tasa por defecto
            self.error_occurred.emit("No se pudo actualizar la tasa de cambio")
        
        except Exception as e:
            self.error_occurred.emit(f"Error actualizando tasa: {str(e)}")

