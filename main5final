class DatabaseManager:
    """Gestor de base de datos mejorado con mejor manejo de errores"""
    
    def __init__(self, db_path="pos_venezuela.db"):
        self.db_path = db_path
        self.connection = None
        self.connect()
        self.create_tables()
        self.initialize_default_data()
    
    def connect(self):
        """Conecta a la base de datos"""
        try:
            # Crear directorio si no existe
            db_dir = os.path.dirname(os.path.abspath(self.db_path))
            if not os.path.exists(db_dir):
                os.makedirs(db_dir)
            
            # Conectar a la base de datos
            self.connection = sqlite3.connect(self.db_path, check_same_thread=False)
            self.connection.row_factory = sqlite3.Row
            
            # Configurar WAL mode para mejor concurrencia
            self.connection.execute("PRAGMA journal_mode=WAL")
            self.connection.execute("PRAGMA foreign_keys=ON")
            self.connection.commit()
            
            print(f"✅ Conectado a la base de datos: {self.db_path}")
            
        except Exception as e:
            print(f"❌ Error conectando a la base de datos: {str(e)}")
            self.connection = None
            raise
    
    def ensure_connection(self):
        """Asegura que la conexión esté activa"""
        if self.connection is None:
            self.connect()
        
        try:
            # Probar la conexión
            self.connection.execute("SELECT 1")
        except:
            # Reconectar si es necesario
            self.connect()
    
    def create_tables(self):
        """Crea las tablas de la base de datos"""
        try:
            self.ensure_connection()
            
            cursor = self.connection.cursor()
            
            # Tabla de configuración
            cursor.execute("""
                CREATE TABLE IF NOT EXISTS settings (
                    key TEXT PRIMARY KEY,
                    value TEXT NOT NULL,
                    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
                )
            """)
            
            # Tabla de categorías
            cursor.execute("""
                CREATE TABLE IF NOT EXISTS categories (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    name TEXT NOT NULL UNIQUE,
                    description TEXT,
                    active BOOLEAN DEFAULT 1,
                    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
                )
            """)
            
            # Tabla de productos
            cursor.execute("""
                CREATE TABLE IF NOT EXISTS products (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    name TEXT NOT NULL,
                    description TEXT,
                    sku TEXT UNIQUE,
                    barcode TEXT,
                    category_id INTEGER,
                    price_usd DECIMAL(10,2) NOT NULL DEFAULT 0,
                    price_ves DECIMAL(15,2) NOT NULL DEFAULT 0,
                    cost_usd DECIMAL(10,2) DEFAULT 0,
                    tax_rate DECIMAL(5,2) DEFAULT 0,
                    stock INTEGER DEFAULT 0,
                    min_stock INTEGER DEFAULT 0,
                    track_stock BOOLEAN DEFAULT 1,
                    active BOOLEAN DEFAULT 1,
                    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                    FOREIGN KEY (category_id) REFERENCES categories (id)
                )
            """)
            
            # Tabla de tasas de cambio
            cursor.execute("""
                CREATE TABLE IF NOT EXISTS exchange_rates (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    rate DECIMAL(15,4) NOT NULL,
                    source TEXT DEFAULT 'manual',
                    active BOOLEAN DEFAULT 1,
                    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
                )
            """)
            
            # Tabla de ventas
            cursor.execute("""
                CREATE TABLE IF NOT EXISTS sales (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    sale_number TEXT NOT NULL UNIQUE,
                    customer_name TEXT,
                    payment_method TEXT NOT NULL,
                    subtotal_usd DECIMAL(10,2) NOT NULL DEFAULT 0,
                    subtotal_ves DECIMAL(15,2) NOT NULL DEFAULT 0,
                    tax_usd DECIMAL(10,2) NOT NULL DEFAULT 0,
                    tax_ves DECIMAL(15,2) NOT NULL DEFAULT 0,
                    total_usd DECIMAL(10,2) NOT NULL DEFAULT 0,
                    total_ves DECIMAL(15,2) NOT NULL DEFAULT 0,
                    exchange_rate DECIMAL(15,4) NOT NULL,
                    status TEXT DEFAULT 'completed',
                    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
                )
            """)
            
            # Tabla de items de venta
            cursor.execute("""
                CREATE TABLE IF NOT EXISTS sale_items (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    sale_id INTEGER NOT NULL,
                    product_id INTEGER NOT NULL,
                    product_name TEXT NOT NULL,
                    quantity INTEGER NOT NULL,
                    price_usd DECIMAL(10,2) NOT NULL,
                    price_ves DECIMAL(15,2) NOT NULL,
                    tax_rate DECIMAL(5,2) DEFAULT 0,
                    subtotal_usd DECIMAL(10,2) NOT NULL,
                    subtotal_ves DECIMAL(15,2) NOT NULL,
                    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                    FOREIGN KEY (sale_id) REFERENCES sales (id),
                    FOREIGN KEY (product_id) REFERENCES products (id)
                )
            """)
            
            # Crear índices
            cursor.execute("CREATE INDEX IF NOT EXISTS idx_products_category ON products(category_id)")
            cursor.execute("CREATE INDEX IF NOT EXISTS idx_products_active ON products(active)")
            cursor.execute("CREATE INDEX IF NOT EXISTS idx_products_barcode ON products(barcode)")
            cursor.execute("CREATE INDEX IF NOT EXISTS idx_sales_date ON sales(created_at)")
            cursor.execute("CREATE INDEX IF NOT EXISTS idx_sale_items_sale ON sale_items(sale_id)")
            cursor.execute("CREATE INDEX IF NOT EXISTS idx_exchange_rates_active ON exchange_rates(active)")
            
            self.connection.commit()
            print("✅ Tablas creadas exitosamente")
            
        except Exception as e:
            print(f"❌ Error creando tablas: {str(e)}")
            if self.connection:
                self.connection.rollback()
            raise
    
