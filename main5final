        layout.addLayout(buttons_layout)
        
        # Cargar categorías
        self.load_categories()
    
    def load_categories(self):
        """Carga las categorías en el filtro"""
        self.category_filter.clear()
        self.category_filter.addItem("Todas las categorías", None)
        
        categories = self.db_manager.get_categories()
        for category in categories:
            self.category_filter.addItem(category['name'], category['id'])
    
    def load_products(self):
        """Carga todos los productos"""
        try:
            products = self.db_manager.get_products(active_only=False)
            self.display_products(products)
        except Exception as e:
            QMessageBox.critical(self, "Error", f"Error cargando productos: {str(e)}")
    
    def filter_products(self):
        """Filtra los productos según los criterios"""
        try:
            search_term = self.search_edit.text().strip()
            category_id = self.category_filter.currentData()
            status = self.status_filter.currentText()
            
            # Determinar filtro de estado
            active_only = None
            if status == "Activos":
                active_only = True
            elif status == "Inactivos":
                active_only = False
            
            products = self.db_manager.get_products(
                active_only=active_only,
                category_id=category_id,
                search_term=search_term if search_term else None
            )
            
            self.display_products(products)
        except Exception as e:
            QMessageBox.critical(self, "Error", f"Error filtrando productos: {str(e)}")
    
    def display_products(self, products):
        """Muestra los productos en la tabla"""
        self.products_table.setRowCount(len(products))
        
        for row, product in enumerate(products):
            # ID
            self.products_table.setItem(row, 0, QTableWidgetItem(str(product['id'])))
            
            # Nombre
            self.products_table.setItem(row, 1, QTableWidgetItem(product['name']))
            
            # Categoría
            category_name = product['category_name'] or 'Sin categoría'
            self.products_table.setItem(row, 2, QTableWidgetItem(category_name))
            
            # Precio USD
            price_usd = CurrencyUtils.format_currency(product['price_usd'], 'USD')
            self.products_table.setItem(row, 3, QTableWidgetItem(price_usd))
            
            # Precio VES
            price_ves = CurrencyUtils.format_currency(product['price_ves'], 'VES')
            self.products_table.setItem(row, 4, QTableWidgetItem(price_ves))
            
            # Stock
            stock_item = QTableWidgetItem(str(product['stock']))
            if product['track_stock'] and product['stock'] <= product['min_stock']:
                stock_item.setBackground(QColor('#ffebee'))
            self.products_table.setItem(row, 5, stock_item)
            
            # Stock mínimo
            self.products_table.setItem(row, 6, QTableWidgetItem(str(product['min_stock'])))
            
            # Estado
            status_item = QTableWidgetItem("Activo" if product['active'] else "Inactivo")
            status_item.setBackground(QColor('#e8f5e8') if product['active'] else QColor('#ffebee'))
            self.products_table.setItem(row, 7, status_item)
            
            # Última actualización
            updated_at = product.get('updated_at', product.get('created_at', ''))
            if updated_at:
                try:
                    dt = datetime.fromisoformat(updated_at.replace('Z', '+00:00'))
                    formatted_date = dt.strftime('%d/%m/%Y %H:%M')
                except:
                    formatted_date = updated_at
            else:
                formatted_date = 'N/A'
            self.products_table.setItem(row, 8, QTableWidgetItem(formatted_date))
        
        # Ajustar columnas
        self.products_table.resizeColumnsToContents()
    
    def add_product(self):
        """Agrega un nuevo producto"""
        dialog = ProductDialog(self.db_manager, self)
        if dialog.exec_() == QDialog.Accepted:
            self.load_products()
            self.load_categories()
    
    def edit_product(self):
        """Edita el producto seleccionado"""
        current_row = self.products_table.currentRow()
        if current_row >= 0:
            product_id = int(self.products_table.item(current_row, 0).text())
            product = self.db_manager.get_product(product_id)
            
            if product:
                dialog = ProductDialog(self.db_manager, self, product)
                if dialog.exec_() == QDialog.Accepted:
                    self.load_products()
        else:
            QMessageBox.information(self, "Selección", "Por favor seleccione un producto para editar.")
    
    def delete_product(self):
        """Elimina el producto seleccionado"""
        current_row = self.products_table.currentRow()
        if current_row >= 0:
            product_id = int(self.products_table.item(current_row, 0).text())
            product_name = self.products_table.item(current_row, 1).text()
            
            reply = QMessageBox.question(
                self, "Confirmar Eliminación",
                f"¿Está seguro de que desea eliminar el producto '{product_name}'?\n\n"
                "Esta acción no se puede deshacer.",
                QMessageBox.Yes | QMessageBox.No,
                QMessageBox.No
            )
            
            if reply == QMessageBox.Yes:
                if self.db_manager.delete_product(product_id):
                    QMessageBox.information(self, "Éxito", "Producto eliminado exitosamente.")
                    self.load_products()
                else:
                    QMessageBox.critical(self, "Error", "No se pudo eliminar el producto.")
        else:
            QMessageBox.information(self, "Selección", "Por favor seleccione un producto para eliminar.")

