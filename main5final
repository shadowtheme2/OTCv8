        layout.addWidget(title)
        
        # Formulario para nueva categoría
        form_group = QGroupBox("➕ Nueva Categoría")
        form_layout = QHBoxLayout(form_group)
        
        self.name_edit = QLineEdit()
        self.name_edit.setPlaceholderText("Nombre de la categoría")
        self.name_edit.returnPressed.connect(self.add_category)
        form_layout.addWidget(self.name_edit)
        
        add_btn = ModernButton("➕ Agregar", "success")
        add_btn.clicked.connect(self.add_category)
        form_layout.addWidget(add_btn)
        
        layout.addWidget(form_group)
        
        # Lista de categorías
        self.categories_table = QTableWidget()
        self.categories_table.setColumnCount(4)
        self.categories_table.setHorizontalHeaderLabels([
            "ID", "Nombre", "Productos", "Acciones"
        ])
        self.categories_table.setSelectionBehavior(QAbstractItemView.SelectRows)
        self.categories_table.setAlternatingRowColors(True)
        layout.addWidget(self.categories_table)
        
        # Botones
        buttons_layout = QHBoxLayout()
        
        close_btn = ModernButton("✅ Cerrar", "primary")
        close_btn.clicked.connect(self.accept)
        buttons_layout.addWidget(close_btn)
        
        layout.addLayout(buttons_layout)
    
    def load_categories(self):
        """Carga las categorías"""
        try:
            categories = self.db_manager.get_categories()
            self.categories_table.setRowCount(len(categories))
            
            for row, category in enumerate(categories):
                # ID
                self.categories_table.setItem(row, 0, QTableWidgetItem(str(category['id'])))
                
                # Nombre
                self.categories_table.setItem(row, 1, QTableWidgetItem(category['name']))
                
                # Contar productos
                product_count = self.db_manager.get_product(category['id'])
                self.categories_table.setItem(row, 2, QTableWidgetItem(str(product_count)))
                
                # Botones de acción
                actions_widget = QWidget()
                actions_layout = QHBoxLayout(actions_widget)
                actions_layout.setContentsMargins(5, 0, 5, 0)
                
                edit_btn = ModernButton("✏️", "warning")
                edit_btn.clicked.connect(lambda checked, cat_id=category['id']: self.edit_category(cat_id))
                actions_layout.addWidget(edit_btn)
                
                delete_btn = ModernButton("🗑️", "danger")
                delete_btn.clicked.connect(lambda checked, cat_id=category['id']: self.delete_category(cat_id))
                actions_layout.addWidget(delete_btn)
                
                self.categories_table.setCellWidget(row, 3, actions_widget)
            
            # Ajustar columnas
            self.categories_table.resizeColumnsToContents()
            
        except Exception as e:
            QMessageBox.critical(self, "Error", f"Error cargando categorías: {str(e)}")
    
    def add_category(self):
        """Agrega una nueva categoría"""
        name = self.name_edit.text().strip()
        if not name:
            QMessageBox.warning(self, "Validación", "El nombre de la categoría es requerido.")
            return
        
        try:
            category_id = self.db_manager.create_category(name)
            if category_id:
                QMessageBox.information(self, "Éxito", "Categoría creada exitosamente.")
                self.name_edit.clear()
                self.load_categories()
            else:
                QMessageBox.critical(self, "Error", "No se pudo crear la categoría.")
        except Exception as e:
            QMessageBox.critical(self, "Error", f"Error creando categoría: {str(e)}")
    
    def edit_category(self, category_id):
        """Edita una categoría"""
        try:
            categories = self.db_manager.get_categories()
            category = next((cat for cat in categories if cat['id'] == category_id), None)
            if not category:
                QMessageBox.warning(self, "Error", "Categoría no encontrada.")
                return
                
            new_name, ok = QInputDialog.getText(
                self, "Editar Categoría",
                "Nuevo nombre:",
                text=category['name']
            )
            
            if ok and new_name.strip():
                if self.db_manager.update_category(category_id, new_name.strip()):
                    QMessageBox.information(self, "Éxito", "Categoría actualizada exitosamente.")
                    self.load_categories()
                else:
                    QMessageBox.critical(self, "Error", "No se pudo actualizar la categoría.")
        except Exception as e:
            QMessageBox.critical(self, "Error", f"Error editando categoría: {str(e)}")
    
    def delete_category(self, category_id):
        """Elimina una categoría"""
        try:
            categories = self.db_manager.get_categories()
            category = next((cat for cat in categories if cat['id'] == category_id), None)
            if not category:
                QMessageBox.warning(self, "Error", "Categoría no encontrada.")
                return
                
            # Verificar si tiene productos - usar el product_count del diccionario category
            product_count = category.get('product_count', 0)
            if product_count > 0:
                QMessageBox.warning(
                    self, "No se puede eliminar",
                    f"La categoría '{category['name']}' tiene {product_count} producto(s) asociado(s).\n"
                    "Debe reasignar o eliminar los productos antes de eliminar la categoría."
                )
                return
            
            reply = QMessageBox.question(
                self, "Confirmar Eliminación",
                f"¿Está seguro de que desea eliminar la categoría '{category['name']}'?",
                QMessageBox.Yes | QMessageBox.No,
                QMessageBox.No
            )
            
            if reply == QMessageBox.Yes:
                if self.db_manager.delete_category(category_id):
                    QMessageBox.information(self, "Éxito", "Categoría eliminada exitosamente.")
                    self.load_categories()
                else:
                    QMessageBox.critical(self, "Error", "No se pudo eliminar la categoría.")
        except Exception as e:
            QMessageBox.critical(self, "Error", f"Error eliminando categoría: {str(e)}")

