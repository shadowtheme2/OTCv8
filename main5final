    def load_sale_details(self):
        """Carga los detalles de los productos de la venta"""
        try:
            items = self.db_manager.get_sale_items(self.sale['id'])
            
            self.products_table.setRowCount(len(items))
            
            for row, item in enumerate(items):
                # Producto
                self.products_table.setItem(row, 0, QTableWidgetItem(item['product_name']))
                
                # Cantidad
                qty_item = QTableWidgetItem(str(item['quantity']))
                qty_item.setTextAlignment(Qt.AlignCenter)
                self.products_table.setItem(row, 1, qty_item)
                
                # Precio USD
                price_usd = CurrencyUtils.format_currency(item['price_usd'], 'USD')
                self.products_table.setItem(row, 2, QTableWidgetItem(price_usd))
                
                # Precio VES
                price_ves = CurrencyUtils.format_currency(item['price_ves'], 'VES')
                self.products_table.setItem(row, 3, QTableWidgetItem(price_ves))
                
                # Subtotal USD
                subtotal_usd = item['price_usd'] * item['quantity']
                subtotal_usd_text = CurrencyUtils.format_currency(subtotal_usd, 'USD')
                self.products_table.setItem(row, 4, QTableWidgetItem(subtotal_usd_text))
                
                # Subtotal VES
                subtotal_ves = item['price_ves'] * item['quantity']
                subtotal_ves_text = CurrencyUtils.format_currency(subtotal_ves, 'VES')
                self.products_table.setItem(row, 5, QTableWidgetItem(subtotal_ves_text))
            
            # Ajustar columnas
            self.products_table.resizeColumnsToContents()
            
        except Exception as e:
            QMessageBox.critical(self, "Error", f"Error cargando detalles: {str(e)}")
    
    def show_receipt(self):
        """Muestra el recibo de la venta"""
        try:
            dialog = ReceiptDialog(self.sale, self.db_manager, self)
            dialog.exec_()
        except Exception as e:
            QMessageBox.critical(self, "Error", f"Error mostrando recibo: {str(e)}")

