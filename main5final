class SalesHistoryDialog(QDialog):
    """Diálogo para mostrar el historial de ventas"""
    
    def __init__(self, db_manager, parent=None):
        super().__init__(parent)
        self.db_manager = db_manager
        
        self.setup_ui()
        self.load_sales()
    
    def setup_ui(self):
        """Configura la interfaz del diálogo"""
        self.setWindowTitle("📊 Historial de Ventas")
        self.setModal(True)
        self.setMinimumSize(1000, 600)
        
        layout = QVBoxLayout(self)
        
        # Título
        title = QLabel("📊 Historial de Ventas")
        title.setProperty("class", "title")
        layout.addWidget(title)
        
        # Filtros
        filters_layout = QHBoxLayout()
        
        filters_layout.addWidget(QLabel("Desde:"))
        self.start_date = QDateEdit()
        self.start_date.setDate(QDate.currentDate().addDays(-30))
        self.start_date.setCalendarPopup(True)
        filters_layout.addWidget(self.start_date)
        
        filters_layout.addWidget(QLabel("Hasta:"))
        self.end_date = QDateEdit()
        self.end_date.setDate(QDate.currentDate())
        self.end_date.setCalendarPopup(True)
        filters_layout.addWidget(self.end_date)
        
        filter_btn = ModernButton("🔍 Filtrar", "primary")
        filter_btn.clicked.connect(self.load_sales)
        filters_layout.addWidget(filter_btn)
        
        filters_layout.addStretch()
        
        layout.addLayout(filters_layout)
        
        # Tabla de ventas
        self.sales_table = QTableWidget()
        self.sales_table.setColumnCount(9)
        self.sales_table.setHorizontalHeaderLabels([
            "ID", "Número", "Fecha", "Cliente", "Total USD", "Total VES", 
            "Método Pago", "Items", "Acciones"
        ])
        self.sales_table.setSelectionBehavior(QAbstractItemView.SelectRows)
        self.sales_table.setAlternatingRowColors(True)
        self.sales_table.setSortingEnabled(True)
        layout.addWidget(self.sales_table)
        
        # Botones
        buttons_layout = QHBoxLayout()
        
        refresh_btn = ModernButton("🔄 Actualizar", "info")
        refresh_btn.clicked.connect(self.load_sales)
        buttons_layout.addWidget(refresh_btn)
        
