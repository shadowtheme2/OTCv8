class LowStockDialog(QDialog):
    """Diálogo para mostrar productos con stock bajo"""
    
    def __init__(self, db_manager, parent=None):
        super().__init__(parent)
        self.db_manager = db_manager
        
        self.setup_ui()
        self.load_low_stock_products()
    
    def setup_ui(self):
        """Configura la interfaz del diálogo"""
        self.setWindowTitle("⚠️ Productos con Stock Bajo")
        self.setModal(True)
        self.setMinimumSize(800, 500)
        
        layout = QVBoxLayout(self)
        
        # Título
        title = QLabel("⚠️ Productos con Stock Bajo")
        title.setProperty("class", "title")
        layout.addWidget(title)
        
        # Información
        info_label = QLabel("Los siguientes productos tienen stock igual o menor al mínimo configurado:")
        layout.addWidget(info_label)
        
        # Tabla de productos
        self.products_table = QTableWidget()
        self.products_table.setColumnCount(6)
        self.products_table.setHorizontalHeaderLabels([
            "Producto", "Categoría", "Stock Actual", "Stock Mínimo", "Estado", "Acciones"
        ])
        self.products_table.setSelectionBehavior(QAbstractItemView.SelectRows)
        self.products_table.setAlternatingRowColors(True)
        layout.addWidget(self.products_table)
        
        # Botones
        buttons_layout = QHBoxLayout()
        
        refresh_btn = ModernButton("🔄 Actualizar", "info")
        refresh_btn.clicked.connect(self.load_low_stock_products)
        buttons_layout.addWidget(refresh_btn)
        
        export_btn = ModernButton("📤 Exportar", "success")
        export_btn.clicked.connect(self.export_low_stock)
        buttons_layout.addWidget(export_btn)
        
        buttons_layout.addStretch()
        
        close_btn = ModernButton("❌ Cerrar", "danger")
        close_btn.clicked.connect(self.close)
        buttons_layout.addWidget(close_btn)
        
        layout.addLayout(buttons_layout)
    
    def load_low_stock_products(self):
        """Carga los productos con stock bajo"""
        try:
            products = self.db_manager.get_low_stock_products()
            
            self.products_table.setRowCount(len(products))
            
            for row, product in enumerate(products):
                # Producto
                self.products_table.setItem(row, 0, QTableWidgetItem(product['name']))
                
                # Categoría
                category_name = product['category_name'] or 'Sin categoría'
                self.products_table.setItem(row, 1, QTableWidgetItem(category_name))
                
                # Stock actual
                stock_item = QTableWidgetItem(str(product['stock']))
                stock_item.setTextAlignment(Qt.AlignCenter)
                if product['stock'] == 0:
                    stock_item.setBackground(QColor("#e74c3c"))
                    stock_item.setForeground(QColor("white"))
                elif product['stock'] <= product['min_stock']:
                    stock_item.setBackground(QColor("#f39c12"))
                    stock_item.setForeground(QColor("white"))
                self.products_table.setItem(row, 2, stock_item)
                
                # Stock mínimo
                min_stock_item = QTableWidgetItem(str(product['min_stock']))
                min_stock_item.setTextAlignment(Qt.AlignCenter)
                self.products_table.setItem(row, 3, min_stock_item)
                
                # Estado
                if product['stock'] == 0:
                    status = "🔴 Sin Stock"
                elif product['stock'] <= product['min_stock']:
                    status = "🟡 Stock Bajo"
                else:
                    status = "🟢 Normal"
                
                status_item = QTableWidgetItem(status)
                status_item.setTextAlignment(Qt.AlignCenter)
                self.products_table.setItem(row, 4, status_item)
                
                # Botones de acciones
                actions_widget = QWidget()
                actions_layout = QHBoxLayout(actions_widget)
                actions_layout.setContentsMargins(5, 2, 5, 2)
                
                edit_btn = ModernButton("✏️", "primary")
                edit_btn.setMaximumSize(30, 25)
                edit_btn.setToolTip("Editar producto")
                edit_btn.clicked.connect(lambda checked, prod_id=product['id']: self.edit_product(prod_id))
                actions_layout.addWidget(edit_btn)
                
                stock_btn = ModernButton("📦", "success")
                stock_btn.setMaximumSize(30, 25)
                stock_btn.setToolTip("Ajustar stock")
                stock_btn.clicked.connect(lambda checked, prod_id=product['id']: self.adjust_stock(prod_id))
                actions_layout.addWidget(stock_btn)
                
                self.products_table.setCellWidget(row, 5, actions_widget)
            
            # Ajustar columnas
            self.products_table.resizeColumnsToContents()
            
            # Mostrar mensaje si no hay productos
            if len(products) == 0:
                QMessageBox.information(self, "Stock Normal", 
                                      "¡Excelente! No hay productos con stock bajo.")
                self.close()
            
        except Exception as e:
            QMessageBox.critical(self, "Error", f"Error cargando productos: {str(e)}")
    
    def edit_product(self, product_id):
        """Edita un producto"""
        try:
            product = self.db_manager.get_product(product_id)
            if product:
                dialog = ProductDialog(self.db_manager, product, self)
                if dialog.exec_() == QDialog.Accepted:
                    self.load_low_stock_products()
        except Exception as e:
            QMessageBox.critical(self, "Error", f"Error editando producto: {str(e)}")
    
    def adjust_stock(self, product_id):
        """Ajusta el stock de un producto"""
        try:
            product = self.db_manager.get_product(product_id)
            if not product:
                return
            
            current_stock = product['stock']
            
            new_stock, ok = QInputDialog.getInt(
                self, "Ajustar Stock",
                f"Stock actual de '{product['name']}': {current_stock}\n\nNuevo stock:",
                current_stock, 0, 999999
            )
            
            if ok:
                # Actualizar stock
                self.db_manager.update_product_stock(product_id, new_stock)
                
                QMessageBox.information(self, "Stock Actualizado", 
                                      f"Stock actualizado de {current_stock} a {new_stock}")
                
                self.load_low_stock_products()
                
        except Exception as e:
            QMessageBox.critical(self, "Error", f"Error ajustando stock: {str(e)}")
    
    def export_low_stock(self):
        """Exporta la lista de productos con stock bajo"""
        try:
            filename, _ = QFileDialog.getSaveFileName(
                self, "Exportar Stock Bajo",
                f"stock_bajo_{QDate.currentDate().toString('yyyy-MM-dd')}.csv",
                "Archivos CSV (*.csv)"
            )
            
            if filename:
                products = self.db_manager.get_low_stock_products()
                
                import csv
                with open(filename, 'w', newline='', encoding='utf-8') as csvfile:
                    writer = csv.writer(csvfile)
                    
                    # Encabezado
                    writer.writerow([
                        "Producto", "Categoría", "Stock Actual", "Stock Mínimo", 
                        "Diferencia", "Precio USD", "Precio VES"
                    ])
                    
                    # Datos
                    for product in products:
                        difference = product['stock'] - product['min_stock']
                        writer.writerow([
                            product['name'],
                            product['category_name'] or 'Sin categoría',
                            product['stock'],
                            product['min_stock'],
                            difference,
                            f"${product['price_usd']:.2f}",
                            f"Bs. {product['price_ves']:.2f}"
                        ])
                
                QMessageBox.information(self, "Exportación Exitosa", 
                                      f"Lista exportada a:\n{filename}")
        
        except Exception as e:
            QMessageBox.critical(self, "Error", f"Error exportando lista: {str(e)}")

