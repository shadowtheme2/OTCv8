            min-height: 20px;
        }}
        QPushButton:hover {{
            opacity: 0.9;
        }}
        QPushButton:pressed {{
            padding: 11px 19px 9px 21px;
        }}
        QPushButton:disabled {{
            opacity: 0.5;
        }}
