class DatabaseManager:
    def __init__(self):
        self.db_file = DATABASE_FILE
        self.init_database()
        self.create_backup()

    def init_database(self):
        """Inicializa la base de datos"""
        conn = sqlite3.connect(self.db_file)
        cursor = conn.cursor()
        
        # Tabla de productos
        cursor.execute('''
        CREATE TABLE IF NOT EXISTS products (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            name TEXT NOT NULL,
            price_ves REAL NOT NULL,
            price_usd REAL NOT NULL,
            stock REAL NOT NULL DEFAULT 0,
            profit_percentage REAL DEFAULT 0,
            cost_price_ves REAL DEFAULT 0,
            cost_price_usd REAL DEFAULT 0,
            created_at TEXT DEFAULT CURRENT_TIMESTAMP
        )
        ''')
        
        # Tabla de ventas con campo closed
        cursor.execute('''
        CREATE TABLE IF NOT EXISTS sales (
            id TEXT PRIMARY KEY,
            timestamp TEXT NOT NULL,
            total_usd REAL NOT NULL,
            total_ves REAL NOT NULL,
            payment_method TEXT NOT NULL,
            usd_received REAL DEFAULT 0,
            ves_received REAL DEFAULT 0,
            usd_change REAL DEFAULT 0,
            ves_change REAL DEFAULT 0,
            exchange_rate REAL NOT NULL,
            items TEXT NOT NULL,
            discount_percentage REAL DEFAULT 0,
            closed INTEGER DEFAULT 0
        )
        ''')
        
        # Tabla de items de venta
        cursor.execute('''
        CREATE TABLE IF NOT EXISTS sale_items (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            sale_id TEXT NOT NULL,
            product_id INTEGER NOT NULL,
            product_name TEXT NOT NULL,
            quantity REAL NOT NULL,
            price_usd REAL NOT NULL,
            price_ves REAL NOT NULL,
            cost_price_usd REAL NOT NULL,
            cost_price_ves REAL NOT NULL,
            discount_percentage REAL DEFAULT 0,
            subtotal_usd REAL NOT NULL,
            subtotal_ves REAL NOT NULL,
            FOREIGN KEY (sale_id) REFERENCES sales (id),
            FOREIGN KEY (product_id) REFERENCES products (id)
        )
        ''')
        
        # Agregar columnas para costos si no existen
        try:
            cursor.execute('ALTER TABLE products ADD COLUMN cost_price_ves REAL DEFAULT 0')
            cursor.execute('ALTER TABLE products ADD COLUMN cost_price_usd REAL DEFAULT 0')
        except sqlite3.OperationalError:
            pass  # Las columnas ya existen
        
        # Agregar columna closed si no existe
        try:
            cursor.execute('ALTER TABLE sales ADD COLUMN closed INTEGER DEFAULT 0')
        except sqlite3.OperationalError:
            pass  # La columna ya existe
        
        # Tabla de configuración
        cursor.execute('''
        CREATE TABLE IF NOT EXISTS config (
            key TEXT PRIMARY KEY,
            value TEXT NOT NULL
        )
        ''')
        
        # Tabla para atajos de teclado
        cursor.execute('''
        CREATE TABLE IF NOT EXISTS shortcuts (
            action TEXT PRIMARY KEY,
            shortcut TEXT NOT NULL
        )
        ''')
        
        # Inicializar atajos de teclado si no existen
        for action, shortcut in DEFAULT_SHORTCUTS.items():
            cursor.execute('''
            INSERT OR IGNORE INTO shortcuts (action, shortcut) VALUES (?, ?)
            ''', (action, shortcut))
        
        conn.commit()
        conn.close()

    def create_backup(self):
        """Crea backup temporal"""
        try:
            timestamp = datetime.now().isoformat()
            backup_data = {
                'timestamp': timestamp,
                'products': self.get_products(),
                'sales_count': len(self.get_daily_sales())
            }
            os.makedirs("backups", exist_ok=True)
            with open(f"backups/backup_temp_{datetime.now().strftime('%Y%m%d')}.json", 'w') as f:
                json.dump(backup_data, f, indent=2)
        except Exception as e:
            print(f"Error creando backup: {e}")

    def add_product(self, name, price_ves, stock, profit_percentage=0, cost_price_ves=0, exchange_rate=36.50):
        """Agrega un producto"""
        try:
            cost_price_usd = cost_price_ves / exchange_rate
            final_price_ves = cost_price_ves * (1 + profit_percentage/100)
            final_price_usd = final_price_ves / exchange_rate
            
            conn = sqlite3.connect(self.db_file)
            cursor = conn.cursor()
            cursor.execute('''
            INSERT INTO products (name, price_ves, price_usd, stock, profit_percentage, cost_price_ves, cost_price_usd)
            VALUES (?, ?, ?, ?, ?, ?, ?)
            ''', (name, final_price_ves, final_price_usd, stock, profit_percentage, cost_price_ves, cost_price_usd))
            conn.commit()
            conn.close()
            self.create_backup()
            return True
        except Exception as e:
            print(f"Error agregando producto: {e}")
            return False

    def update_product(self, product_id, name, price_ves, stock, profit_percentage, cost_price_ves, exchange_rate):
        """Actualiza un producto"""
        try:
            cost_price_usd = cost_price_ves / exchange_rate
            final_price_ves = cost_price_ves * (1 + profit_percentage/100)
            final_price_usd = final_price_ves / exchange_rate
            
            conn = sqlite3.connect(self.db_file)
            cursor = conn.cursor()
            cursor.execute('''
            UPDATE products 
            SET name=?, price_ves=?, price_usd=?, stock=?, profit_percentage=?, cost_price_ves=?, cost_price_usd=?
            WHERE id=?
            ''', (name, final_price_ves, final_price_usd, stock, profit_percentage, cost_price_ves, cost_price_usd, product_id))
            conn.commit()
            conn.close()
            self.create_backup()
            return True
        except Exception as e:
            print(f"Error actualizando producto: {e}")
            return False

    def add_stock(self, product_id, additional_stock):
        """Agrega stock a un producto existente"""
        try:
            conn = sqlite3.connect(self.db_file)
            cursor = conn.cursor()
            cursor.execute('''
            UPDATE products SET stock = stock + ? WHERE id = ?
            ''', (additional_stock, product_id))
            conn.commit()
            conn.close()
            self.create_backup()
            return True
        except Exception as e:
            print(f"Error agregando stock: {e}")
            return False

    def get_products(self, search_term=""):
        """Obtiene productos con búsqueda opcional"""
        conn = sqlite3.connect(self.db_file)
        cursor = conn.cursor()
        
        if search_term:
            cursor.execute('''
            SELECT * FROM products WHERE name LIKE ? OR id LIKE ? ORDER BY name
            ''', (f'%{search_term}%', f'%{search_term}%'))
        else:
            cursor.execute('SELECT * FROM products ORDER BY name')
            
        products = cursor.fetchall()
        conn.close()
        return products

    def get_all_products(self):
        """Obtiene todos los productos"""
        return self.get_products()

    def search_products(self, search_term):
        """Busca productos por término"""
        return self.get_products(search_term)

    def get_product_by_id(self, product_id):
        """Obtiene un producto por ID"""
        conn = sqlite3.connect(self.db_file)
        cursor = conn.cursor()
        cursor.execute('SELECT * FROM products WHERE id = ?', (product_id,))
        product = cursor.fetchone()
        conn.close()
        return product

    def update_product_stock(self, product_id, quantity_sold):
        """Actualiza el stock de un producto después de una venta"""
        try:
            conn = sqlite3.connect(self.db_file)
            cursor = conn.cursor()
            cursor.execute('''
            UPDATE products SET stock = stock - ? WHERE id = ?
            ''', (quantity_sold, product_id))
            conn.commit()
            conn.close()
            return True
        except Exception as e:
            print(f"Error actualizando stock: {e}")
            return False

    def create_sale(self, total_usd, total_ves, payment_method, exchange_rate, usd_received=0, ves_received=0, usd_change=0, ves_change=0):
        """Crea una nueva venta y retorna el ID"""
        try:
            sale_id = str(uuid.uuid4())
            conn = sqlite3.connect(self.db_file)
            cursor = conn.cursor()
            cursor.execute('''
            INSERT INTO sales (id, timestamp, total_usd, total_ves, payment_method, 
                              usd_received, ves_received, usd_change, ves_change, 
                              exchange_rate, items, discount_percentage, closed)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
            ''', (
                sale_id, datetime.now().isoformat(), total_usd, total_ves, payment_method,
                usd_received, ves_received, usd_change, ves_change,
                exchange_rate, "[]", 0, 0
            ))
            conn.commit()
            conn.close()
            return sale_id
        except Exception as e:
            print(f"Error creando venta: {e}")
            return None

    def add_sale_item(self, sale_id, product_id, product_name, quantity, price_usd, price_ves, cost_price_usd, cost_price_ves, discount_percentage=0):
        """Agrega un item a una venta"""
        try:
            # Aplicar descuento si existe
            discount_factor = 1 - (discount_percentage / 100)
            final_price_usd = price_usd * discount_factor
            final_price_ves = price_ves * discount_factor
            
            subtotal_usd = final_price_usd * quantity
            subtotal_ves = final_price_ves * quantity
            
            conn = sqlite3.connect(self.db_file)
            cursor = conn.cursor()
            cursor.execute('''
            INSERT INTO sale_items (sale_id, product_id, product_name, quantity, price_usd, price_ves, 
                                   cost_price_usd, cost_price_ves, discount_percentage, subtotal_usd, subtotal_ves)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
            ''', (sale_id, product_id, product_name, quantity, final_price_usd, final_price_ves, 
                 cost_price_usd, cost_price_ves, discount_percentage, subtotal_usd, subtotal_ves))
            conn.commit()
            conn.close()
            return True
        except Exception as e:
            print(f"Error agregando item de venta: {e}")
            return False

    def reduce_stock(self, product_id, quantity):
        """Reduce el stock de un producto"""
        try:
            conn = sqlite3.connect(self.db_file)
            cursor = conn.cursor()
            cursor.execute('''
            UPDATE products SET stock = stock - ? WHERE id = ?
            ''', (quantity, product_id))
            conn.commit()
            conn.close()
            return True
        except Exception as e:
            print(f"Error reduciendo stock: {e}")
            return False

    def get_sale_items(self, sale_id):
        """Obtiene los items de una venta"""
        conn = sqlite3.connect(self.db_file)
        cursor = conn.cursor()
        cursor.execute('''
        SELECT * FROM sale_items WHERE sale_id = ?
        ''', (sale_id,))
        items = cursor.fetchall()
        conn.close()
        return items

    def get_sale(self, sale_id):
        """Obtiene una venta por ID"""
        conn = sqlite3.connect(self.db_file)
        cursor = conn.cursor()
        cursor.execute('''
        SELECT * FROM sales WHERE id = ?
        ''', (sale_id,))
        sale = cursor.fetchone()
        conn.close()
        return sale

    def get_daily_sales(self, date=None):
        """Obtiene las ventas del día"""
        if date is None:
            date = datetime.now().strftime('%Y-%m-%d')
        else:
            date = date.strftime('%Y-%m-%d')
            
        conn = sqlite3.connect(self.db_file)
        cursor = conn.cursor()
        cursor.execute('''
        SELECT * FROM sales WHERE date(timestamp) = ? ORDER BY timestamp DESC
        ''', (date,))
        sales = cursor.fetchall()
        conn.close()
        return sales

    def get_sales_by_date_range(self, start_date, end_date):
        """Obtiene ventas en un rango de fechas"""
        conn = sqlite3.connect(self.db_file)
        cursor = conn.cursor()
        
        # Si son strings, usarlos directamente
        if isinstance(start_date, str) and isinstance(end_date, str):
            cursor.execute('''
            SELECT * FROM sales 
            WHERE date(timestamp) BETWEEN ? AND ? 
            ORDER BY timestamp DESC
            ''', (start_date, end_date))
        else:
            # Si son objetos datetime, convertir a string
            cursor.execute('''
            SELECT * FROM sales 
            WHERE date(timestamp) BETWEEN ? AND ? 
            ORDER BY timestamp DESC
            ''', (start_date.strftime('%Y-%m-%d'), end_date.strftime('%Y-%m-%d')))
        
        sales = cursor.fetchall()
        conn.close()
        return sales

    def close_daily_sales(self):
        """Marca todas las ventas del día como cerradas"""
        today = datetime.now().strftime('%Y-%m-%d')
        conn = sqlite3.connect(self.db_file)
        cursor = conn.cursor()
        cursor.execute('''
        UPDATE sales SET closed = 1 
        WHERE date(timestamp) = ? AND closed = 0
        ''', (today,))
        affected = cursor.rowcount
        conn.commit()
        conn.close()
        return affected

    def get_inventory_value(self):
        """Calcula el valor total del inventario"""
        conn = sqlite3.connect(self.db_file)
        cursor = conn.cursor()
        cursor.execute('''
        SELECT 
            SUM(stock * cost_price_usd) as total_cost_usd,
            SUM(stock * cost_price_ves) as total_cost_ves,
            SUM(stock * price_usd) as total_value_usd,
            SUM(stock * price_ves) as total_value_ves
        FROM products
        ''')
        result = cursor.fetchone()
        conn.close()
        
        if result[0] is None:  # No hay productos
            return {
                'total_cost_usd': 0,
                'total_cost_ves': 0,
                'total_value_usd': 0,
                'total_value_ves': 0,
                'potential_profit_usd': 0,
                'potential_profit_ves': 0
            }
            
        return {
            'total_cost_usd': result[0],
            'total_cost_ves': result[1],
            'total_value_usd': result[2],
            'total_value_ves': result[3],
            'potential_profit_usd': result[2] - result[0],
            'potential_profit_ves': result[3] - result[1]
        }

    def get_shortcuts(self):
        """Obtiene los atajos de teclado configurados"""
        conn = sqlite3.connect(self.db_file)
        cursor = conn.cursor()
        cursor.execute('SELECT action, shortcut FROM shortcuts')
        shortcuts = {row[0]: row[1] for row in cursor.fetchall()}
        conn.close()
        
        # Si faltan algunos atajos, usar los predeterminados
        for action, shortcut in DEFAULT_SHORTCUTS.items():
            if action not in shortcuts:
                shortcuts[action] = shortcut
                
        return shortcuts

    def update_shortcut(self, action, shortcut):
        """Actualiza un atajo de teclado"""
        conn = sqlite3.connect(self.db_file)
        cursor = conn.cursor()
        cursor.execute('''
        INSERT OR REPLACE INTO shortcuts (action, shortcut) VALUES (?, ?)
        ''', (action, shortcut))
        conn.commit()
        conn.close()
        return True

    def save_exchange_rate(self, rate):
        """Guarda la tasa de cambio actual"""
        conn = sqlite3.connect(self.db_file)
        cursor = conn.cursor()
        cursor.execute('''
        INSERT OR REPLACE INTO config (key, value) VALUES (?, ?)
        ''', ('exchange_rate', str(rate)))
        cursor.execute('''
        INSERT OR REPLACE INTO config (key, value) VALUES (?, ?)
        ''', ('exchange_rate_updated', datetime.now().isoformat()))
        conn.commit()
        conn.close()

    def get_exchange_rate(self):
        """Obtiene la tasa de cambio guardada"""
        conn = sqlite3.connect(self.db_file)
        cursor = conn.cursor()
        cursor.execute('SELECT value FROM config WHERE key = ?', ('exchange_rate',))
        result = cursor.fetchone()
        conn.close()
        
        if result:
            return float(result[0])
        return EXCHANGE_CONFIG['default_rate']

class ExchangeRateManager:
    def __init__(self, db_manager):
        self.db_manager = db_manager
        self.exchange_rate = self.db_manager.get_exchange_rate()
        self.last_update = datetime.now()
        self.update_timer = None
        self.update_callbacks = []

    def start_auto_update(self):
        """Inicia la actualización automática de la tasa de cambio"""
        self.update_exchange_rate()
        self.schedule_next_update()

    def schedule_next_update(self):
        """Programa la próxima actualización"""
        if self.update_timer:
            self.update_timer.cancel()
            
        self.update_timer = threading.Timer(
            EXCHANGE_CONFIG['update_interval'] / 1000,  # Convertir a segundos
            self.update_exchange_rate
        )
        self.update_timer.daemon = True
        self.update_timer.start()

    def update_exchange_rate(self):
        """Actualiza la tasa de cambio desde la API"""
        try:
            # Intentar con la API primaria
            response = requests.get(
                EXCHANGE_CONFIG['primary_api'],
                timeout=EXCHANGE_CONFIG['request_timeout']
            )
            if response.status_code == 200:
                data = response.json()
                # Verificar si la respuesta contiene la tasa BS
                if 'rates' in data and 'VES' in data['rates']:
                    self.exchange_rate = data['rates']['VES']
                    self.last_update = datetime.now()
                    self.db_manager.save_exchange_rate(self.exchange_rate)
                    self._notify_update()
                    self.schedule_next_update()
                    return
        except Exception as e:
            print(f"Error con API primaria: {e}")
            
        try:
            # Intentar con la API de respaldo
            response = requests.get(
                EXCHANGE_CONFIG['backup_api'],
                timeout=EXCHANGE_CONFIG['request_timeout']
            )
            if response.status_code == 200:
                data = response.json()
                # La estructura de la API de respaldo es diferente
                if 'bpi' in data and 'VES' in data['bpi']:
                    self.exchange_rate = data['bpi']['VES']['rate_float']
                    self.last_update = datetime.now()
                    self.db_manager.save_exchange_rate(self.exchange_rate)
                    self._notify_update()
                    print(f"Tasa de cambio actualizada (API respaldo): {self.exchange_rate} BS/USD")
                    self.schedule_next_update()
                    return
        except Exception as e:
            print(f"Error con API de respaldo: {e}")
            
        # Si ambas APIs fallan, mantener la tasa actual y programar la próxima actualización
        print("No se pudo actualizar la tasa de cambio. Manteniendo tasa actual.")
        self.schedule_next_update()

    def set_exchange_rate_manually(self, rate):
        """Establece la tasa de cambio manualmente"""
        try:
            rate = float(rate)
            if rate <= 0:
                return False
                
            self.exchange_rate = rate
            self.last_update = datetime.now()
            self.db_manager.save_exchange_rate(rate)
            self._notify_update()
            return True
        except (ValueError, TypeError):
            return False

    def get_current_rate(self):
        """Obtiene la tasa de cambio actual"""
        return self.exchange_rate

    def get_last_update_time(self):
        """Obtiene la hora de la última actualización"""
        return self.last_update

    def register_update_callback(self, callback):
        """Registra una función de callback para notificar actualizaciones"""
        if callback not in self.update_callbacks:
            self.update_callbacks.append(callback)

    def _notify_update(self):
        """Notifica a todos los callbacks registrados sobre la actualización"""
        for callback in self.update_callbacks:
            try:
                callback(self.exchange_rate)
            except Exception as e:
                print(f"Error en callback de actualización: {e}")

class QuantityDialog(QDialog):
    def __init__(self, parent=None, default_value=1.0):
        super().__init__(parent)
        self.setWindowTitle("Cantidad")
        self.setFixedSize(300, 150)
        self.setWindowFlags(self.windowFlags() & ~Qt.WindowContextHelpButtonHint)
        
        self.style_manager = StyleManager()
        self.setStyleSheet(self.style_manager.get_dialog_style())
        
        layout = QVBoxLayout()
        
        # Etiqueta
        label = QLabel("Ingrese la cantidad:")
        label.setStyleSheet(self.style_manager.get_label_style("subtitle"))
        layout.addWidget(label)
        
        # Campo de cantidad
        self.quantity_input = QDoubleSpinBox()
        self.quantity_input.setRange(0.01, 9999.99)
        self.quantity_input.setDecimals(2)
        self.quantity_input.setValue(default_value)
        self.quantity_input.setStyleSheet(self.style_manager.get_input_style())
        self.quantity_input.selectAll()
        layout.addWidget(self.quantity_input)
        
        # Botones
        button_layout = QHBoxLayout()
        
        self.cancel_button = QPushButton("Cancelar")
        self.cancel_button.setStyleSheet(self.style_manager.get_button_style("accent"))
        self.cancel_button.clicked.connect(self.reject)
        
        self.ok_button = QPushButton("Aceptar")
        self.ok_button.setStyleSheet(self.style_manager.get_button_style("success"))
        self.ok_button.clicked.connect(self.accept)
        
        button_layout.addWidget(self.cancel_button)
        button_layout.addWidget(self.ok_button)
        
        layout.addLayout(button_layout)
        self.setLayout(layout)
        
        # Establecer el foco en el campo de cantidad
        self.quantity_input.setFocus()

    def keyPressEvent(self, event):
        if event.key() == Qt.Key_Return or event.key() == Qt.Key_Enter:
            self.accept()
        elif event.key() == Qt.Key_Escape:
            self.reject()
        else:
            super().keyPressEvent(event)

    def get_quantity(self):
        return self.quantity_input.value()

