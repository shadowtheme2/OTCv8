class PaymentDialog(QDialog):
    def __init__(self, parent=None, total_usd=0, total_ves=0, exchange_rate=36.50):
        super().__init__(parent)
        self.setWindowTitle("Procesar Pago")
        self.setMinimumWidth(500)
        self.setWindowFlags(self.windowFlags() & ~Qt.WindowContextHelpButtonHint)
        
        self.style_manager = StyleManager()
        self.setStyleSheet(self.style_manager.get_dialog_style())
        
        self.total_usd = total_usd
        self.total_ves = total_ves
        self.exchange_rate = exchange_rate
        
        layout = QVBoxLayout()
        
        # Título
        title_label = QLabel("Procesar Pago")
        title_label.setStyleSheet(self.style_manager.get_label_style("title"))
        title_label.setAlignment(Qt.AlignCenter)
        layout.addWidget(title_label)
        
        # Información de totales
        totals_frame = QFrame()
        totals_frame.setStyleSheet(self.style_manager.get_frame_style("card"))
        totals_layout = QVBoxLayout(totals_frame)
        
        total_usd_label = QLabel(f"Total USD: ${total_usd:.2f}")
        total_usd_label.setStyleSheet(self.style_manager.get_label_style("subtitle"))
        total_usd_label.setAlignment(Qt.AlignCenter)
        
        total_ves_label = QLabel(f"Total BS: {total_ves:.2f}")
        total_ves_label.setStyleSheet(self.style_manager.get_label_style("subtitle"))
        total_ves_label.setAlignment(Qt.AlignCenter)
        
        exchange_label = QLabel(f"Tasa BCV: {exchange_rate:.2f} BS/USD")
        exchange_label.setStyleSheet(self.style_manager.get_label_style())
        exchange_label.setAlignment(Qt.AlignCenter)
        
        totals_layout.addWidget(total_usd_label)
        totals_layout.addWidget(total_ves_label)
        totals_layout.addWidget(exchange_label)
        
        layout.addWidget(totals_frame)
        
        # Método de pago
        payment_label = QLabel("Método de Pago:")
        payment_label.setStyleSheet(self.style_manager.get_label_style("subtitle"))
        layout.addWidget(payment_label)
        
        self.payment_method = QComboBox()
        self.payment_method.addItems(["BS", "USD", "Mixto"])
        self.payment_method.setStyleSheet(self.style_manager.get_input_style())
        self.payment_method.currentIndexChanged.connect(self.update_payment_fields)
        layout.addWidget(self.payment_method)
        
        # Campos de pago
        self.payment_fields_frame = QFrame()
        self.payment_fields_layout = QFormLayout(self.payment_fields_frame)
        
        # Campo BS
        self.ves_received_label = QLabel("Monto BS recibido:")
        self.ves_received_input = QDoubleSpinBox()
        self.ves_received_input.setRange(0, 9999999.99)
        self.ves_received_input.setDecimals(2)
        self.ves_received_input.setValue(total_ves)
        self.ves_received_input.setStyleSheet(self.style_manager.get_input_style())
        self.ves_received_input.valueChanged.connect(self.calculate_change)
        
        # Campo USD
        self.usd_received_label = QLabel("Monto USD recibido:")
        self.usd_received_input = QDoubleSpinBox()
        self.usd_received_input.setRange(0, 9999999.99)
        self.usd_received_input.setDecimals(2)
        self.usd_received_input.setValue(total_usd)
        self.usd_received_input.setStyleSheet(self.style_manager.get_input_style())
        self.usd_received_input.valueChanged.connect(self.calculate_change)
        
        # Campos de cambio
        self.ves_change_label = QLabel("Cambio BS:")
        self.ves_change_display = QLineEdit("0.00")
        self.ves_change_display.setReadOnly(True)
        self.ves_change_display.setStyleSheet(self.style_manager.get_input_style())
        
        self.usd_change_label = QLabel("Cambio USD:")
        self.usd_change_display = QLineEdit("0.00")
        self.usd_change_display.setReadOnly(True)
        self.usd_change_display.setStyleSheet(self.style_manager.get_input_style())
        
        # Agregar campos al layout según el método de pago inicial
        self.update_payment_fields(0)  # 0 = BS
        
        layout.addWidget(self.payment_fields_frame)
        
        # Botones
        button_layout = QHBoxLayout()
        
        self.cancel_button = QPushButton("Cancelar")
        self.cancel_button.setStyleSheet(self.style_manager.get_button_style("accent"))
        self.cancel_button.clicked.connect(self.reject)
        
        self.ok_button = QPushButton("Procesar Venta")
        self.ok_button.setStyleSheet(self.style_manager.get_button_style("success"))
        self.ok_button.clicked.connect(self.accept)
        
        button_layout.addWidget(self.cancel_button)
        button_layout.addWidget(self.ok_button)
        
        layout.addLayout(button_layout)
        self.setLayout(layout)
        
        # Calcular cambio inicial
        self.calculate_change()

    def update_payment_fields(self, index):
        """Actualiza los campos de pago según el método seleccionado"""
        # Limpiar layout actual
        while self.payment_fields_layout.count():
            item = self.payment_fields_layout.takeAt(0)
            if item.widget():
                item.widget().hide()
        
        method = self.payment_method.currentText()
        
        if method == "BS":
            self.payment_fields_layout.addRow(self.ves_received_label, self.ves_received_input)
            self.payment_fields_layout.addRow(self.ves_change_label, self.ves_change_display)
            self.ves_received_input.setValue(self.total_ves)
            self.ves_received_input.setFocus()
            self.ves_received_input.selectAll()
            
        elif method == "USD":
            self.payment_fields_layout.addRow(self.usd_received_label, self.usd_received_input)
            self.payment_fields_layout.addRow(self.usd_change_label, self.usd_change_display)
            self.usd_received_input.setValue(self.total_usd)
            self.usd_received_input.setFocus()
            self.usd_received_input.selectAll()
            
        elif method == "Mixto":
            self.payment_fields_layout.addRow(self.ves_received_label, self.ves_received_input)
            self.payment_fields_layout.addRow(self.usd_received_label, self.usd_received_input)
            self.payment_fields_layout.addRow(self.ves_change_label, self.ves_change_display)
            self.payment_fields_layout.addRow(self.usd_change_label, self.usd_change_display)
            
            # Valores predeterminados para pago mixto
            self.ves_received_input.setValue(0)
            self.usd_received_input.setValue(0)
            self.ves_received_input.setFocus()
            self.ves_received_input.selectAll()
        
        self.calculate_change()

    def calculate_change(self):
        """Calcula el cambio según los montos ingresados"""
        method = self.payment_method.currentText()
        
        if method == "BS":
            ves_received = self.ves_received_input.value()
            ves_change = max(0, ves_received - self.total_ves)
            self.ves_change_display.setText(f"{ves_change:.2f}")
            
            # Resetear cambio USD
            self.usd_change_display.setText("0.00")
            
        elif method == "USD":
            usd_received = self.usd_received_input.value()
            usd_change = max(0, usd_received - self.total_usd)
            self.usd_change_display.setText(f"{usd_change:.2f}")
            
            # Resetear cambio BS
            self.ves_change_display.setText("0.00")
            
        elif method == "Mixto":
            ves_received = self.ves_received_input.value()
            usd_received = self.usd_received_input.value()
            
            # Convertir todo a BS para el cálculo
            total_received_ves = ves_received + (usd_received * self.exchange_rate)
            
            if total_received_ves >= self.total_ves:
                # Si hay suficiente dinero
                change_ves = total_received_ves - self.total_ves
                
                # Priorizar cambio en BS
                self.ves_change_display.setText(f"{change_ves:.2f}")
                self.usd_change_display.setText("0.00")
            else:
                # Si no hay suficiente dinero
                self.ves_change_display.setText("0.00")
                self.usd_change_display.setText("0.00")

    def keyPressEvent(self, event):
        if event.key() == Qt.Key_Return or event.key() == Qt.Key_Enter:
            self.accept()
        elif event.key() == Qt.Key_Escape:
            self.reject()
        else:
            super().keyPressEvent(event)

    def get_payment_info(self):
        method = self.payment_method.currentText()
        
        ves_received = self.ves_received_input.value() if method in ["BS", "Mixto"] else 0
        usd_received = self.usd_received_input.value() if method in ["USD", "Mixto"] else 0
        
        ves_change = float(self.ves_change_display.text())
        usd_change = float(self.usd_change_display.text())
        
        return {
            "method": method,
            "ves_received": ves_received,
            "usd_received": usd_received,
            "ves_change": ves_change,
            "usd_change": usd_change
        }

class ShortcutDialog(QDialog):
    def __init__(self, parent=None, shortcuts=None):
        super().__init__(parent)
        self.setWindowTitle("Configurar Atajos de Teclado")
        self.setMinimumWidth(400)
        self.setWindowFlags(self.windowFlags() & ~Qt.WindowContextHelpButtonHint)
        
        self.style_manager = StyleManager()
        self.setStyleSheet(self.style_manager.get_dialog_style())
        
        self.shortcuts = shortcuts or {}
        self.shortcut_widgets = {}
        
        layout = QVBoxLayout()
        
        # Título
        title_label = QLabel("Configurar Atajos de Teclado")
        title_label.setStyleSheet(self.style_manager.get_label_style("title"))
        title_label.setAlignment(Qt.AlignCenter)
        layout.addWidget(title_label)
        
        # Instrucciones
        instructions = QLabel("Haga clic en un campo y presione la combinación de teclas deseada.")
        instructions.setStyleSheet(self.style_manager.get_label_style())
        layout.addWidget(instructions)
        
        # Formulario de atajos
        form_layout = QFormLayout()
        
        # Mapeo de nombres amigables para las acciones
        action_names = {
            "search_products": "Buscar Productos",
            "process_sale": "Procesar Venta",
            "add_product": "Agregar Producto",
            "add_stock": "Agregar Stock",
            "edit_product": "Editar Producto",
            "daily_report": "Reporte Diario",
            "sales_history": "Historial de Ventas"
        }
        
        # Crear campos para cada atajo
        for action, shortcut in self.shortcuts.items():
            if action in action_names:
                label = QLabel(action_names[action])
                label.setStyleSheet(self.style_manager.get_label_style())
                
                shortcut_edit = QKeySequenceEdit(QKeySequence(shortcut))
                shortcut_edit.setStyleSheet(self.style_manager.get_input_style())
                
                self.shortcut_widgets[action] = shortcut_edit
                form_layout.addRow(label, shortcut_edit)
        
        layout.addLayout(form_layout)
        
        # Botones
        button_layout = QHBoxLayout()
        
        self.reset_button = QPushButton("Restablecer Predeterminados")
        self.reset_button.setStyleSheet(self.style_manager.get_button_style("warning"))
        self.reset_button.clicked.connect(self.reset_to_defaults)
        
        self.cancel_button = QPushButton("Cancelar")
        self.cancel_button.setStyleSheet(self.style_manager.get_button_style("accent"))
        self.cancel_button.clicked.connect(self.reject)
        
        self.ok_button = QPushButton("Guardar")
        self.ok_button.setStyleSheet(self.style_manager.get_button_style("success"))
        self.ok_button.clicked.connect(self.accept)
        
        button_layout.addWidget(self.reset_button)
        button_layout.addWidget(self.cancel_button)
        button_layout.addWidget(self.ok_button)
        
        layout.addLayout(button_layout)
        self.setLayout(layout)

    def reset_to_defaults(self):
        """Restablece los atajos a los valores predeterminados"""
        for action, shortcut in DEFAULT_SHORTCUTS.items():
            if action in self.shortcut_widgets:
                self.shortcut_widgets[action].setKeySequence(QKeySequence(shortcut))

    def get_shortcuts(self):
        """Obtiene los atajos configurados"""
        result = {}
        for action, widget in self.shortcut_widgets.items():
            result[action] = widget.keySequence().toString()
        return result

class AboutDialog(QDialog):
    def __init__(self, parent=None):
        super().__init__(parent)
        self.setWindowTitle("Acerca de")
        self.setFixedSize(400, 300)
        self.setWindowFlags(self.windowFlags() & ~Qt.WindowContextHelpButtonHint)
        
        self.style_manager = StyleManager()
