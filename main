        self.setLayout(layout)

    def keyPressEvent(self, event):
        if event.key() == Qt.Key_Return or event.key() == Qt.Key_Enter or event.key() == Qt.Key_Escape:
            self.accept()
        else:
            super().keyPressEvent(event)

class ProductListItem(QListWidgetItem):
    def __init__(self, product, exchange_rate):
        # Extraer datos del producto
        product_id, name, price_ves, price_usd, stock, profit_percentage, cost_price_ves, cost_price_usd = product[:8]
        
        # Crear texto para mostrar en la lista
        display_text = f"{name} - ${price_usd:.2f} / Bs. {price_ves:.2f} - Stock: {stock}"
        
        super().__init__(display_text)
        
        # Guardar datos del producto como datos del item
        self.product_id = product_id
        self.name = name
        self.price_ves = price_ves
        self.price_usd = price_usd
        self.stock = stock
        self.profit_percentage = profit_percentage
        self.cost_price_ves = cost_price_ves
        self.cost_price_usd = cost_price_usd
        
        # Configurar tooltip con información detallada
        self.setToolTip(
            f"ID: {product_id}\n"
            f"Nombre: {name}\n"
            f"Precio: ${price_usd:.2f} / Bs. {price_ves:.2f}\n"
            f"Stock: {stock}\n"
            f"Ganancia: {profit_percentage}%\n"
            f"Costo: ${cost_price_usd:.2f} / Bs. {cost_price_ves:.2f}"
        )
        
        # Configurar datos para ordenamiento
        self.setData(Qt.UserRole, {
            "id": product_id,
            "name": name,
            "price_usd": price_usd,
            "price_ves": price_ves,
            "stock": stock,
            "profit_percentage": profit_percentage,
            "cost_price_usd": cost_price_usd,
            "cost_price_ves": cost_price_ves
        })

class CartItem:
    def __init__(self, product_id, name, price_usd, price_ves, quantity=1, cost_price_usd=0, cost_price_ves=0, discount=0):
        self.product_id = product_id
        self.name = name
        self.price_usd = price_usd
        self.price_ves = price_ves
        self.quantity = quantity
        self.cost_price_usd = cost_price_usd
        self.cost_price_ves = cost_price_ves
        self.discount = discount  # Porcentaje de descuento
        
    def get_subtotal_usd(self):
        """Calcula el subtotal en USD con descuento aplicado"""
        discount_factor = 1 - (self.discount / 100)
        return self.price_usd * self.quantity * discount_factor
        
    def get_subtotal_ves(self):
        """Calcula el subtotal en BS con descuento aplicado"""
        discount_factor = 1 - (self.discount / 100)
        return self.price_ves * self.quantity * discount_factor
    
    def get_cost_subtotal_usd(self):
        """Calcula el subtotal de costo en USD"""
        return self.cost_price_usd * self.quantity
        
    def get_cost_subtotal_ves(self):
        """Calcula el subtotal de costo en BS"""
        return self.cost_price_ves * self.quantity
    
    def get_profit_usd(self):
        """Calcula la ganancia en USD"""
        return self.get_subtotal_usd() - self.get_cost_subtotal_usd()
        
    def get_profit_ves(self):
        """Calcula la ganancia en BS"""
        return self.get_subtotal_ves() - self.get_cost_subtotal_ves()
    
    def get_display_text(self):
        """Texto para mostrar en la lista del carrito"""
        discount_text = f" (-{self.discount}%)" if self.discount > 0 else ""
        return f"{self.name} x {self.quantity} = ${self.get_subtotal_usd():.2f} / Bs. {self.get_subtotal_ves():.2f}{discount_text}"

