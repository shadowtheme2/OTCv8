    "primary_api": "https://api.exchangerate-api.com/v4/latest/USD",
    "backup_api": "https://api.coindesk.com/v1/bpi/currentprice/VES.json",
    "default_rate": 36.50,
    "request_timeout": 10,
    "update_interval": 300000  # 5 minutos
}

