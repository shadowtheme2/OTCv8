    def load_products(self):
        """Carga todos los productos en la lista"""
        self.products_list.clear()
        products = self.db_manager.get_all_products()
        
        for product in products:
            item = ProductListItem(product, self.exchange_rate_manager.get_current_rate())
            self.products_list.addItem(item)
            
        # Mostrar mensaje si no hay productos
        if not products:
            self.products_list.addItem("No hay productos disponibles")

    def search_products(self, search_term):
        """Busca productos según el término ingresado"""
        self.products_list.clear()
        
        if not search_term:
            self.load_products()
            return
            
        products = self.db_manager.search_products(search_term)
        
        for product in products:
            item = ProductListItem(product, self.exchange_rate_manager.get_current_rate())
            self.products_list.addItem(item)
            
        # Mostrar mensaje si no hay resultados
        if not products:
            self.products_list.addItem(f"No se encontraron productos para: {search_term}")

    def add_to_cart(self):
        """Agrega el producto seleccionado al carrito"""
        selected_items = self.products_list.selectedItems()
        
        if not selected_items:
            QMessageBox.warning(self, "Advertencia", "Por favor, seleccione un producto para agregar al carrito.")
            return
            
        selected_item = selected_items[0]
        
        # Verificar si es un mensaje y no un producto real
        if not hasattr(selected_item, 'product_id'):
            return
            
        # Verificar stock
        if selected_item.stock <= 0:
            QMessageBox.warning(self, "Sin Stock", f"El producto '{selected_item.name}' no tiene stock disponible.")
            return
            
        # Mostrar diálogo para ingresar cantidad
        quantity_dialog = QuantityDialog(self, default_value=1.0)
        if quantity_dialog.exec_() == QDialog.Accepted:
            quantity = quantity_dialog.get_quantity()
            
            # Verificar que la cantidad no exceda el stock
            if quantity > selected_item.stock:
                QMessageBox.warning(
                    self, 
                    "Stock Insuficiente", 
                    f"La cantidad solicitada ({quantity}) excede el stock disponible ({selected_item.stock})."
                )
                return
                
            # Verificar si el producto ya está en el carrito
            for i, item in enumerate(self.cart):
                if item.product_id == selected_item.product_id:
                    # Actualizar cantidad si ya existe
                    new_quantity = item.quantity + quantity
                    if new_quantity > selected_item.stock:
                        QMessageBox.warning(
                            self, 
                            "Stock Insuficiente", 
                            f"La cantidad total ({new_quantity}) excede el stock disponible ({selected_item.stock})."
                        )
                        return
                        
                    item.quantity = new_quantity
                    self.update_cart_display()
                    self.update_totals()
                    return
                    
            # Agregar nuevo item al carrito
            cart_item = CartItem(
                selected_item.product_id,
                selected_item.name,
                selected_item.price_usd,
                selected_item.price_ves,
                quantity,
                selected_item.cost_price_usd,
                selected_item.cost_price_ves
            )
            
            self.cart.append(cart_item)
            self.update_cart_display()
            self.update_totals()

    def remove_from_cart(self):
        """Elimina el item seleccionado del carrito"""
        selected_index = self.cart_list.currentRow()
        
        if selected_index >= 0 and selected_index < len(self.cart):
            del self.cart[selected_index]
            self.update_cart_display()
            self.update_totals()

    def apply_discount(self):
        """Aplica un descuento al item seleccionado del carrito"""
        selected_index = self.cart_list.currentRow()
        
        if selected_index < 0 or selected_index >= len(self.cart):
            QMessageBox.warning(self, "Advertencia", "Por favor, seleccione un item del carrito para aplicar descuento.")
            return
            
        cart_item = self.cart[selected_index]
        
        # Mostrar diálogo para ingresar descuento
        discount_dialog = DiscountDialog(self, default_value=cart_item.discount)
        if discount_dialog.exec_() == QDialog.Accepted:
            discount = discount_dialog.get_discount()
            cart_item.discount = discount
            self.update_cart_display()
            self.update_totals()

    def clear_cart(self):
        """Vacía el carrito"""
        if not self.cart:
            return
            
        confirm = QMessageBox.question(
            self,
            "Confirmar",
            "¿Está seguro de vaciar el carrito?",
            QMessageBox.Yes | QMessageBox.No,
            QMessageBox.No
        )
        
        if confirm == QMessageBox.Yes:
            self.cart = []
            self.update_cart_display()
            self.update_totals()

    def update_cart_display(self):
        """Actualiza la visualización del carrito"""
        self.cart_list.clear()
        
        for item in self.cart:
            self.cart_list.addItem(item.get_display_text())

    def update_totals(self):
        """Actualiza los totales del carrito"""
        total_usd = sum(item.get_subtotal_usd() for item in self.cart)
        total_ves = sum(item.get_subtotal_ves() for item in self.cart)
        
        self.total_usd_label.setText(f"Total USD: ${total_usd:.2f}")
        self.total_ves_label.setText(f"Total BS: {total_ves:.2f}")

    def process_sale(self):
        """Procesa la venta actual"""
        if not self.cart:
            QMessageBox.warning(self, "Carrito Vacío", "No hay productos en el carrito para procesar la venta.")
            return
            
        # Calcular totales
        total_usd = sum(item.get_subtotal_usd() for item in self.cart)
        total_ves = sum(item.get_subtotal_ves() for item in self.cart)
        
        # Mostrar diálogo de pago
        payment_dialog = PaymentDialog(
            self,
            total_usd=total_usd,
            total_ves=total_ves,
            exchange_rate=self.exchange_rate_manager.get_current_rate()
        )
        
        if payment_dialog.exec_() == QDialog.Accepted:
            payment_info = payment_dialog.get_payment_info()
            
            # Crear la venta en la base de datos
            sale_id = self.db_manager.create_sale(
                total_usd=total_usd,
                total_ves=total_ves,
                payment_method=payment_info["method"],
                exchange_rate=self.exchange_rate_manager.get_current_rate(),
                usd_received=payment_info["usd_received"],
                ves_received=payment_info["ves_received"],
                usd_change=payment_info["usd_change"],
                ves_change=payment_info["ves_change"]
            )
            
            if not sale_id:
                QMessageBox.critical(self, "Error", "No se pudo crear la venta. Intente nuevamente.")
                return
                
            # Agregar items a la venta y actualizar stock
            for item in self.cart:
                self.db_manager.add_sale_item(
                    sale_id=sale_id,
                    product_id=item.product_id,
                    product_name=item.name,
                    quantity=item.quantity,
                    price_usd=item.price_usd,
                    price_ves=item.price_ves,
                    cost_price_usd=item.cost_price_usd,
                    cost_price_ves=item.cost_price_ves,
                    discount_percentage=item.discount
                )
                
                # Reducir stock
                self.db_manager.reduce_stock(item.product_id, item.quantity)
            
            # Generar e imprimir ticket
            self.print_receipt(sale_id)
            
            # Limpiar carrito y recargar productos
            self.cart = []
            self.update_cart_display()
            self.update_totals()
            self.load_products()
            
            QMessageBox.information(self, "Venta Exitosa", "La venta se ha procesado correctamente.")

    def print_receipt(self, sale_id):
        """Genera e imprime el ticket de venta en formato TXT"""
        try:
            # Obtener datos de la venta
            sale = self.db_manager.get_sale(sale_id)
            if not sale:
                return
                
            # Extraer datos
            sale_id, timestamp, total_usd, total_ves, payment_method, usd_received, ves_received, usd_change, ves_change, exchange_rate = sale[:10]
            
            # Convertir timestamp a datetime
            sale_date = datetime.fromisoformat(timestamp)
            
            # Obtener items de la venta
            items = self.db_manager.get_sale_items(sale_id)
            
            # Crear archivo TXT
            filename = f"tickets/ticket_{sale_id}.txt"
            os.makedirs("tickets", exist_ok=True)
            
            # Obtener ruta absoluta del archivo
            abs_filename = os.path.abspath(filename)
            
            # Generar contenido del ticket
            ticket_content = self.generate_ticket_content(sale_date, sale_id, items, total_usd, total_ves, payment_method, usd_received, ves_received, usd_change, ves_change, exchange_rate)
            
            # Escribir archivo
            with open(abs_filename, 'w', encoding='utf-8') as f:
                f.write(ticket_content)
            
            # Mostrar el ticket en el programa
            self.show_ticket_dialog(ticket_content, abs_filename)
                    
        except Exception as e:
            QMessageBox.critical(
                self, 
                "Error", 
                f"Error generando ticket: {str(e)}\n\n"
                f"Por favor, verifique que tenga permisos de escritura "
                f"en la carpeta 'tickets'."
            )
            print(f"Error generando ticket: {e}")

    def generate_ticket_content(self, sale_date, sale_id, items, total_usd, total_ves, payment_method, usd_received, ves_received, usd_change, ves_change, exchange_rate):
        """Genera el contenido del ticket en formato texto"""
        lines = []
        
        # Encabezado
        lines.append("=" * 48)
        lines.append("           TICKET DE VENTA")
        lines.append("=" * 48)
        lines.append(f"Fecha: {sale_date.strftime('%d/%m/%Y %H:%M:%S')}")
        lines.append(f"Ticket #: {sale_id[:8]}")
        lines.append(f"Tasa de cambio Oficial: {exchange_rate:.2f} BS/USD")
        lines.append("-" * 48)
        
        # Encabezados de columnas
        lines.append(f"{'PRODUCTO':<25} {'CANT':<6} {'PRECIO':<15}")
        lines.append("-" * 48)
        
        # Items
        for item in items:
            # Extraer datos del item
            _, _, _, product_name, quantity, _, price_ves, _, _, discount, _, subtotal_ves = item
            
            # Ajustar nombre si es muy largo
            display_name = product_name
            if len(product_name) > 24:
                display_name = product_name[:21] + "..."
            
            # Línea del producto
            lines.append(f"{display_name:<25} {quantity:<6} Bs. {subtotal_ves:>10.2f}")
            
            # Mostrar descuento si aplica
            if discount > 0:
                lines.append(f"{'':>25} {'':>6} (-{discount}%)")
        
        lines.append("-" * 48)
        
        # Totales
        lines.append(f"{'TOTAL:':<32} Bs. {total_ves:>10.2f}")
        lines.append("=" * 48)
        lines.append("         ¡Gracias por su compra!")
        lines.append("=" * 48)
        
        return "\n".join(lines)

    def show_ticket_dialog(self, ticket_content, filename):
        """Muestra el ticket en un diálogo dentro del programa"""
        dialog = QDialog(self)
        dialog.setWindowTitle("Ticket de Venta")
        dialog.setMinimumSize(500, 600)
        dialog.setStyleSheet(self.style_manager.get_dialog_style())
        
        layout = QVBoxLayout()
        
        # Título
        title = QLabel("Ticket Generado")
        title.setStyleSheet(self.style_manager.get_label_style("title"))
        title.setAlignment(Qt.AlignCenter)
        layout.addWidget(title)
        
        # Área de texto para mostrar el ticket
        ticket_text = QTextEdit()
        ticket_text.setPlainText(ticket_content)
        ticket_text.setReadOnly(True)
        ticket_text.setFont(QFont("Courier", 10))  # Fuente monoespaciada para mejor alineación
        ticket_text.setStyleSheet("""
            QTextEdit {
                background-color: white;
                color: black;
                border: 2px solid #ddd;
                border-radius: 5px;
                padding: 10px;
                font-family: 'Courier New', monospace;
            }
        """)
        layout.addWidget(ticket_text)
        
        # Información del archivo
        file_info = QLabel(f"Guardado en: {filename}")
        file_info.setStyleSheet(self.style_manager.get_label_style())
        file_info.setWordWrap(True)
        layout.addWidget(file_info)
        
        # Botones
        button_layout = QHBoxLayout()
        
        # Botón para abrir archivo
        open_file_button = QPushButton("Abrir Archivo")
        open_file_button.setStyleSheet(self.style_manager.get_button_style())
        open_file_button.clicked.connect(lambda: self.open_text_file(filename))
        
        # Botón para abrir carpeta
        open_folder_button = QPushButton("Abrir Carpeta")
        open_folder_button.setStyleSheet(self.style_manager.get_button_style())
        open_folder_button.clicked.connect(lambda: self.open_folder(filename))
        
        # Botón para imprimir
        print_button = QPushButton("Imprimir")
        print_button.setStyleSheet(self.style_manager.get_button_style("primary"))
        print_button.clicked.connect(lambda: self.print_text_ticket(ticket_content))
        
        # Botón para cerrar
        close_button = QPushButton("Cerrar")
        close_button.setStyleSheet(self.style_manager.get_button_style("accent"))
        close_button.clicked.connect(dialog.accept)
        
        button_layout.addWidget(open_file_button)
        button_layout.addWidget(open_folder_button)
        button_layout.addWidget(print_button)
        button_layout.addWidget(close_button)
        
        layout.addLayout(button_layout)
        dialog.setLayout(layout)
        
        # Mostrar el diálogo
        dialog.exec_()

    def open_text_file(self, filename):
        """Abre el archivo de texto con el editor predeterminado"""
        try:
            if sys.platform.startswith('win'):   # Windows
                os.startfile(filename)
            elif sys.platform.startswith('darwin'):  # macOS
                subprocess.run(['open', filename])
            else:  # Linux
                subprocess.run(['xdg-open', filename])
        except Exception as e:
            QMessageBox.warning(
                self, 
                "Error", 
                f"No se pudo abrir el archivo: {str(e)}\n\n"
                f"Ubicación: {filename}"
            )

    def open_folder(self, filename):
        """Abre la carpeta que contiene el archivo"""
        try:
            folder_path = os.path.dirname(filename)
            if sys.platform.startswith('win'):
                subprocess.run(['explorer', folder_path])
            elif sys.platform.startswith('darwin'):
                subprocess.run(['open', folder_path])
            else:
                subprocess.run(['xdg-open', folder_path])
        except Exception as e:
            QMessageBox.warning(
                self, 
                "Error", 
                f"No se pudo abrir la carpeta: {str(e)}"
            )

    def print_text_ticket(self, ticket_content):
        """Imprime el ticket usando el diálogo de impresión del sistema"""
        try:
            from PyQt5.QtPrintSupport import QPrinter, QPrintDialog
            from PyQt5.QtGui import QTextDocument
            
            # Crear documento de texto
            document = QTextDocument()
            document.setPlainText(ticket_content)
            
            # Configurar impresora
            printer = QPrinter()
            printer.setPageSize(QPrinter.A4)
            
            # Mostrar diálogo de impresión
            print_dialog = QPrintDialog(printer, self)
            if print_dialog.exec_() == QPrintDialog.Accepted:
                document.print_(printer)
                QMessageBox.information(self, "Impresión", "El ticket se ha enviado a la impresora.")
                
        except ImportError:
            QMessageBox.warning(
                self, 
                "Función no disponible", 
                "La función de impresión no está disponible.\n"
                "Por favor, abra el archivo y use Ctrl+P para imprimir."
            )
        except Exception as e:
            QMessageBox.warning(
                self, 
                "Error de Impresión", 
                f"Error al imprimir: {str(e)}\n\n"
                "Por favor, abra el archivo y use Ctrl+P para imprimir."
            )


    def add_product(self):
        """Muestra el diálogo para agregar un nuevo producto"""
        dialog = QDialog(self)
        dialog.setWindowTitle("Agregar Nuevo Producto")
        dialog.setMinimumWidth(400)
        dialog.setStyleSheet(self.style_manager.get_dialog_style())
        
        layout = QVBoxLayout()
        
        # Título
        title = QLabel("Agregar Nuevo Producto")
        title.setStyleSheet(self.style_manager.get_label_style("title"))
        title.setAlignment(Qt.AlignCenter)
        layout.addWidget(title)
        
        # Formulario
        form_layout = QFormLayout()
        
        # Campos
        name_input = QLineEdit()
        name_input.setStyleSheet(self.style_manager.get_input_style())
        name_input.setPlaceholderText("Nombre del producto")
        
        cost_price_input = QDoubleSpinBox()
        cost_price_input.setRange(0.01, 999999.99)
        cost_price_input.setDecimals(2)
        cost_price_input.setValue(1.00)
        cost_price_input.setStyleSheet(self.style_manager.get_input_style())
        
        profit_input = QDoubleSpinBox()
        profit_input.setRange(0, 1000)
        profit_input.setDecimals(2)
        profit_input.setValue(30.00)
        profit_input.setSuffix("%")
        profit_input.setStyleSheet(self.style_manager.get_input_style())
        
        stock_input = QSpinBox()
        stock_input.setRange(0, 9999)
        stock_input.setValue(1)
        stock_input.setStyleSheet(self.style_manager.get_input_style())
        
        # Agregar campos al formulario
        form_layout.addRow("Nombre:", name_input)
        form_layout.addRow("Precio de Costo (BS):", cost_price_input)
        form_layout.addRow("Porcentaje de Ganancia:", profit_input)
        form_layout.addRow("Stock Inicial:", stock_input)
        
        layout.addLayout(form_layout)
        
        # Botones
        button_layout = QHBoxLayout()
        
        cancel_button = QPushButton("Cancelar")
        cancel_button.setStyleSheet(self.style_manager.get_button_style("accent"))
        cancel_button.clicked.connect(dialog.reject)
        
        save_button = QPushButton("Guardar")
        save_button.setStyleSheet(self.style_manager.get_button_style("success"))
        save_button.clicked.connect(dialog.accept)
        
        button_layout.addWidget(cancel_button)
        button_layout.addWidget(save_button)
        
        layout.addLayout(button_layout)
        dialog.setLayout(layout)
        
        # Ejecutar diálogo
        if dialog.exec_() == QDialog.Accepted:
            name = name_input.text().strip()
            cost_price = cost_price_input.value()
            profit = profit_input.value()
            stock = stock_input.value()
            
            if not name:
                QMessageBox.warning(self, "Error", "El nombre del producto es obligatorio.")
                return
                
            # Agregar producto a la base de datos
            success = self.db_manager.add_product(
                name=name,
                price_ves=0,  # Se calcula automáticamente
                stock=stock,
                profit_percentage=profit,
                cost_price_ves=cost_price,
                exchange_rate=self.exchange_rate_manager.get_current_rate()
            )
            
            if success:
                QMessageBox.information(self, "Éxito", f"Producto '{name}' agregado correctamente.")
                self.load_products()
            else:
                QMessageBox.critical(self, "Error", "No se pudo agregar el producto. Intente nuevamente.")

    def edit_product(self):
        """Edita el producto seleccionado"""
        selected_items = self.products_list.selectedItems()
        
        if not selected_items:
            QMessageBox.warning(self, "Advertencia", "Por favor, seleccione un producto para editar.")
            return
            
        selected_item = selected_items[0]
        
        # Verificar si es un mensaje y no un producto real
        if not hasattr(selected_item, 'product_id'):
            return
            
        # Obtener datos actuales del producto
        product = self.db_manager.get_product_by_id(selected_item.product_id)
        if not product:
            QMessageBox.warning(self, "Error", "No se pudo obtener la información del producto.")
            return
            
        # Extraer datos
        product_id, name, price_ves, price_usd, stock, profit_percentage, cost_price_ves, cost_price_usd = product[:8]
        
        # Crear diálogo de edición
        dialog = QDialog(self)
        dialog.setWindowTitle("Editar Producto")
        dialog.setMinimumWidth(400)
        dialog.setStyleSheet(self.style_manager.get_dialog_style())
        
        layout = QVBoxLayout()
        
        # Título
        title = QLabel(f"Editar Producto: {name}")
        title.setStyleSheet(self.style_manager.get_label_style("title"))
        title.setAlignment(Qt.AlignCenter)
        layout.addWidget(title)
        
        # Formulario
        form_layout = QFormLayout()
        
        # Campos
        name_input = QLineEdit(name)
        name_input.setStyleSheet(self.style_manager.get_input_style())
        
        cost_price_input = QDoubleSpinBox()
        cost_price_input.setRange(0.01, 999999.99)
        cost_price_input.setDecimals(2)
        cost_price_input.setValue(cost_price_ves)
        cost_price_input.setStyleSheet(self.style_manager.get_input_style())
        
        profit_input = QDoubleSpinBox()
        profit_input.setRange(0, 1000)
        profit_input.setDecimals(2)
        profit_input.setValue(profit_percentage)
        profit_input.setSuffix("%")
        profit_input.setStyleSheet(self.style_manager.get_input_style())
        
        stock_input = QSpinBox()
        stock_input.setRange(0, 9999)
        stock_input.setValue(int(stock))
        stock_input.setStyleSheet(self.style_manager.get_input_style())
        
        # Agregar campos al formulario
        form_layout.addRow("Nombre:", name_input)
        form_layout.addRow("Precio de Costo (BS):", cost_price_input)
        form_layout.addRow("Porcentaje de Ganancia:", profit_input)
        form_layout.addRow("Stock:", stock_input)
        
        layout.addLayout(form_layout)
        
        # Botones
        button_layout = QHBoxLayout()
        
        cancel_button = QPushButton("Cancelar")
        cancel_button.setStyleSheet(self.style_manager.get_button_style("accent"))
        cancel_button.clicked.connect(dialog.reject)
        
        save_button = QPushButton("Guardar")
        save_button.setStyleSheet(self.style_manager.get_button_style("success"))
        save_button.clicked.connect(dialog.accept)
        
        button_layout.addWidget(cancel_button)
        button_layout.addWidget(save_button)
        
        layout.addLayout(button_layout)
        dialog.setLayout(layout)
        
        # Ejecutar diálogo
        if dialog.exec_() == QDialog.Accepted:
            new_name = name_input.text().strip()
            new_cost_price = cost_price_input.value()
            new_profit = profit_input.value()
            new_stock = stock_input.value()
            
            if not new_name:
                QMessageBox.warning(self, "Error", "El nombre del producto es obligatorio.")
                return
                
            # Actualizar producto en la base de datos
            success = self.db_manager.update_product(
                product_id=product_id,
                name=new_name,
                price_ves=0,  # Se calcula automáticamente
                stock=new_stock,
                profit_percentage=new_profit,
                cost_price_ves=new_cost_price,
                exchange_rate=self.exchange_rate_manager.get_current_rate()
            )
            
            if success:
                QMessageBox.information(self, "Éxito", f"Producto '{new_name}' actualizado correctamente.")
                self.load_products()
            else:
                QMessageBox.critical(self, "Error", "No se pudo actualizar el producto. Intente nuevamente.")

    def add_stock(self):
        """Agrega stock al producto seleccionado"""
        selected_items = self.products_list.selectedItems()
        
        if not selected_items:
            QMessageBox.warning(self, "Advertencia", "Por favor, seleccione un producto para agregar stock.")
            return
            
        selected_item = selected_items[0]
        
        # Verificar si es un mensaje y no un producto real
        if not hasattr(selected_item, 'product_id'):
            return
            
        # Mostrar diálogo para ingresar cantidad
        quantity_dialog = QuantityDialog(self, default_value=1.0)
        if quantity_dialog.exec_() == QDialog.Accepted:
            quantity = quantity_dialog.get_quantity()
            
            # Agregar stock en la base de datos
            success = self.db_manager.add_stock(selected_item.product_id, quantity)
            
            if success:
                QMessageBox.information(
                    self, 
                    "Éxito", 
                    f"Se agregaron {quantity} unidades al stock de '{selected_item.name}'."
                )
                self.load_products()
            else:
                QMessageBox.critical(self, "Error", "No se pudo agregar stock. Intente nuevamente.")

    def show_exchange_rate_dialog(self):
        """Muestra el diálogo para configurar la tasa de cambio"""
        dialog = ExchangeRateDialog(self, current_rate=self.exchange_rate_manager.get_current_rate())
        
        if dialog.exec_() == QDialog.Accepted:
            if dialog.api_update_requested:
                # Actualizar desde API
                self.exchange_rate_manager.update_exchange_rate()
            else:
                # Actualizar manualmente
                new_rate = dialog.get_exchange_rate()
                if self.exchange_rate_manager.set_exchange_rate_manually(new_rate):
                    QMessageBox.information(
                        self, 
                        "Tasa Actualizada", 
                        f"La tasa de cambio se ha actualizado a {new_rate:.2f} BS/USD."
                    )
                    self.load_products()  # Recargar productos con la nueva tasa
                else:
                    QMessageBox.critical(self, "Error", "No se pudo actualizar la tasa de cambio.")

    def update_exchange_rate_display(self, rate):
        """Actualiza la visualización de la tasa de cambio"""
        self.exchange_rate_label.setText(f"Tasa BCV: {rate:.2f} BS/USD")
        # Recargar productos para actualizar precios
        self.load_products()

    def show_shortcuts_dialog(self):
        """Muestra el diálogo para configurar atajos de teclado"""
        dialog = ShortcutDialog(self, shortcuts=self.shortcuts)
        
        if dialog.exec_() == QDialog.Accepted:
            new_shortcuts = dialog.get_shortcuts()
            
            # Guardar nuevos atajos
            for action, shortcut in new_shortcuts.items():
                self.db_manager.update_shortcut(action, shortcut)
            
            # Recargar atajos
            self.load_shortcuts()
            
            QMessageBox.information(self, "Atajos Actualizados", "Los atajos de teclado se han actualizado correctamente.")

    def show_about_dialog(self):
        """Muestra el diálogo de acerca de"""
        dialog = AboutDialog(self)
        dialog.exec_()

    def generate_daily_report(self):
        """Genera un reporte de ventas del día"""
        # Obtener ventas del día
        sales = self.db_manager.get_daily_sales()
        
        if not sales:
            QMessageBox.information(self, "Sin Ventas", "No hay ventas registradas para el día de hoy.")
            return
            
        # Calcular totales
        total_usd = sum(sale[2] for sale in sales)  # Índice 2 = total_usd
        total_ves = sum(sale[3] for sale in sales)  # Índice 3 = total_ves
        
        # Crear PDF con ruta absoluta
        reports_dir = os.path.join(os.getcwd(), "reportes")
        os.makedirs(reports_dir, exist_ok=True)
        filename = os.path.join(reports_dir, f"reporte_diario_{datetime.now().strftime('%Y%m%d')}.pdf")
        
        # Configurar canvas
        c = canvas.Canvas(filename, pagesize=letter)
        c.setFont("Helvetica-Bold", 16)
        
        # Encabezado
        c.drawCentredString(300, 750, "POS VENEZUELA")
        c.setFont("Helvetica-Bold", 14)
        c.drawCentredString(300, 730, "REPORTE DIARIO DE VENTAS")
        c.setFont("Helvetica", 12)
        c.drawCentredString(300, 710, f"Fecha: {datetime.now().strftime('%d/%m/%Y')}")
        
        # Línea divisoria
        c.line(50, 700, 550, 700)
        
        # Tabla de ventas
        c.setFont("Helvetica-Bold", 12)
        c.drawString(50, 680, "ID")
        c.drawString(150, 680, "Hora")
        c.drawString(250, 680, "Método")
        c.drawString(350, 680, "Total USD")
        c.drawString(450, 680, "Total BS")
        
        c.line(50, 670, 550, 670)
        
        # Datos de ventas
        y = 650
        c.setFont("Helvetica", 10)
        
        for sale in sales:
            sale_id, timestamp, total_usd, total_ves, payment_method = sale[:5]
            
            # Convertir timestamp a datetime
            sale_time = datetime.fromisoformat(timestamp).strftime('%H:%M:%S')
            
            c.drawString(50, y, sale_id[:8])
            c.drawString(150, y, sale_time)
            c.drawString(250, y, payment_method)
            c.drawString(350, y, f"${total_usd:.2f}")
            c.drawString(450, y, f"Bs. {total_ves:.2f}")
            
            y -= 20
            
            # Si se acerca al final de la página, crear nueva página
            if y < 100:
                c.showPage()
                c.setFont("Helvetica-Bold", 14)
                c.drawCentredString(300, 750, "REPORTE DIARIO DE VENTAS (Continuación)")
                c.setFont("Helvetica-Bold", 12)
                c.drawString(50, 730, "ID")
                c.drawString(150, 730, "Hora")
                c.drawString(250, 730, "Método")
                c.drawString(350, 730, "Total USD")
                c.drawString(450, 730, "Total BS")
                c.line(50, 720, 550, 720)
                c.setFont("Helvetica", 10)
                y = 700
        
        # Línea divisoria
        c.line(50, y, 550, y)
        y -= 30
        
        # Totales
        c.setFont("Helvetica-Bold", 12)
        c.drawString(250, y, "TOTAL:")
        c.drawString(350, y, f"${total_usd:.2f}")
        c.drawString(450, y, f"Bs. {total_ves:.2f}")
        
        # Guardar PDF
        c.save()
        
        # Abrir el PDF con ruta absoluta
        try:
            if sys.platform.startswith('darwin'):  # macOS
                subprocess.call(('open', filename))
            elif sys.platform.startswith('win'):   # Windows
                os.startfile(filename)
            else:  # Linux
                subprocess.call(('xdg-open', filename))
        except Exception as e:
            print(f"Error abriendo archivo: {e}")
            QMessageBox.information(self, "Reporte Generado", f"El reporte se ha generado correctamente pero no se pudo abrir automáticamente.\nArchivo: {filename}")
            return
            
        QMessageBox.information(self, "Reporte Generado", f"El reporte diario se ha generado correctamente.\nArchivo: {filename}")

    def generate_inventory_report(self):
        """Genera un reporte de inventario"""
        # Obtener productos
        products = self.db_manager.get_all_products()
        
        if not products:
            QMessageBox.information(self, "Sin Productos", "No hay productos en el inventario.")
            return
            
        # Crear PDF con ruta absoluta
        reports_dir = os.path.join(os.getcwd(), "reportes")
        os.makedirs(reports_dir, exist_ok=True)
        filename = os.path.join(reports_dir, f"inventario_{datetime.now().strftime('%Y%m%d')}.pdf")
        
        # Configurar canvas
        c = canvas.Canvas(filename, pagesize=letter)
        c.setFont("Helvetica-Bold", 16)
        
        # Encabezado
        c.drawCentredString(300, 750, "POS VENEZUELA")
        c.setFont("Helvetica-Bold", 14)
        c.drawCentredString(300, 730, "REPORTE DE INVENTARIO")
        c.setFont("Helvetica", 12)
        c.drawCentredString(300, 710, f"Fecha: {datetime.now().strftime('%d/%m/%Y')}")
        
        # Línea divisoria
        c.line(50, 700, 550, 700)
        
        # Tabla de productos
        c.setFont("Helvetica-Bold", 10)
        c.drawString(50, 680, "ID")
        c.drawString(100, 680, "Nombre")
        c.drawString(300, 680, "Precio USD")
        c.drawString(370, 680, "Precio BS")
        c.drawString(450, 680, "Stock")
        c.drawString(500, 680, "Valor USD")
        
        c.line(50, 670, 550, 670)
        
        # Datos de productos
        y = 650
        c.setFont("Helvetica", 8)
        
        total_inventory_value = 0
        
        for product in products:
            product_id, name, price_ves, price_usd, stock = product[:5]
            
            # Calcular valor del inventario
            inventory_value = price_usd * stock
            total_inventory_value += inventory_value
            
            # Ajustar nombre si es muy largo
            display_name = name
            if len(name) > 35:
                display_name = name[:32] + "..."
            
            c.drawString(50, y, str(product_id))
            c.drawString(100, y, display_name)
            c.drawString(300, y, f"${price_usd:.2f}")
            c.drawString(370, y, f"Bs. {price_ves:.2f}")
            c.drawString(450, y, str(stock))
            c.drawString(500, y, f"${inventory_value:.2f}")
            
            y -= 15
            
            # Si se acerca al final de la página, crear nueva página
            if y < 100:
                c.showPage()
                c.setFont("Helvetica-Bold", 14)
                c.drawCentredString(300, 750, "REPORTE DE INVENTARIO (Continuación)")
                c.setFont("Helvetica-Bold", 10)
                c.drawString(50, 730, "ID")
                c.drawString(100, 730, "Nombre")
                c.drawString(300, 730, "Precio USD")
                c.drawString(370, 730, "Precio BS")
                c.drawString(450, 730, "Stock")
                c.drawString(500, 730, "Valor USD")
                c.line(50, 720, 550, 720)
                c.setFont("Helvetica", 8)
                y = 700
        
        # Línea divisoria
        c.line(50, y, 550, y)
        y -= 30
        
        # Total
        c.setFont("Helvetica-Bold", 12)
        c.drawString(300, y, "VALOR TOTAL DEL INVENTARIO:")
        c.drawString(500, y, f"${total_inventory_value:.2f}")
        
        # Guardar PDF
        c.save()
        
        # Abrir el PDF con ruta absoluta
        try:
            if sys.platform.startswith('darwin'):  # macOS
                subprocess.call(('open', filename))
            elif sys.platform.startswith('win'):   # Windows
                os.startfile(filename)
            else:  # Linux
                subprocess.call(('xdg-open', filename))
        except Exception as e:
            print(f"Error abriendo archivo: {e}")
            QMessageBox.information(self, "Reporte Generado", f"El reporte se ha generado correctamente pero no se pudo abrir automáticamente.\nArchivo: {filename}")
            return
            
        QMessageBox.information(self, "Reporte Generado", f"El reporte de inventario se ha generado correctamente.\nArchivo: {filename}")

    def show_sales_history(self):
        """Muestra el historial de ventas"""
        dialog = QDialog(self)
        dialog.setWindowTitle("Historial de Ventas")
        
        # Ajustar tamaño para pantalla 720p (1280x720)
        dialog.setMinimumSize(950, 610)
        dialog.resize(950, 610)
        dialog.setStyleSheet(self.style_manager.get_dialog_style())
        
        layout = QVBoxLayout()
        
        # Título
        title = QLabel("Historial de Ventas")
        title.setStyleSheet(self.style_manager.get_label_style("title"))
        title.setAlignment(Qt.AlignCenter)
        layout.addWidget(title)
        
        # Filtros
        filter_frame = QFrame()
        filter_frame.setStyleSheet(self.style_manager.get_frame_style("section"))
        filter_layout = QHBoxLayout(filter_frame)
        
        # Fecha desde
        from_date_label = QLabel("Desde:")
        from_date_label.setStyleSheet(self.style_manager.get_label_style())
        
        self.from_date = QDateEdit()
        self.from_date.setDate(QDate.currentDate().addDays(-7))
        self.from_date.setCalendarPopup(True)
        self.from_date.setStyleSheet(self.style_manager.get_input_style())
        
        # Fecha hasta
        to_date_label = QLabel("Hasta:")
        to_date_label.setStyleSheet(self.style_manager.get_label_style())
        
        self.to_date = QDateEdit()
        self.to_date.setDate(QDate.currentDate())
        self.to_date.setCalendarPopup(True)
        self.to_date.setStyleSheet(self.style_manager.get_input_style())
        
        # Botón de filtrar
        filter_button = QPushButton("Filtrar")
        filter_button.setStyleSheet(self.style_manager.get_button_style("primary"))
        filter_button.clicked.connect(lambda: self.load_sales_history(dialog))
        
        filter_layout.addWidget(from_date_label)
        filter_layout.addWidget(self.from_date)
        filter_layout.addWidget(to_date_label)
        filter_layout.addWidget(self.to_date)
        filter_layout.addWidget(filter_button)
        
        layout.addWidget(filter_frame)
        
        # Tabla de ventas - Optimizada para 720p
        self.sales_table = QTableWidget()
        self.sales_table.setStyleSheet(self.style_manager.get_table_style())
        
        # Establecer tamaño mínimo para la tabla
        self.sales_table.setMinimumSize(900, 400)
        
        self.sales_table.setColumnCount(6)
        self.sales_table.setHorizontalHeaderLabels(["ID", "Fecha", "Método", "Total USD", "Total BS", " ------------ ⚙️ Acciones ------------ "])
        
        # Configurar anchos de columnas específicos para 720p
        header = self.sales_table.horizontalHeader()
        header.setSectionResizeMode(0, QHeaderView.Fixed)  # ID
        header.setSectionResizeMode(1, QHeaderView.Stretch)  # Fecha
        header.setSectionResizeMode(2, QHeaderView.Fixed)  # Método
        header.setSectionResizeMode(3, QHeaderView.Fixed)  # Total USD
        header.setSectionResizeMode(4, QHeaderView.Fixed)  # Total BS
        header.setSectionResizeMode(5, QHeaderView.Fixed)  # Acciones
        
        # Establecer anchos específicos para cada columna
        self.sales_table.setColumnWidth(0, 80)   # ID
        self.sales_table.setColumnWidth(2, 120)  # Método de pago
        self.sales_table.setColumnWidth(3, 120)  # Total USD
        self.sales_table.setColumnWidth(4, 120)  # Total BS
        self.sales_table.setColumnWidth(5, 150)  # Acciones
        
        # Configurar altura de filas
        self.sales_table.verticalHeader().setDefaultSectionSize(55)
        
        layout.addWidget(self.sales_table)
        
        # Totales
        totals_frame = QFrame()
        totals_frame.setStyleSheet(self.style_manager.get_frame_style("section"))
        totals_layout = QHBoxLayout(totals_frame)
        
        self.total_sales_label = QLabel("Total Ventas: 0")
        self.total_sales_label.setStyleSheet(self.style_manager.get_label_style("subtitle"))
        
        self.total_usd_history_label = QLabel("Total USD: $0.00")
        self.total_usd_history_label.setStyleSheet(self.style_manager.get_label_style("subtitle"))
        
        self.total_ves_history_label = QLabel("Total BS: 0.00")
        self.total_ves_history_label.setStyleSheet(self.style_manager.get_label_style("subtitle"))
        
        totals_layout.addWidget(self.total_sales_label)
        totals_layout.addWidget(self.total_usd_history_label)
        totals_layout.addWidget(self.total_ves_history_label)
        
        layout.addWidget(totals_frame)
        
        # Botones
        button_layout = QHBoxLayout()
        
        export_button = QPushButton("Exportar a PDF")
        export_button.setStyleSheet(self.style_manager.get_button_style())
        export_button.clicked.connect(lambda: self.export_sales_history())
        
        close_button = QPushButton("Cerrar")
        close_button.setStyleSheet(self.style_manager.get_button_style("accent"))
        close_button.clicked.connect(dialog.accept)
        
        button_layout.addWidget(export_button)
        button_layout.addWidget(close_button)
        
        layout.addLayout(button_layout)
        
        dialog.setLayout(layout)
        
        # Cargar ventas iniciales
        self.load_sales_history(dialog)
        
        dialog.exec_()


    def load_sales_history(self, dialog):
        """Carga el historial de ventas según los filtros"""
        from_date = self.from_date.date().toString("yyyy-MM-dd")
        to_date = self.to_date.date().toString("yyyy-MM-dd")
        
        # Obtener ventas
        sales = self.db_manager.get_sales_by_date_range(from_date, to_date)
        
        # Limpiar tabla
        self.sales_table.setRowCount(0)
        
        # Calcular totales
        total_sales = len(sales)
        total_usd = sum(sale[2] for sale in sales)  # Índice 2 = total_usd
        total_ves = sum(sale[3] for sale in sales)  # Índice 3 = total_ves
        
        # Actualizar etiquetas de totales
        self.total_sales_label.setText(f"Total Ventas: {total_sales}")
        self.total_usd_history_label.setText(f"Total USD: ${total_usd:.2f}")
        self.total_ves_history_label.setText(f"Total BS: {total_ves:.2f}")
        
        # Llenar tabla
        for row, sale in enumerate(sales):
            sale_id, timestamp, total_usd, total_ves, payment_method = sale[:5]
            
            # Convertir timestamp a datetime
            sale_date = datetime.fromisoformat(timestamp).strftime('%d/%m/%Y %H:%M:%S')
            
            self.sales_table.insertRow(row)
            
            # ID
            id_item = QTableWidgetItem(sale_id[:8])
            id_item.setData(Qt.UserRole, sale_id)  # Guardar ID completo como dato
            self.sales_table.setItem(row, 0, id_item)
            
            # Fecha
            self.sales_table.setItem(row, 1, QTableWidgetItem(sale_date))
            
            # Método
            self.sales_table.setItem(row, 2, QTableWidgetItem(payment_method))
            
            # Total USD
            usd_item = QTableWidgetItem(f"${total_usd:.2f}")
            usd_item.setTextAlignment(Qt.AlignRight | Qt.AlignVCenter)
            self.sales_table.setItem(row, 3, usd_item)
            
            # Total BS
            ves_item = QTableWidgetItem(f"Bs. {total_ves:.2f}")
            ves_item.setTextAlignment(Qt.AlignRight | Qt.AlignVCenter)
            self.sales_table.setItem(row, 4, ves_item)
            
            # Botones de acción
            action_widget = QWidget()
            action_layout = QHBoxLayout(action_widget)
            action_layout.setContentsMargins(0, 0, 0, 0)
            
            view_button = QPushButton("Ver")
            view_button.setStyleSheet(self.style_manager.get_button_style("primary"))
            view_button.clicked.connect(lambda checked, s=sale_id: self.view_sale_details(s))
            
            print_button = QPushButton("Imprimir")
            print_button.setStyleSheet(self.style_manager.get_button_style())
            print_button.clicked.connect(lambda checked, s=sale_id: self.print_receipt(s))
            
            action_layout.addWidget(view_button)
            action_layout.addWidget(print_button)
            
            self.sales_table.setCellWidget(row, 5, action_widget)
        
        # Ajustar tamaño de las columnas
        self.sales_table.resizeColumnsToContents()

    def view_sale_details(self, sale_id):
        """Muestra los detalles de una venta"""
        # Obtener datos de la venta
        sale = self.db_manager.get_sale(sale_id)
        if not sale:
            QMessageBox.warning(self, "Error", "No se pudo obtener la información de la venta.")
            return
            
        # Extraer datos
        sale_id, timestamp, total_usd, total_ves, payment_method, usd_received, ves_received, usd_change, ves_change, exchange_rate = sale[:10]
        
        # Convertir timestamp a datetime
        sale_date = datetime.fromisoformat(timestamp)
        
        # Obtener items de la venta
        items = self.db_manager.get_sale_items(sale_id)
        
        # Crear diálogo
        dialog = QDialog(self)
        dialog.setWindowTitle("Detalles de Venta")
        dialog.setMinimumSize(600, 500)
        dialog.setStyleSheet(self.style_manager.get_dialog_style())
        
        layout = QVBoxLayout()
        
        # Título
        title = QLabel(f"Detalles de Venta #{sale_id[:8]}")
        title.setStyleSheet(self.style_manager.get_label_style("title"))
        title.setAlignment(Qt.AlignCenter)
        layout.addWidget(title)
        
        # Información de la venta
        info_frame = QFrame()
        info_frame.setStyleSheet(self.style_manager.get_frame_style("section"))
        info_layout = QFormLayout(info_frame)
        
        info_layout.addRow("Fecha:", QLabel(sale_date.strftime('%d/%m/%Y %H:%M:%S')))
        info_layout.addRow("Método de Pago:", QLabel(payment_method))
        info_layout.addRow("Total USD:", QLabel(f"${total_usd:.2f}"))
        info_layout.addRow("Total BS:", QLabel(f"Bs. {total_ves:.2f}"))
        info_layout.addRow("Tasa de Cambio:", QLabel(f"{exchange_rate:.2f} BS/USD"))
        
        if payment_method == "BS" or payment_method == "Mixto":
            info_layout.addRow("Recibido BS:", QLabel(f"Bs. {ves_received:.2f}"))
            info_layout.addRow("Cambio BS:", QLabel(f"Bs. {ves_change:.2f}"))
        
        if payment_method == "USD" or payment_method == "Mixto":
            info_layout.addRow("Recibido USD:", QLabel(f"${usd_received:.2f}"))
            info_layout.addRow("Cambio USD:", QLabel(f"${usd_change:.2f}"))
        
        layout.addWidget(info_frame)
        
        # Tabla de items
        items_label = QLabel("Productos")
        items_label.setStyleSheet(self.style_manager.get_label_style("subtitle"))
        layout.addWidget(items_label)
        
        items_table = QTableWidget()
        items_table.setStyleSheet(self.style_manager.get_table_style())
        items_table.setColumnCount(5)
        items_table.setHorizontalHeaderLabels(["Producto", "Cantidad", "Precio USD", "Precio BS", "Subtotal BS"])
        items_table.horizontalHeader().setSectionResizeMode(0, QHeaderView.Stretch)
        
        # Llenar tabla de items
        for row, item in enumerate(items):
            _, _, _, product_name, quantity, price_usd, price_ves, _, _, discount, subtotal_usd, subtotal_ves = item
            
            items_table.insertRow(row)
            
            # Producto
            product_text = product_name
            if discount > 0:
                product_text += f" (-{discount}%)"
            items_table.setItem(row, 0, QTableWidgetItem(product_text))
            
            # Cantidad
            items_table.setItem(row, 1, QTableWidgetItem(str(quantity)))
            
            # Precio USD
            usd_item = QTableWidgetItem(f"${price_usd:.2f}")
            usd_item.setTextAlignment(Qt.AlignRight | Qt.AlignVCenter)
            items_table.setItem(row, 2, usd_item)
            
            # Precio BS
            ves_item = QTableWidgetItem(f"Bs. {price_ves:.2f}")
            ves_item.setTextAlignment(Qt.AlignRight | Qt.AlignVCenter)
            items_table.setItem(row, 3, ves_item)
            
            # Subtotal BS
            subtotal_item = QTableWidgetItem(f"Bs. {subtotal_ves:.2f}")
            subtotal_item.setTextAlignment(Qt.AlignRight | Qt.AlignVCenter)
            items_table.setItem(row, 4, subtotal_item)
        
        layout.addWidget(items_table)
        
        # Botones
        button_layout = QHBoxLayout()
        
        print_button = QPushButton("Imprimir Ticket")
        print_button.setStyleSheet(self.style_manager.get_button_style())
        print_button.clicked.connect(lambda: self.print_receipt(sale_id))
        
        close_button = QPushButton("Cerrar")
        close_button.setStyleSheet(self.style_manager.get_button_style("accent"))
        close_button.clicked.connect(dialog.accept)
        
        button_layout.addWidget(print_button)
        button_layout.addWidget(close_button)
        
        layout.addLayout(button_layout)
        
        dialog.setLayout(layout)
        dialog.exec_()

    def export_sales_history(self):
        """Exporta el historial de ventas a PDF"""
        from_date = self.from_date.date().toString("yyyy-MM-dd")
        to_date = self.to_date.date().toString("yyyy-MM-dd")
        
        # Obtener ventas
        sales = self.db_manager.get_sales_by_date_range(from_date, to_date)
        
        if not sales:
            QMessageBox.information(self, "Sin Ventas", "No hay ventas en el rango de fechas seleccionado.")
            return
            
        # Calcular totales
        total_sales = len(sales)
        total_usd = sum(sale[2] for sale in sales)  # Índice 2 = total_usd
        total_ves = sum(sale[3] for sale in sales)  # Índice 3 = total_ves
        
        # Crear PDF
        filename = f"reportes/historial_ventas_{from_date}_a_{to_date}.pdf"
        os.makedirs("reportes", exist_ok=True)
        
        # Configurar canvas
        c = canvas.Canvas(filename, pagesize=letter)
        c.setFont("Helvetica-Bold", 16)
        
        # Encabezado
        c.drawCentredString(300, 750, "POS VENEZUELA")
        c.setFont("Helvetica-Bold", 14)
        c.drawCentredString(300, 730, "HISTORIAL DE VENTAS")
        c.setFont("Helvetica", 12)
        c.drawCentredString(300, 710, f"Período: {from_date} a {to_date}")
        
        # Línea divisoria
        c.line(50, 700, 550, 700)
        
        # Tabla de ventas
        c.setFont("Helvetica-Bold", 12)
        c.drawString(50, 680, "ID")
        c.drawString(120, 680, "Fecha")
        c.drawString(250, 680, "Método")
        c.drawString(350, 680, "Total USD")
        c.drawString(450, 680, "Total BS")
        
        c.line(50, 670, 550, 670)
        
        # Datos de ventas
        y = 650
        c.setFont("Helvetica", 10)
        
        for sale in sales:
            sale_id, timestamp, total_usd, total_ves, payment_method = sale[:5]
            
            # Convertir timestamp a datetime
            sale_date = datetime.fromisoformat(timestamp).strftime('%d/%m/%Y %H:%M')
            
            c.drawString(50, y, sale_id[:8])
            c.drawString(120, y, sale_date)
            c.drawString(250, y, payment_method)
            c.drawString(350, y, f"${total_usd:.2f}")
            c.drawString(450, y, f"Bs. {total_ves:.2f}")
            
            y -= 20
            
            # Si se acerca al final de la página, crear nueva página
            if y < 100:
                c.showPage()
                c.setFont("Helvetica-Bold", 14)
                c.drawCentredString(300, 750, "HISTORIAL DE VENTAS (Continuación)")
                c.setFont("Helvetica-Bold", 12)
                c.drawString(50, 730, "ID")
                c.drawString(120, 730, "Fecha")
                c.drawString(250, 730, "Método")
                c.drawString(350, 730, "Total USD")
                c.drawString(450, 730, "Total BS")
                c.line(50, 720, 550, 720)
                c.setFont("Helvetica", 10)
                y = 700
        
        # Línea divisoria
        c.line(50, y, 550, y)
        y -= 30
        
        # Totales
        c.setFont("Helvetica-Bold", 12)
        c.drawString(50, y, f"Total Ventas: {total_sales}")
        c.drawString(250, y, "TOTAL:")
        c.drawString(350, y, f"${total_usd:.2f}")
        c.drawString(450, y, f"Bs. {total_ves:.2f}")
        
        # Guardar PDF
        c.save()
        
        # Abrir el PDF con el visor predeterminado
        if sys.platform.startswith('darwin'):  # macOS
            subprocess.call(('open', filename))
        elif sys.platform.startswith('win'):   # Windows
            os.startfile(filename)
        else:  # Linux
            subprocess.call(('xdg-open', filename))
            
        QMessageBox.information(self, "Reporte Generado", f"El historial de ventas se ha exportado correctamente.\nArchivo: {filename}")

    def close_day(self):
        """Cierra el día y genera un reporte final"""
        confirm = QMessageBox.question(
            self,
            "Confirmar Cierre",
            "¿Está seguro de cerrar el día? Esto generará un reporte final del día.",
            QMessageBox.Yes | QMessageBox.No,
            QMessageBox.No
        )
        
        if confirm == QMessageBox.Yes:
            # Generar reporte diario
            self.generate_daily_report()
            
            # Marcar el día como cerrado (opcional)
            # self.db_manager.mark_day_closed()
            
            QMessageBox.information(self, "Día Cerrado", "El día ha sido cerrado correctamente.")

    def closeEvent(self, event):
        """Maneja el evento de cierre de la aplicación"""
        confirm = QMessageBox.question(
            self,
            "Confirmar Salida",
            "¿Está seguro de salir de la aplicación?",
            QMessageBox.Yes | QMessageBox.No,
            QMessageBox.No
        )
        
        if confirm == QMessageBox.Yes:
            # Detener actualización automática de tasa
            self.exchange_rate_manager.update_exchange_rate()
            event.accept()
        else:
            event.ignore()

def main():
    app = QApplication(sys.argv)
    
    # Configurar estilo global
    app.setStyle("Fusion")
    
    # Crear y mostrar la ventana principal
    window = MainWindow()
    window.show()
    
    sys.exit(app.exec_())

if __name__ == "__main__":
    main()
