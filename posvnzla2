                font-size: 14px;
            }}
            QDoubleSpinBox:focus {{
                border-color: {self.style_manager.colors['primary']};
            }}
        """
    
    def get_button_style(self, bg_color):
        return f"""
            QPushButton {{
                background-color: {bg_color};
                color: {self.style_manager.colors['text_light']};
                border: none;
                padding: 12px 24px;
                border-radius: 6px;
                font-weight: bold;
                font-size: 14px;
            }}
            QPushButton:hover {{
                opacity: 0.8;
            }}
        """
    
    def update_payment_fields(self):
        """Actualiza los campos según el método de pago"""
        # Limpiar layout
        for i in reversed(range(self.payment_fields_layout.count())):
            item = self.payment_fields_layout.itemAt(i)
            if item:
                widget = item.widget()
                if widget:
                    widget.setParent(None)
        
        if self.usd_radio.isChecked():
            self.payment_fields_layout.addRow("USD Recibido:", self.usd_received_input)
            self.usd_received_input.setValue(self.total_usd)
            self.ves_received_input.setValue(0)
        elif self.ves_radio.isChecked():
            self.payment_fields_layout.addRow("VES Recibido:", self.ves_received_input)
            self.ves_received_input.setValue(self.total_ves)
            self.usd_received_input.setValue(0)
        else:  # Mixto
            self.payment_fields_layout.addRow("USD Recibido:", self.usd_received_input)
            self.payment_fields_layout.addRow("VES Recibido:", self.ves_received_input)
            self.usd_received_input.setValue(0)
            self.ves_received_input.setValue(0)
        
        self.calculate_change()
    
    def calculate_change(self):
        """Calcula el cambio"""
        usd_received = self.usd_received_input.value()
        ves_received = self.ves_received_input.value()
        
        # Convertir todo a USD para calcular
        total_received_usd = usd_received + (ves_received / self.exchange_rate)
        
        change_usd = max(0, total_received_usd - self.total_usd)
        change_ves = change_usd * self.exchange_rate
        
        self.change_usd_label.setText(f"Cambio USD: ${change_usd:.2f}")
        self.change_ves_label.setText(f"Cambio VES: Bs. {change_ves:,.2f}")
        
        # Habilitar/deshabilitar botón según si el pago es suficiente
        sufficient = total_received_usd >= self.total_usd
        self.process_btn.setEnabled(sufficient)
        
        if not sufficient:
            self.process_btn.setText(f"Faltan ${self.total_usd - total_received_usd:.2f}")
            self.process_btn.setStyleSheet(self.get_button_style(self.style_manager.colors['accent']))
        else:
            self.process_btn.setText("Procesar Pago")
            self.process_btn.setStyleSheet(self.get_button_style(self.style_manager.colors['success']))
    
    def process_payment(self):
        """Procesa el pago"""
        usd_received = self.usd_received_input.value()
        ves_received = self.ves_received_input.value()
        
        total_received_usd = usd_received + (ves_received / self.exchange_rate)
        
        if total_received_usd < self.total_usd:
            QMessageBox.warning(self, "Error", "El monto recibido es insuficiente")
            return
        
        change_usd = max(0, total_received_usd - self.total_usd)
        change_ves = change_usd * self.exchange_rate
        
        # Determinar método de pago
        if self.usd_radio.isChecked():
            payment_method = "USD"
        elif self.ves_radio.isChecked():
            payment_method = "VES"
        else:
            payment_method = "MIXTO"
        
        self.payment_data = {
            'payment_method': payment_method,
            'usd_received': usd_received,
            'ves_received': ves_received,
            'usd_change': change_usd,
            'ves_change': change_ves
        }
        
        self.accept()

