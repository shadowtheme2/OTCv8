    def load_sales_data(self, start_date, end_date):
        """Carga los datos de ventas"""
        sales = self.db_manager.get_sales_by_period(
            start_date.strftime('%Y-%m-%d'),
            end_date.strftime('%Y-%m-%d')
        )
        
        # Actualizar resumen
        self.update_summary(sales)
        
        # Actualizar tabla
        self.update_sales_table(sales)
    
    def update_summary(self, sales):
        """Actualiza el resumen de ventas"""
        # Limpiar layout anterior
        for i in reversed(range(self.summary_layout.count())):
            self.summary_layout.itemAt(i).widget().setParent(None)
        
        if not sales:
            no_sales_label = QLabel("No hay ventas en el período seleccionado")
            no_sales_label.setAlignment(Qt.AlignCenter)
            no_sales_label.setFont(self.style_manager.fonts['subtitle'])
            self.summary_layout.addWidget(no_sales_label)
            return
        
        # Calcular totales
        total_sales = len(sales)
        total_usd = sum(sale[2] for sale in sales)  # total_usd está en índice 2
        total_ves = sum(sale[3] for sale in sales)  # total_ves está en índice 3
        avg_sale = total_usd / total_sales if total_sales > 0 else 0
        
        # Crear widgets de resumen
        summary_items = [
            ("Ventas", str(total_sales), "🛒"),
            ("Total USD", f"${total_usd:.2f}", "💵"),
            ("Total VES", f"Bs. {total_ves:,.2f}", "💰"),
            ("Promedio", f"${avg_sale:.2f}", "📊")
        ]
        
        for title, value, icon in summary_items:
            item_widget = QWidget()
            item_layout = QVBoxLayout(item_widget)
            item_layout.setContentsMargins(10, 5, 10, 5)
            
            icon_label = QLabel(icon)
            icon_label.setAlignment(Qt.AlignCenter)
            icon_label.setFont(QFont("Segoe UI", 20))
            
            title_label = QLabel(title)
            title_label.setAlignment(Qt.AlignCenter)
            title_label.setFont(self.style_manager.fonts['small'])
            
            value_label = QLabel(value)
            value_label.setAlignment(Qt.AlignCenter)
            value_label.setFont(self.style_manager.fonts['subtitle'])
            
            item_layout.addWidget(icon_label)
            item_layout.addWidget(title_label)
            item_layout.addWidget(value_label)
            
            self.summary_layout.addWidget(item_widget)
    
    def update_sales_table(self, sales):
        """Actualiza la tabla de ventas"""
        headers = ["ID", "Fecha/Hora", "Total USD", "Total VES", "Método", "Estado"]
        self.sales_table.setColumnCount(len(headers))
        self.sales_table.setHorizontalHeaderLabels(headers)
        self.sales_table.setRowCount(len(sales))
        
        for row, sale in enumerate(sales):
            # sale = (id, timestamp, total_usd, total_ves, payment_method, ...)
            sale_id = sale[0][:8] + "..."  # Mostrar solo parte del ID
            timestamp = datetime.fromisoformat(sale[1]).strftime("%d/%m/%Y %H:%M")
            total_usd = f"${sale[2]:.2f}"
            total_ves = f"Bs. {sale[3]:,.2f}"
            payment_method = sale[4]
            status = "Cerrado" if len(sale) > 12 and sale[12] == 1 else "Abierto"
            
            items = [sale_id, timestamp, total_usd, total_ves, payment_method, status]
            
            for col, item in enumerate(items):
                table_item = QTableWidgetItem(str(item))
                if col == 5:  # Columna de estado
                    if status == "Cerrado":
                        table_item.setBackground(QColor(self.style_manager.colors['success']))
                        table_item.setForeground(QColor(self.style_manager.colors['text_light']))
                    else:
                        table_item.setBackground(QColor(self.style_manager.colors['warning']))
                        table_item.setForeground(QColor(self.style_manager.colors['text_primary']))
                
                self.sales_table.setItem(row, col, table_item)
        
        self.sales_table.resizeColumnsToContents()
    
    def close_day(self):
        """Cierra el día actual"""
        reply = QMessageBox.question(
            self, "Cerrar Día",
            "¿Está seguro que desea cerrar el día?\n"
            "Esta acción marcará todas las ventas del día como finalizadas.",
            QMessageBox.Yes | QMessageBox.No
        )
        
        if reply == QMessageBox.Yes:
            affected_rows = self.db_manager.close_day_sales()
            
            if affected_rows > 0:
                QMessageBox.information(
                    self, "Día Cerrado",
                    f"Se cerraron {affected_rows} ventas del día actual."
                )
                self.load_daily_report()  # Recargar datos
            else:
                QMessageBox.information(
                    self, "Sin Cambios",
                    "No hay ventas abiertas para cerrar."
                )
    
    def export_pdf(self):
        """Exporta el reporte a PDF"""
        try:
            # Crear directorio de reportes si no existe
            os.makedirs("reportes", exist_ok=True)
            
            filename = f"reportes/reporte_{datetime.now().strftime('%Y%m%d_%H%M%S')}.pdf"
            
            # Obtener datos actuales de la tabla
            sales_data = []
            for row in range(self.sales_table.rowCount()):
                row_data = []
                for col in range(self.sales_table.columnCount()):
                    item = self.sales_table.item(row, col)
                    row_data.append(item.text() if item else "")
                sales_data.append(row_data)
            
            self.generate_pdf_report(filename, sales_data)
            
            QMessageBox.information(
                self, "Reporte Exportado",
                f"Reporte guardado como:\n{filename}"
            )
            
        except Exception as e:
            QMessageBox.critical(
                self, "Error",
                f"Error al exportar reporte:\n{str(e)}"
            )
    
    def generate_pdf_report(self, filename, sales_data):
        """Genera el reporte PDF"""
        doc = SimpleDocTemplate(filename, pagesize=A4)
        styles = getSampleStyleSheet()
        story = []
        
        # Título
        title_style = ParagraphStyle(
            'CustomTitle',
            parent=styles['Heading1'],
            fontSize=18,
            spaceAfter=30,
            alignment=TA_CENTER
        )
        
# Continuando desde generate_pdf_report...

        title = Paragraph("Reporte de Ventas", title_style)
        story.append(title)
        
        # Fecha del reporte
        date_style = ParagraphStyle(
            'DateStyle',
            parent=styles['Normal'],
            fontSize=12,
            spaceAfter=20,
            alignment=TA_CENTER
        )
        
        date_text = f"Generado el: {datetime.now().strftime('%d/%m/%Y %H:%M:%S')}"
        story.append(Paragraph(date_text, date_style))
        story.append(Spacer(1, 12))
        
        # Tabla de datos
        if sales_data:
            headers = ["ID", "Fecha/Hora", "Total USD", "Total VES", "Método", "Estado"]
            table_data = [headers] + sales_data
            
            table = Table(table_data)
            table.setStyle(TableStyle([
                ('BACKGROUND', (0, 0), (-1, 0), colors.grey),
                ('TEXTCOLOR', (0, 0), (-1, 0), colors.whitesmoke),
                ('ALIGN', (0, 0), (-1, -1), 'CENTER'),
                ('FONTNAME', (0, 0), (-1, 0), 'Helvetica-Bold'),
                ('FONTSIZE', (0, 0), (-1, 0), 10),
                ('BOTTOMPADDING', (0, 0), (-1, 0), 12),
                ('BACKGROUND', (0, 1), (-1, -1), colors.beige),
                ('GRID', (0, 0), (-1, -1), 1, colors.black)
            ]))
            
            story.append(table)
        else:
            no_data = Paragraph("No hay datos para mostrar", styles['Normal'])
            story.append(no_data)
        
        doc.build(story)

