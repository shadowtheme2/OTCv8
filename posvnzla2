    def add_to_cart(self, product):
        """Agrega un producto al carrito"""
        if product['stock'] <= 0:
            QMessageBox.warning(self, "Sin Stock", f"El producto '{product['name']}' no tiene stock disponible")
            return
        
        # Verificar si el producto ya está en el carrito
        for i, item in enumerate(self.cart_items):
            if item['id'] == product['id']:
                # Verificar stock disponible
                if item['quantity'] >= product['stock']:
                    QMessageBox.warning(
                        self, "Stock Insuficiente", 
                        f"No hay suficiente stock para '{product['name']}'\n"
                        f"Stock disponible: {product['stock']:.1f}"
                    )
                    return
                
                # Incrementar cantidad
                self.cart_items[i]['quantity'] += 1
                break
        else:
            # Agregar nuevo item
            cart_item = {
                'id': product['id'],
                'name': product['name'],
                'price_usd': product['price_usd'],
                'price_ves': product['price_ves'],
                'quantity': 1,
                'stock_available': product['stock']
            }
            self.cart_items.append(cart_item)
        
        self.update_cart_display()
        self.status_label.setText(f"Agregado al carrito: {product['name']}")
    
    def remove_from_cart(self):
        """Remueve un item del carrito"""
        current_row = self.cart_list.currentRow()
        
        if current_row >= 0 and current_row < len(self.cart_items):
            removed_item = self.cart_items.pop(current_row)
            self.update_cart_display()
            self.status_label.setText(f"Removido del carrito: {removed_item['name']}")
        else:
            QMessageBox.information(self, "Selección", "Seleccione un item para remover")
    
    def clear_cart(self):
        """Limpia el carrito"""
        if self.cart_items:
            reply = QMessageBox.question(
                self, "Limpiar Carrito",
                "¿Está seguro que desea limpiar el carrito?",
                QMessageBox.Yes | QMessageBox.No
            )
            
            if reply == QMessageBox.Yes:
                self.cart_items.clear()
                self.update_cart_display()
                self.status_label.setText("Carrito limpiado")
    
    def update_cart_display(self):
        """Actualiza la visualización del carrito"""
        self.cart_list.clear()
        self.current_total_usd = 0.0
        self.current_total_ves = 0.0
        
        for item in self.cart_items:
            subtotal_usd = item['price_usd'] * item['quantity']
            subtotal_ves = item['price_ves'] * item['quantity']
            
            self.current_total_usd += subtotal_usd
            self.current_total_ves += subtotal_ves
            
            # Crear texto del item
            item_text = f"{item['name']}\n"
            item_text += f"Cantidad: {item['quantity']:.1f} | "
            item_text += f"${item['price_usd']:.2f} c/u\n"
            item_text += f"Subtotal: ${subtotal_usd:.2f}"
            
            list_item = QListWidgetItem(item_text)
            self.cart_list.addItem(list_item)
        
        # Actualizar totales
        self.total_usd_label.setText(f"Total USD: ${self.current_total_usd:.2f}")
        self.total_ves_label.setText(f"Total VES: Bs. {self.current_total_ves:,.2f}")
        
        # Habilitar/deshabilitar botón de pago
        self.checkout_btn.setEnabled(len(self.cart_items) > 0)
    
    def process_checkout(self):
        """Procesa el pago"""
        if not self.cart_items:
            QMessageBox.information(self, "Carrito Vacío", "Agregue productos al carrito antes de procesar el pago")
            return
        
        # Mostrar diálogo de pago
# Continuando desde process_checkout...

        payment_dialog = PaymentDialog(
            self, 
            self.current_total_usd,
            self.current_total_ves,
            self.exchange_manager.get_current_rate(),
            self.style_manager
        )
        
        if payment_dialog.exec_() == QDialog.Accepted:
            payment_data = payment_dialog.payment_data
            
            # Procesar la venta
            success = self.complete_sale(payment_data)
            
            if success:
                # Mostrar confirmación
                self.show_sale_confirmation(payment_data)
                
                # Limpiar carrito
                self.cart_items.clear()
                self.update_cart_display()
                
                # Recargar productos (para actualizar stock)
                self.load_products()
                
                self.status_label.setText("Venta procesada exitosamente")
            else:
                QMessageBox.critical(self, "Error", "Error al procesar la venta")
    
    def complete_sale(self, payment_data):
        """Completa la venta en la base de datos"""
        try:
            # Crear la venta
            sale_id = self.db_manager.create_sale(
                self.current_total_usd,
                self.current_total_ves,
                payment_data['payment_method'],
                self.exchange_manager.get_current_rate(),
                payment_data['usd_received'],
                payment_data['ves_received'],
                payment_data['usd_change'],
                payment_data['ves_change']
            )
            
            if not sale_id:
                return False
            
            # Agregar items de la venta y actualizar stock
            for item in self.cart_items:
                # Agregar item a la venta
                item_success = self.db_manager.add_sale_item(
                    sale_id,
                    item['id'],
                    item['quantity'],
                    item['price_usd'],
                    item['price_ves']
                )
                
                if not item_success:
                    return False
                
                # Actualizar stock del producto
                stock_success = self.db_manager.reduce_stock(
                    item['id'],
                    item['quantity']
                )
                
                if not stock_success:
                    return False
            
            return True
            
        except Exception as e:
            print(f"Error completing sale: {e}")
            return False
    
