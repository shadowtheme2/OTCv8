    def update_exchange_rate(self):
        """Actualiza la tasa de cambio"""
        try:
            old_rate = self.exchange_manager.get_current_rate()
            self.exchange_manager.update_rate()
            new_rate = self.exchange_manager.get_current_rate()
            
            # Actualizar display
            self.exchange_info.setText(f"Tasa: $1 = Bs. {new_rate:.2f}")
            
            # Actualizar totales del carrito si hay cambio en la tasa
            if abs(old_rate - new_rate) > 0.01:
                self.update_cart_display()
                self.status_label.setText(f"Tasa actualizada: Bs. {new_rate:.2f}")
            
        except Exception as e:
            self.status_label.setText(f"Error actualizando tasa: {str(e)}")
    
    def show_reports(self):
        """Muestra el diálogo de reportes"""
        reports_dialog = ReportsDialog(self, self.db_manager, self.style_manager)
        reports_dialog.exec_()
    
    def create_backup(self):
        """Crea un backup de la base de datos"""
        try:
            # Crear directorio de backups si no existe
            os.makedirs("backups", exist_ok=True)
            
            # Nombre del archivo de backup
            timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
            backup_filename = f"backups/pos_backup_{timestamp}.db"
            
            # Copiar base de datos
            import shutil
            shutil.copy2("pos_venezuela.db", backup_filename)
            
            QMessageBox.information(
                self, "Backup Creado",
                f"Backup creado exitosamente:\n{backup_filename}"
            )
            
            self.status_label.setText("Backup creado exitosamente")
            
        except Exception as e:
            QMessageBox.critical(
                self, "Error",
                f"Error creando backup:\n{str(e)}"
            )
    
    def closeEvent(self, event):
        """Maneja el cierre de la aplicación"""
        reply = QMessageBox.question(
            self, "Salir",
            "¿Está seguro que desea salir del sistema?",
            QMessageBox.Yes | QMessageBox.No,
            QMessageBox.No
        )
        
        if reply == QMessageBox.Yes:
            # Cerrar conexión a base de datos
            self.db_manager.close()
            event.accept()
        else:
            event.ignore()

