class DatabaseManager:
    def __init__(self):
        self.db_file = DATABASE_FILE
        self.init_database()
        self.create_backup()

    def init_database(self):
        """Inicializa la base de datos"""
        conn = sqlite3.connect(self.db_file)
        cursor = conn.cursor()
        
        # Tabla de productos
        cursor.execute('''
            CREATE TABLE IF NOT EXISTS products (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                name TEXT NOT NULL,
                price_ves REAL NOT NULL,
                price_usd REAL NOT NULL,
                stock REAL NOT NULL DEFAULT 0,
                profit_percentage REAL DEFAULT 0,
                created_at TEXT DEFAULT CURRENT_TIMESTAMP
            )
        ''')
        
        # Tabla de ventas con campo closed
        cursor.execute('''
            CREATE TABLE IF NOT EXISTS sales (
                id TEXT PRIMARY KEY,
                timestamp TEXT NOT NULL,
                total_usd REAL NOT NULL,
                total_ves REAL NOT NULL,
                payment_method TEXT NOT NULL,
                usd_received REAL DEFAULT 0,
                ves_received REAL DEFAULT 0,
                usd_change REAL DEFAULT 0,
                ves_change REAL DEFAULT 0,
                exchange_rate REAL NOT NULL,
                items TEXT NOT NULL,
                discount_percentage REAL DEFAULT 0,
                closed INTEGER DEFAULT 0
            )
        ''')
        
        # Tabla de items de venta (nueva tabla para mejor estructura)
        cursor.execute('''
            CREATE TABLE IF NOT EXISTS sale_items (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                sale_id TEXT NOT NULL,
                product_id INTEGER NOT NULL,
                quantity REAL NOT NULL,
                price_usd REAL NOT NULL,
                price_ves REAL NOT NULL,
                subtotal_usd REAL NOT NULL,
                subtotal_ves REAL NOT NULL,
                FOREIGN KEY (sale_id) REFERENCES sales (id),
                FOREIGN KEY (product_id) REFERENCES products (id)
            )
        ''')
        
        # Agregar columna closed si no existe (para bases de datos existentes)
        try:
            cursor.execute('ALTER TABLE sales ADD COLUMN closed INTEGER DEFAULT 0')
        except sqlite3.OperationalError:
            pass  # La columna ya existe
        
        # Tabla de configuración
        cursor.execute('''
            CREATE TABLE IF NOT EXISTS config (
                key TEXT PRIMARY KEY,
                value TEXT NOT NULL
            )
        ''')
        
        conn.commit()
        conn.close()

    def create_backup(self):
        """Crea backup temporal"""
        try:
            timestamp = datetime.now().isoformat()
            backup_data = {
                'timestamp': timestamp,
                'products': self.get_products(),
                'sales_count': len(self.get_daily_sales())
            }
            os.makedirs("backups", exist_ok=True)
            with open(f"backups/backup_temp_{datetime.now().strftime('%Y%m%d')}.json", 'w') as f:
                json.dump(backup_data, f, indent=2)
        except Exception as e:
            print(f"Error creando backup: {e}")

    def add_product(self, name, price_ves, stock, profit_percentage=0, exchange_rate=36.50):
        """Agrega un producto"""
        try:
            price_usd = price_ves / exchange_rate
            conn = sqlite3.connect(self.db_file)
            cursor = conn.cursor()
            cursor.execute('''
                INSERT INTO products (name, price_ves, price_usd, stock, profit_percentage)
                VALUES (?, ?, ?, ?, ?)
            ''', (name, price_ves, price_usd, stock, profit_percentage))
            conn.commit()
            conn.close()
            self.create_backup()
            return True
        except Exception as e:
            print(f"Error agregando producto: {e}")
            return False

    def update_product(self, product_id, name, price_ves, stock, profit_percentage, exchange_rate):
        """Actualiza un producto"""
        try:
            price_usd = price_ves / exchange_rate
            conn = sqlite3.connect(self.db_file)
            cursor = conn.cursor()
            cursor.execute('''
                UPDATE products 
                SET name=?, price_ves=?, price_usd=?, stock=?, profit_percentage=?
                WHERE id=?
            ''', (name, price_ves, price_usd, stock, profit_percentage, product_id))
            conn.commit()
            conn.close()
            self.create_backup()
            return True
        except Exception as e:
            print(f"Error actualizando producto: {e}")
            return False

    def add_stock(self, product_id, additional_stock):
        """Agrega stock a un producto existente"""
        try:
            conn = sqlite3.connect(self.db_file)
            cursor = conn.cursor()
            cursor.execute('''
                UPDATE products SET stock = stock + ? WHERE id = ?
            ''', (additional_stock, product_id))
            conn.commit()
            conn.close()
            self.create_backup()
            return True
        except Exception as e:
            print(f"Error agregando stock: {e}")
            return False

    def get_products(self, search_term=""):
        """Obtiene productos con búsqueda opcional"""
        conn = sqlite3.connect(self.db_file)
        cursor = conn.cursor()
        if search_term:
            cursor.execute('''
                SELECT * FROM products 
                WHERE name LIKE ? OR id LIKE ?
                ORDER BY name
            ''', (f'%{search_term}%', f'%{search_term}%'))
        else:
            cursor.execute('SELECT * FROM products ORDER BY name')
        products = cursor.fetchall()
        conn.close()
        return products

    def get_all_products(self):
        """Obtiene todos los productos"""
        return self.get_products()

    def search_products(self, search_term):
        """Busca productos por término"""
        return self.get_products(search_term)

    def get_product_by_id(self, product_id):
        """Obtiene un producto por ID"""
        conn = sqlite3.connect(self.db_file)
        cursor = conn.cursor()
        cursor.execute('SELECT * FROM products WHERE id = ?', (product_id,))
        product = cursor.fetchone()
        conn.close()
        return product

    def update_product_stock(self, product_id, quantity_sold):
        """Actualiza el stock de un producto después de una venta"""
        try:
            conn = sqlite3.connect(self.db_file)
            cursor = conn.cursor()
            cursor.execute('''
                UPDATE products SET stock = stock - ? WHERE id = ?
            ''', (quantity_sold, product_id))
            conn.commit()
            conn.close()
            return True
        except Exception as e:
            print(f"Error actualizando stock: {e}")
            return False

    def create_sale(self, total_usd, total_ves, payment_method, exchange_rate, 
                   usd_received=0, ves_received=0, usd_change=0, ves_change=0):
        """Crea una nueva venta y retorna el ID"""
        try:
            sale_id = str(uuid.uuid4())
            conn = sqlite3.connect(self.db_file)
            cursor = conn.cursor()
            cursor.execute('''
                INSERT INTO sales (id, timestamp, total_usd, total_ves, payment_method,
                                 usd_received, ves_received, usd_change, ves_change,
                                 exchange_rate, items, discount_percentage, closed)
                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
            ''', (
                sale_id, datetime.now().isoformat(), total_usd, total_ves, payment_method,
                usd_received, ves_received, usd_change, ves_change,
                exchange_rate, "[]", 0, 0
            ))
            conn.commit()
            conn.close()
            return sale_id
        except Exception as e:
            print(f"Error creando venta: {e}")
            return None

    def add_sale_item(self, sale_id, product_id, quantity, price_usd, price_ves):
        """Agrega un item a una venta"""
        try:
            subtotal_usd = price_usd * quantity
            subtotal_ves = price_ves * quantity
            
            conn = sqlite3.connect(self.db_file)
            cursor = conn.cursor()
            cursor.execute('''
                INSERT INTO sale_items (sale_id, product_id, quantity, price_usd, price_ves,
                                      subtotal_usd, subtotal_ves)
                VALUES (?, ?, ?, ?, ?, ?, ?)
            ''', (sale_id, product_id, quantity, price_usd, price_ves, subtotal_usd, subtotal_ves))
            conn.commit()
            conn.close()
            return True
        except Exception as e:
            print(f"Error agregando item de venta: {e}")
            return False

    def reduce_stock(self, product_id, quantity):
        """Reduce el stock de un producto"""
        try:
            conn = sqlite3.connect(self.db_file)
            cursor = conn.cursor()
            cursor.execute('''
                UPDATE products SET stock = stock - ? WHERE id = ?
            ''', (quantity, product_id))
            conn.commit()
            conn.close()
            return True
        except Exception as e:
            print(f"Error reduciendo stock: {e}")
            return False

    def record_sale(self, total_usd, total_ves, payment_method, usd_received,
                    ves_received, usd_change, ves_change, exchange_rate, items):
        """Registra una venta (método legacy - mantener compatibilidad)"""
        try:
            sale_id = str(uuid.uuid4())
            conn = sqlite3.connect(self.db_file)
            cursor = conn.cursor()
            cursor.execute('''
                INSERT INTO sales (id, timestamp, total_usd, total_ves, payment_method,
                                 usd_received, ves_received, usd_change, ves_change,
                                 exchange_rate, items, discount_percentage, closed)
                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
            ''', (
                sale_id, datetime.now().isoformat(), total_usd, total_ves, payment_method,
                usd_received, ves_received, usd_change, ves_change,
                exchange_rate, json.dumps(items), 0, 0
            ))
            conn.commit()
            conn.close()
            self.create_backup()
            return sale_id
        except Exception as e:
            print(f"Error registrando venta: {e}")
            return None

    def get_daily_sales(self, date=None, include_closed=True):
        """Obtiene las ventas del día"""
        if date is None:
            date = datetime.now().strftime('%Y-%m-%d')
        
        conn = sqlite3.connect(self.db_file)
        cursor = conn.cursor()
        
        if include_closed:
            cursor.execute('''
                SELECT * FROM sales 
                WHERE date(timestamp) = ?
                ORDER BY timestamp
            ''', (date,))
        else:
            cursor.execute('''
                SELECT * FROM sales 
                WHERE date(timestamp) = ? AND closed = 0
                ORDER BY timestamp
            ''', (date,))
        
        sales = cursor.fetchall()
        conn.close()
        return sales

    def get_sales_by_period(self, start_date, end_date):
        """Obtiene ventas por período"""
        conn = sqlite3.connect(self.db_file)
        cursor = conn.cursor()
        cursor.execute('''
            SELECT * FROM sales 
            WHERE date(timestamp) BETWEEN ? AND ?
            ORDER BY timestamp
        ''', (start_date, end_date))
        sales = cursor.fetchall()
        conn.close()
        return sales

    def close_day_sales(self, date=None):
        """Marca las ventas del día como cerradas"""
        if date is None:
            date = datetime.now().strftime('%Y-%m-%d')
        
        try:
            conn = sqlite3.connect(self.db_file)
            cursor = conn.cursor()
            cursor.execute('''
                UPDATE sales SET closed = 1 
                WHERE date(timestamp) = ? AND closed = 0
            ''', (date,))
            affected_rows = cursor.rowcount
            conn.commit()
            conn.close()
            return affected_rows
        except Exception as e:
            print(f"Error cerrando día: {e}")
            return 0

    def get_sale_items(self, sale_id):
        """Obtiene los items de una venta específica"""
        conn = sqlite3.connect(self.db_file)
        cursor = conn.cursor()
        cursor.execute('''
            SELECT si.*, p.name as product_name
            FROM sale_items si
            JOIN products p ON si.product_id = p.id
            WHERE si.sale_id = ?
        ''', (sale_id,))
        items = cursor.fetchall()
        conn.close()
        return items

    def get_sales_summary(self, start_date=None, end_date=None):
        """Obtiene resumen de ventas"""
        conn = sqlite3.connect(self.db_file)
        cursor = conn.cursor()
        
        if start_date and end_date:
            cursor.execute('''
                SELECT 
                    COUNT(*) as total_sales,
                    SUM(total_usd) as total_usd,
                    SUM(total_ves) as total_ves,
                    AVG(total_usd) as avg_sale_usd
                FROM sales 
                WHERE date(timestamp) BETWEEN ? AND ?
            ''', (start_date, end_date))
        else:
            today = datetime.now().strftime('%Y-%m-%d')
            cursor.execute('''
                SELECT 
                    COUNT(*) as total_sales,
                    SUM(total_usd) as total_usd,
                    SUM(total_ves) as total_ves,
                    AVG(total_usd) as avg_sale_usd
                FROM sales 
                WHERE date(timestamp) = ?
            ''', (today,))
        
        summary = cursor.fetchone()
        conn.close()
        return summary

    def close(self):
        """Cierra la conexión"""
        pass

class ExchangeRateManager(QObject):
    rate_updated = pyqtSignal(float)
    
    def __init__(self):
        super().__init__()
        self.current_rate = EXCHANGE_CONFIG["default_rate"]
        self.last_update = None
    
    def get_current_rate(self):
        """Obtiene la tasa de cambio actual"""
        return self.current_rate
    
    def fetch_exchange_rate(self):
        """Obtiene la tasa de cambio de forma síncrona"""
        try:
            response = requests.get(
                EXCHANGE_CONFIG["primary_api"],
                timeout=EXCHANGE_CONFIG["request_timeout"]
            )
            if response.status_code == 200:
                data = response.json()
                ves_rate = data.get("rates", {}).get("VES")
                if ves_rate:
                    self.current_rate = ves_rate
                    self.last_update = datetime.now()
                    return self.current_rate
        except:
            pass
        
        try:
            response = requests.get(
                EXCHANGE_CONFIG["backup_api"],
                timeout=EXCHANGE_CONFIG["request_timeout"]
            )
            if response.status_code == 200:
                data = response.json()
                new_rate = data.get("price")
                if new_rate:
                    self.current_rate = float(new_rate)
                    self.last_update = datetime.now()
                    return self.current_rate
        except:
            pass
        
        return self.current_rate

