        # Crear botones de productos organizados
        for index, product_data in enumerate(self.filtered_products):
            product = {
                'id': product_data[0],
                'name': product_data[1],
                'price_ves': product_data[2],
                'price_usd': product_data[3],
                'stock': product_data[4],
                'profit_percentage': product_data[5] if len(product_data) > 5 else 0
            }
            
            btn = self.create_product_button(product, index)
            self.products_layout.addWidget(btn, row, col)
            
            col += 1
            if col >= columns:
                col = 0
                row += 1
        
        # Espaciador final
        spacer = QSpacerItem(20, 40, QSizePolicy.Minimum, QSizePolicy.Expanding)
        self.products_layout.addItem(spacer, row + 1, 0, 1, columns)

