    def create_product_categories_filter(self):
        """Crea filtros por categorías de productos"""
        filter_widget = QWidget()
        filter_layout = QHBoxLayout(filter_widget)
        filter_layout.setContentsMargins(10, 5, 10, 5)
        filter_layout.setSpacing(10)
        
        filter_widget.setStyleSheet(f"""
            QWidget {{
                background-color: {self.style_manager.colors['background']};
                border-radius: 8px;
                margin: 5px;
            }}
        """)
        
        # Filtros rápidos
        filters = [
            ("🔍 Todos", "all"),
            ("✅ Disponibles", "available"),
            ("⚠️ Stock Bajo", "low_stock"),
            ("🚫 Sin Stock", "no_stock"),
            ("📈 Alta Ganancia", "high_profit")
        ]
        
        self.filter_buttons = []
        
        for text, filter_type in filters:
            btn = QPushButton(text)
            btn.setFont(QFont("Segoe UI", 9))
            btn.setCheckable(True)
            btn.setStyleSheet(f"""
                QPushButton {{
                    background-color: {self.style_manager.colors['surface']};
                    border: 2px solid {self.style_manager.colors['border']};
                    border-radius: 6px;
                    padding: 6px 12px;
                    color: {self.style_manager.colors['text_primary']};
                }}
                QPushButton:checked {{
                    background-color: {self.style_manager.colors['primary']};
                    color: {self.style_manager.colors['text_light']};
                    border-color: {self.style_manager.colors['primary']};
                }}
                QPushButton:hover {{
                    border-color: {self.style_manager.colors['secondary']};
                }}
            """)
            
            btn.clicked.connect(lambda checked, f=filter_type: self.apply_product_filter(f))
            filter_layout.addWidget(btn)
            self.filter_buttons.append((btn, filter_type))
        
        # Seleccionar "Todos" por defecto
        self.filter_buttons[0][0].setChecked(True)
        
        filter_layout.addStretch()
        return filter_widget

    def apply_product_filter(self, filter_type):
        """Aplica filtros a los productos"""
        # Desmarcar otros botones
        for btn, btn_type in self.filter_buttons:
            if btn_type != filter_type:
                btn.setChecked(False)
        
        # Aplicar filtro
        all_products = self.db.get_all_products()
        
        if filter_type == "all":
            self.filtered_products = all_products
        elif filter_type == "available":
            self.filtered_products = [p for p in all_products if p[4] > 5]
        elif filter_type == "low_stock":
            self.filtered_products = [p for p in all_products if 0 < p[4] <= 5]
        elif filter_type == "no_stock":
            self.filtered_products = [p for p in all_products if p[4] <= 0]
        elif filter_type == "high_profit":
            self.filtered_products = [p for p in all_products if len(p) > 5 and p[5] >= 25]
        
        # Recrear la grilla
        self.create_product_grid_improved()

