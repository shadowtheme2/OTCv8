# ==================== GESTOR DE TASA DE CAMBIO ====================
class ExchangeRateManager(QObject):
    rate_updated = pyqtSignal(float)
    error_occurred = pyqtSignal(str)
    
    def __init__(self):
        super().__init__()
        self.current_rate = 36.0  # Tasa por defecto
        self.timer = QTimer()
        self.timer.timeout.connect(self.update_rate)
        self.timer.start(300000)  # Actualizar cada 5 minutos
        
        # Actualizar inmediatamente
        QTimer.singleShot(1000, self.update_rate)

    def update_rate(self):
        """Actualiza la tasa de cambio desde la API"""
        def fetch_rate():
            try:
                # Intentar varias APIs
                apis = [
                    "https://api.exchangerate-api.com/v4/latest/USD",
                    "https://api.fixer.io/latest?base=USD",
                    "https://openexchangerates.org/api/latest.json"
                ]
                
                for api_url in apis:
                    try:
                        response = requests.get(api_url, timeout=10)
                        if response.status_code == 200:
                            data = response.json()
                            
                            # Buscar tasa VES (Bolívar Venezolano)
                            if 'rates' in data:
                                if 'VES' in data['rates']:
                                    new_rate = data['rates']['VES']
                                elif 'VED' in data['rates']:
                                    new_rate = data['rates']['VED']
                                else:
                                    continue
                                
                                if new_rate > 0:
                                    self.current_rate = new_rate
                                    self.rate_updated.emit(new_rate)
                                    return
                    except:
                        continue
                
                # Si no se pudo obtener de APIs, usar tasa por defecto
                self.error_occurred.emit("No se pudo actualizar la tasa de cambio")
                
            except Exception as e:
                self.error_occurred.emit(f"Error actualizando tasa: {str(e)}")
        
        # Ejecutar en hilo separado
        thread = threading.Thread(target=fetch_rate)
        thread.daemon = True
        thread.start()

    def get_rate(self):
        """Obtiene la tasa actual"""
        return self.current_rate

    def set_rate(self, rate):
        """Establece manualmente la tasa"""
        if rate > 0:
            self.current_rate = rate
            self.rate_updated.emit(rate)

