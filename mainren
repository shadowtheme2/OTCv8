    def load_sales(self):
        """Carga las ventas en la tabla"""
        try:
            start_date = self.start_date_edit.date().toString("yyyy-MM-dd")
            end_date = self.end_date_edit.date().toString("yyyy-MM-dd")
            
            sales = self.db_manager.get_sales_report(start_date, end_date)
            self.sales_table.setRowCount(len(sales))
            
            for row, sale in enumerate(sales):
                self.sales_table.setItem(row, 0, QTableWidgetItem(sale[0][:8] + "..."))
                
                # Formatear fecha
                date_obj = datetime.fromisoformat(sale[1])
                formatted_date = date_obj.strftime("%d/%m/%Y %H:%M")
                self.sales_table.setItem(row, 1, QTableWidgetItem(formatted_date))
                
                self.sales_table.setItem(row, 2, QTableWidgetItem(f"${sale[2]:.2f}"))
                self.sales_table.setItem(row, 3, QTableWidgetItem(f"{sale[3]:.2f} Bs"))
                self.sales_table.setItem(row, 4, QTableWidgetItem(sale[4]))
                
                # Contar items de la venta
                items_count = self.db_manager.get_sale_items_count(sale[0])
                self.sales_table.setItem(row, 5, QTableWidgetItem(str(items_count)))
                
                status = sale[11] if len(sale) > 11 else "completed"
                self.sales_table.setItem(row, 6, QTableWidgetItem(status.title()))
                
        except Exception as e:
            QMessageBox.critical(self, "Error", f"Error cargando ventas: {str(e)}")

