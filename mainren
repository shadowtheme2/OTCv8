    def import_products(self):
        """Importa productos desde un archivo CSV"""
        file_path, _ = QFileDialog.getOpenFileName(
            self, "Importar Productos", "", "CSV Files (*.csv)"
        )
        
        if file_path:
            try:
                import csv
                imported_count = 0
                errors = []
                
                with open(file_path, 'r', encoding='utf-8') as file:
                    reader = csv.DictReader(file)
                    
                    for row_num, row in enumerate(reader, start=2):
                        try:
                            product_data = {
                                'name': row.get('nombre', '').strip(),
                                'description': row.get('descripcion', '').strip(),
                                'category': row.get('categoria', '').strip(),
                                'price_ves': float(row.get('precio_bs', 0)),
                                'price_usd': float(row.get('precio_usd', 0)),
                                'stock': float(row.get('stock', 0)),
                                'min_stock': float(row.get('stock_minimo', 0)),
                                'barcode': row.get('codigo_barras', '').strip(),
                                'supplier': row.get('proveedor', '').strip(),
                                'cost_price': float(row.get('precio_costo', 0)),
                                'profit_margin': float(row.get('margen_ganancia', 0)),
                                'location': row.get('ubicacion', '').strip()
                            }
                            
                            if not product_data['name']:
                                errors.append(f"Fila {row_num}: Nombre de producto requerido")
                                continue
                            
                            self.db_manager.add_product(product_data)
                            imported_count += 1
                            
                        except Exception as e:
                            errors.append(f"Fila {row_num}: {str(e)}")
                
                # Mostrar resultado
                message = f"Importación completada:\n- {imported_count} productos importados"
                if errors:
                    message += f"\n- {len(errors)} errores encontrados"
                    if len(errors) <= 10:
                        message += "\n\nErrores:\n" + "\n".join(errors)
                    else:
                        message += f"\n\nPrimeros 10 errores:\n" + "\n".join(errors[:10])
                
                QMessageBox.information(self, "Importación Completada", message)
                
                if imported_count > 0:
                    self.load_products()
                    self.update_statistics()
                    self.update_categories()
                
            except Exception as e:
                QMessageBox.critical(self, "Error", f"Error importando productos: {str(e)}")

