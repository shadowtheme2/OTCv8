    def get_sales_summary(self, start_date, end_date):
        """Obtiene un resumen de ventas por período"""
        conn = self.get_connection()
        cursor = conn.cursor()
        
        # Total de ventas
        cursor.execute('''
        SELECT COALESCE(SUM(total_usd), 0), COALESCE(SUM(total_ves), 0), COUNT(*)
        FROM sales WHERE DATE(timestamp) BETWEEN ? AND ?
        ''', (start_date, end_date))
        
        total_usd, total_ves, count = cursor.fetchone()
        
        # Ventas por método de pago
        cursor.execute('''
        SELECT payment_method, COALESCE(SUM(total_usd), 0)
        FROM sales WHERE DATE(timestamp) BETWEEN ? AND ?
        GROUP BY payment_method
        ''', (start_date, end_date))
        
        payment_methods = dict(cursor.fetchall())
        
        conn.close()
        
        return {
            'total_sales': total_usd,
            'total_sales_ves': total_ves,
            'transaction_count': count,
            'average_sale': total_usd / count if count > 0 else 0,
            'payment_methods': payment_methods
        }

