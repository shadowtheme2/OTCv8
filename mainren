            products = self.db_manager.get_products()
            self.all_products = products
            self.display_products(products)
        except Exception as e:
            QMessageBox.critical(self, "Error", f"Error cargando productos: {str(e)}")

    def display_products(self, products):
        """Muestra los productos en la lista"""
        self.products_list.clear()
        
        for product in products:
            if product[6] > 0:  # Solo productos con stock
                item_text = f"{product[1]} - ${product[5]:.2f} (Stock: {product[6]:.0f})"
                item = QListWidgetItem(item_text)
                item.setData(Qt.UserRole, product)
                self.products_list.addItem(item)

    def filter_products(self):
        """Filtra productos según la búsqueda"""
        search_text = self.product_search.text().lower()
        
        if not search_text:
            self.display_products(self.all_products)
            return
        
        filtered_products = []
        for product in self.all_products:
            if (search_text in product[1].lower() or  # nombre
                search_text in (product[8] or "").lower()):  # código de barras
                filtered_products.append(product)
        
        self.display_products(filtered_products)

    def add_product_by_search(self):
        """Agrega producto por búsqueda directa"""
        search_text = self.product_search.text().strip()
        
        if not search_text:
            return
        
        # Buscar por código de barras primero
        product = self.db_manager.get_product_by_barcode(search_text)
        
        if not product:
            # Buscar por nombre
            products = self.db_manager.get_products(search_text)
            if products:
                product = products[0]  # Tomar el primero
        
        if product:
            self.add_product_to_cart_direct(product)
            self.product_search.clear()
        else:
            QMessageBox.warning(self, "Producto no encontrado", 
                              f"No se encontró el producto: {search_text}")

    def add_product_to_cart(self, item):
        """Agrega producto al carrito desde la lista"""
        product = item.data(Qt.UserRole)
        self.add_product_to_cart_direct(product)

    def add_product_to_cart_direct(self, product):
        """Agrega producto directamente al carrito"""
        if product[6] <= 0:  # Sin stock
            QMessageBox.warning(self, "Sin Stock", f"El producto {product[1]} no tiene stock disponible")
            return
        
        # Pedir cantidad
        quantity, ok = QInputDialog.getDouble(
            self, "Cantidad", 
            f"Ingrese la cantidad para {product[1]}:",
            1.0, 0.1, product[6], 2
        )
        
        if not ok or quantity <= 0:
            return
        
        if quantity > product[6]:
            QMessageBox.warning(self, "Stock Insuficiente", 
                              f"Stock disponible: {product[6]:.2f}")
            return
        
        # Verificar si el producto ya está en el carrito
        for i, item in enumerate(self.cart_items):
            if item['product_id'] == product[0]:
                # Actualizar cantidad
                new_quantity = item['quantity'] + quantity
                if new_quantity > product[6]:
                    QMessageBox.warning(self, "Stock Insuficiente", 
                                      f"Stock disponible: {product[6]:.2f}")
                    return
                
                self.cart_items[i]['quantity'] = new_quantity
                self.cart_items[i]['subtotal_usd'] = new_quantity * product[5]
                self.cart_items[i]['subtotal_ves'] = new_quantity * product[4]
                break
        else:
            # Agregar nuevo item
            cart_item = {
                'product_id': product[0],
                'product_name': product[1],
                'quantity': quantity,
                'price_usd': product[5],
                'price_ves': product[4],
                'subtotal_usd': quantity * product[5],
                'subtotal_ves': quantity * product[4]
            }
            self.cart_items.append(cart_item)
        
        self.update_cart_display()

    def update_cart_display(self):
        """Actualiza la visualización del carrito"""
        self.cart_table.setRowCount(len(self.cart_items))
        
        total_usd = 0
        total_ves = 0
        
        for row, item in enumerate(self.cart_items):
            self.cart_table.setItem(row, 0, QTableWidgetItem(item['product_name']))
            self.cart_table.setItem(row, 1, QTableWidgetItem(f"{item['quantity']:.2f}"))
            self.cart_table.setItem(row, 2, QTableWidgetItem(f"${item['price_usd']:.2f}"))
            self.cart_table.setItem(row, 3, QTableWidgetItem(f"{item['price_ves']:.2f} Bs"))
            self.cart_table.setItem(row, 4, QTableWidgetItem(f"${item['subtotal_usd']:.2f}"))
            
            total_usd += item['subtotal_usd']
            total_ves += item['subtotal_ves']
        
        self.total_usd_label.setText(f"${total_usd:.2f}")
        self.total_ves_label.setText(f"{total_ves:.2f} Bs")
        
        # Habilitar botón de venta si hay items
        self.process_sale_btn.setEnabled(len(self.cart_items) > 0)

    def remove_from_cart(self):
        """Quita un item del carrito"""
        current_row = self.cart_table.currentRow()
        if current_row >= 0 and current_row < len(self.cart_items):
            self.cart_items.pop(current_row)
            self.update_cart_display()
        else:
            QMessageBox.warning(self, "Selección", "Seleccione un item para quitar")

    def clear_cart(self):
        """Limpia todo el carrito"""
        if self.cart_items:
            reply = QMessageBox.question(
                self, "Confirmar", 
                "¿Está seguro de limpiar el carrito?",
                QMessageBox.Yes | QMessageBox.No
            )
            
            if reply == QMessageBox.Yes:
                self.cart_items.clear()
                self.update_cart_display()

    def on_payment_method_changed(self):
        """Maneja el cambio de método de pago"""
        method = self.payment_method.currentText()
        
        # Limpiar layout anterior
        for i in reversed(range(self.payment_fields_layout.count())):
            self.payment_fields_layout.itemAt(i).widget().setParent(None)
        
        if method == "Efectivo USD":
            self.payment_fields_layout.addRow("USD Recibido:", self.usd_received_input)
            self.payment_fields_layout.addRow("Cambio USD:", self.usd_change_label)
            
        elif method == "Efectivo Bs":
            self.payment_fields_layout.addRow("Bs Recibidos:", self.ves_received_input)
            self.payment_fields_layout.addRow("Cambio Bs:", self.ves_change_label)
            
        elif method == "Mixto":
            self.payment_fields_layout.addRow("USD Recibido:", self.usd_received_input)
            self.payment_fields_layout.addRow("Bs Recibidos:", self.ves_received_input)
            self.payment_fields_layout.addRow("Cambio USD:", self.usd_change_label)
            self.payment_fields_layout.addRow("Cambio Bs:", self.ves_change_label)

    def calculate_change(self):
        """Calcula el cambio"""
        if not self.cart_items:
            return
        
        total_usd = sum(item['subtotal_usd'] for item in self.cart_items)
        total_ves = sum(item['subtotal_ves'] for item in self.cart_items)
        
        method = self.payment_method.currentText()
        
        if method == "Efectivo USD":
            received = self.usd_received_input.value()
            change = received - total_usd
            self.usd_change_label.setText(f"${change:.2f}")
            
        elif method == "Efectivo Bs":
            received = self.ves_received_input.value()
            change = received - total_ves
            self.ves_change_label.setText(f"{change:.2f} Bs")
            
        elif method == "Mixto":
            usd_received = self.usd_received_input.value()
            ves_received = self.ves_received_input.value()
            
            # Convertir todo a USD para calcular
            ves_in_usd = ves_received / self.exchange_rate
            total_received_usd = usd_received + ves_in_usd
            
            change_usd = total_received_usd - total_usd
            
            if change_usd >= 0:
                self.usd_change_label.setText(f"${change_usd:.2f}")
                self.ves_change_label.setText("0.00 Bs")
            else:
                self.usd_change_label.setText("$0.00")
                change_ves = abs(change_usd) * self.exchange_rate
                self.ves_change_label.setText(f"{change_ves:.2f} Bs")

    def process_sale(self):
        """Procesa la venta"""
        if not self.cart_items:
            QMessageBox.warning(self, "Carrito Vacío", "Agregue productos al carrito")
            return
        
        method = self.payment_method.currentText()
        total_usd = sum(item['subtotal_usd'] for item in self.cart_items)
        total_ves = sum(item['subtotal_ves'] for item in self.cart_items)
        
        # Validar pago
        if method == "Efectivo USD":
            if self.usd_received_input.value() < total_usd:
                QMessageBox.warning(self, "Pago Insuficiente", "El monto recibido es menor al total")
                return
        elif method == "Efectivo Bs":
            if self.ves_received_input.value() < total_ves:
                QMessageBox.warning(self, "Pago Insuficiente", "El monto recibido es menor al total")
                return
        elif method == "Mixto":
            usd_received = self.usd_received_input.value()
            ves_received = self.ves_received_input.value()
            ves_in_usd = ves_received / self.exchange_rate
            total_received = usd_received + ves_in_usd
            
            if total_received < total_usd:
                QMessageBox.warning(self, "Pago Insuficiente", "El monto total recibido es menor al total")
                return
        
        try:
            # Generar ID de venta
            from datetime import datetime
            import uuid
            
            sale_id = str(uuid.uuid4())[:8].upper()
            
            # Preparar datos de venta
            sale_data = {
                'id': sale_id,
                'total_usd': total_usd,
                'total_ves': total_ves,
                'payment_method': method,
                'exchange_rate': self.exchange_rate,
                'usd_received': self.usd_received_input.value() if method in ["Efectivo USD", "Mixto"] else 0,
                'ves_received': self.ves_received_input.value() if method in ["Efectivo Bs", "Mixto"] else 0,
                'usd_change': float(self.usd_change_label.text().replace('$', '')) if method in ["Efectivo USD", "Mixto"] else 0,
                'ves_change': float(self.ves_change_label.text().replace(' Bs', '')) if method in ["Efectivo Bs", "Mixto"] else 0,
                'notes': '',
                'customer': ''
            }
            
            # Guardar venta
            self.db_manager.add_sale(sale_data, self.cart_items)
            
            # Mostrar confirmación
            QMessageBox.information(self, "Venta Procesada", 
                                  f"Venta #{sale_id} procesada exitosamente\nTotal: ${total_usd:.2f}")
            
            # Generar recibo (opcional)
            reply = QMessageBox.question(
                self, "Generar Recibo", 
                "¿Desea generar un recibo en PDF?",
                QMessageBox.Yes | QMessageBox.No
            )
            
            if reply == QMessageBox.Yes:
                self.generate_receipt(sale_id, sale_data)
            
            self.accept()
            
        except Exception as e:
            QMessageBox.critical(self, "Error", f"Error procesando venta: {str(e)}")

    def generate_receipt(self, sale_id, sale_data):
        """Genera un recibo en PDF"""
        try:
            from reportlab.lib.pagesizes import letter, A4
