        try:
            from datetime import datetime, date
            
            today = date.today().strftime("%Y-%m-%d")
            current_month = datetime.now().strftime("%Y-%m")
            
            # Ventas del día
            daily_sales = self.db_manager.get_daily_sales(today)
            self.daily_sales_label.setText(f"${daily_sales:.2f}")
            
            # Ventas del mes
            monthly_sales = self.db_manager.get_monthly_sales(current_month)
            self.monthly_sales_label.setText(f"${monthly_sales:.2f}")
            
            # Transacciones del día
            daily_transactions = self.db_manager.get_daily_transactions_count(today)
            self.daily_transactions_label.setText(str(daily_transactions))
            
            # Productos con stock bajo
            low_stock = self.db_manager.get_low_stock_count()
            self.low_stock_label.setText(str(low_stock))
            
            # Total de productos
            total_products = self.db_manager.get_total_products_count()
            self.total_products_label.setText(str(total_products))
            
            # Valor del inventario
            inventory_value = self.db_manager.get_inventory_value()
            self.inventory_value_label.setText(f"${inventory_value:.2f}")
            
        except Exception as e:
