# ==================== GESTOR DE BASE DE DATOS ====================
# ==================== CORRECCIONES PARA DatabaseManager ====================

class DatabaseManager:
    def __init__(self, db_path="pos_database.db"):
        self.db_path = db_path
        self.init_database()

    def init_database(self):
        """Inicializa la base de datos y crea las tablas"""
        try:
            conn = sqlite3.connect(self.db_path)
            cursor = conn.cursor()
            
            # Tabla de productos
            cursor.execute('''
            CREATE TABLE IF NOT EXISTS products (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                name TEXT NOT NULL,
                description TEXT,
                category TEXT,
                price_ves REAL DEFAULT 0,
                price_usd REAL DEFAULT 0,
                stock REAL DEFAULT 0,
                min_stock REAL DEFAULT 0,
                barcode TEXT,
                supplier TEXT,
                cost_price REAL DEFAULT 0,
                profit_margin REAL DEFAULT 0,
                location TEXT,
                active BOOLEAN DEFAULT 1,
                created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
            )
            ''')
            
            # Tabla de ventas
            cursor.execute('''
            CREATE TABLE IF NOT EXISTS sales (
                id TEXT PRIMARY KEY,
                timestamp TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                total_usd REAL NOT NULL,
                total_ves REAL NOT NULL,
                payment_method TEXT NOT NULL,
                exchange_rate REAL NOT NULL,
                usd_received REAL DEFAULT 0,
                ves_received REAL DEFAULT 0,
                usd_change REAL DEFAULT 0,
                ves_change REAL DEFAULT 0,
                notes TEXT,
                status TEXT DEFAULT 'completed',
                customer TEXT
            )
            ''')
            
            # Tabla de items de venta
            cursor.execute('''
            CREATE TABLE IF NOT EXISTS sale_items (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                sale_id TEXT NOT NULL,
                product_id INTEGER NOT NULL,
                product_name TEXT NOT NULL,
                quantity REAL NOT NULL,
                price_usd REAL NOT NULL,
                price_ves REAL NOT NULL,
                subtotal_usd REAL NOT NULL,
                subtotal_ves REAL NOT NULL,
                FOREIGN KEY (sale_id) REFERENCES sales (id),
                FOREIGN KEY (product_id) REFERENCES products (id)
            )
            ''')
            
            # Tabla de configuración
            cursor.execute('''
            CREATE TABLE IF NOT EXISTS settings (
                key TEXT PRIMARY KEY,
                value TEXT NOT NULL
            )
            ''')
            
            conn.commit()
            conn.close()
            
        except Exception as e:
            print(f"Error inicializando base de datos: {e}")

    def get_connection(self):
        """Obtiene una conexión a la base de datos"""
        return sqlite3.connect(self.db_path)

    # ==================== MÉTODOS DE PRODUCTOS ====================
    
    def add_product(self, product_data):
        """Agrega un nuevo producto"""
        conn = self.get_connection()
        cursor = conn.cursor()
        
        cursor.execute('''
        INSERT INTO products (name, description, category, price_ves, price_usd, 
                            stock, min_stock, barcode, supplier, cost_price, 
                            profit_margin, location)
        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
        ''', (
            product_data['name'],
            product_data.get('description', ''),
            product_data.get('category', ''),
            product_data.get('price_ves', 0),
            product_data.get('price_usd', 0),
            product_data.get('stock', 0),
            product_data.get('min_stock', 0),
            product_data.get('barcode', ''),
            product_data.get('supplier', ''),
            product_data.get('cost_price', 0),
            product_data.get('profit_margin', 0),
            product_data.get('location', '')
        ))
        
        conn.commit()
        conn.close()

    def update_product(self, product_id, product_data):
        """Actualiza un producto existente"""
        conn = self.get_connection()
        cursor = conn.cursor()
        
        cursor.execute('''
        UPDATE products SET name=?, description=?, category=?, price_ves=?, price_usd=?,
                          stock=?, min_stock=?, barcode=?, supplier=?, cost_price=?,
                          profit_margin=?, location=?
        WHERE id=?
        ''', (
            product_data['name'],
            product_data.get('description', ''),
            product_data.get('category', ''),
            product_data.get('price_ves', 0),
            product_data.get('price_usd', 0),
            product_data.get('stock', 0),
            product_data.get('min_stock', 0),
            product_data.get('barcode', ''),
            product_data.get('supplier', ''),
            product_data.get('cost_price', 0),
            product_data.get('profit_margin', 0),
            product_data.get('location', ''),
            product_id
        ))
        
        conn.commit()
        conn.close()

    def get_products(self, search_term=None, category=None):
        """Obtiene la lista de productos con filtros opcionales"""
        conn = self.get_connection()
        cursor = conn.cursor()
        
        query = "SELECT * FROM products WHERE active = 1"
        params = []
        
        if search_term:
            query += " AND (name LIKE ? OR description LIKE ? OR barcode LIKE ?)"
            search_pattern = f"%{search_term}%"
            params.extend([search_pattern, search_pattern, search_pattern])
        
        if category:
            query += " AND category = ?"
            params.append(category)
        
        query += " ORDER BY name"
        
        cursor.execute(query, params)
        products = cursor.fetchall()
        conn.close()
        
        return products

    def get_product_by_id(self, product_id):
        """Obtiene un producto por su ID"""
        conn = self.get_connection()
        cursor = conn.cursor()
        
        cursor.execute("SELECT * FROM products WHERE id = ?", (product_id,))
        product = cursor.fetchone()
        conn.close()
        
        return product

    def get_product_by_barcode(self, barcode):
        """Obtiene un producto por su código de barras"""
        conn = self.get_connection()
        cursor = conn.cursor()
        
        cursor.execute("SELECT * FROM products WHERE barcode = ? AND active = 1", (barcode,))
        product = cursor.fetchone()
        conn.close()
        
        return product

    def delete_product(self, product_id):
        """Elimina un producto (marca como inactivo)"""
        conn = self.get_connection()
        cursor = conn.cursor()
        
        cursor.execute("UPDATE products SET active = 0 WHERE id = ?", (product_id,))
        
        conn.commit()
        conn.close()

    def update_stock(self, product_id, new_stock):
        """Actualiza el stock de un producto"""
        conn = self.get_connection()
        cursor = conn.cursor()
        
        cursor.execute("UPDATE products SET stock = ? WHERE id = ?", (new_stock, product_id))
        
        conn.commit()
        conn.close()

    def get_categories(self):
        """Obtiene todas las categorías únicas"""
        conn = self.get_connection()
        cursor = conn.cursor()
        
        cursor.execute("SELECT DISTINCT category FROM products WHERE category IS NOT NULL AND category != '' AND active = 1")
        categories = [row[0] for row in cursor.fetchall()]
        conn.close()
        
        return sorted(categories)

    # ==================== MÉTODOS DE VENTAS ====================
    
    def add_sale(self, sale_data, items):
        """Agrega una nueva venta con sus items"""
        conn = self.get_connection()
        cursor = conn.cursor()
        
        try:
            # Insertar venta
            cursor.execute('''
            INSERT INTO sales (id, total_usd, total_ves, payment_method, exchange_rate,
                             usd_received, ves_received, usd_change, ves_change, notes, customer)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
            ''', (
                sale_data['id'],
                sale_data['total_usd'],
                sale_data['total_ves'],
                sale_data['payment_method'],
                sale_data['exchange_rate'],
                sale_data.get('usd_received', 0),
                sale_data.get('ves_received', 0),
                sale_data.get('usd_change', 0),
                sale_data.get('ves_change', 0),
                sale_data.get('notes', ''),
                sale_data.get('customer', '')
            ))
            
            # Insertar items de venta
            for item in items:
                cursor.execute('''
                INSERT INTO sale_items (sale_id, product_id, product_name, quantity,
                                      price_usd, price_ves, subtotal_usd, subtotal_ves)
                VALUES (?, ?, ?, ?, ?, ?, ?, ?)
                ''', (
                    sale_data['id'],
                    item['product_id'],
                    item['product_name'],
                    item['quantity'],
                    item['price_usd'],
                    item['price_ves'],
                    item['subtotal_usd'],
                    item['subtotal_ves']
                ))
                
                # Actualizar stock
                cursor.execute('''
                UPDATE products SET stock = stock - ? WHERE id = ?
                ''', (item['quantity'], item['product_id']))
            
            conn.commit()
            
        except Exception as e:
            conn.rollback()
            raise e
        finally:
            conn.close()

    def get_sales_report(self, start_date, end_date):
        """Obtiene reporte de ventas por período"""
        conn = self.get_connection()
        cursor = conn.cursor()
        
        cursor.execute('''
        SELECT * FROM sales 
        WHERE DATE(timestamp) BETWEEN ? AND ?
        ORDER BY timestamp DESC
        ''', (start_date, end_date))
        
        sales = cursor.fetchall()
        conn.close()
        
        return sales

