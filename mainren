            story.append(Spacer(1, 20))
            
            # Tabla de productos
            table_data = [['Producto', 'Cant.', 'Precio USD', 'Total USD']]
            
            for item in self.cart_items:
                table_data.append([
                    item['product_name'],
                    f"{item['quantity']:.2f}",
                    f"${item['price_usd']:.2f}",
                    f"${item['subtotal_usd']:.2f}"
                ])
            
            # Totales
            table_data.append(['', '', 'TOTAL USD:', f"${sale_data['total_usd']:.2f}"])
            table_data.append(['', '', 'TOTAL Bs:', f"{sale_data['total_ves']:.2f} Bs"])
            
            products_table = Table(table_data, colWidths=[3*inch, 1*inch, 1.5*inch, 1.5*inch])
            products_table.setStyle(TableStyle([
