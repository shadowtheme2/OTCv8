    def load_product_data(self):
        """Carga los datos del producto para edición"""
        if not self.product_data:
            return
            
        # self.product_data es una tupla de la base de datos
        # Orden: id, name, description, category, price_ves, price_usd, stock, min_stock, 
        #        barcode, supplier, cost_price, profit_margin, location, active, created_at
        
        self.name_input.setText(self.product_data[1] or "")
        self.description_input.setPlainText(self.product_data[2] or "")
        self.category_input.setCurrentText(self.product_data[3] or "")
        self.price_ves_input.setValue(self.product_data[4] or 0)
        self.price_usd_input.setValue(self.product_data[5] or 0)
        self.stock_input.setValue(self.product_data[6] or 0)
        self.min_stock_input.setValue(self.product_data[7] or 0)
        self.barcode_input.setText(self.product_data[8] or "")
        self.supplier_input.setText(self.product_data[9] or "")
        self.cost_price_input.setValue(self.product_data[10] or 0)
        self.profit_margin_input.setValue(self.product_data[11] or 0)
        self.location_input.setText(self.product_data[12] or "")

    def calculate_prices(self):
        """Calcula precios basado en costo y margen"""
        cost = self.cost_price_input.value()
        margin = self.profit_margin_input.value()
        
        if cost > 0 and margin > 0:
            price_usd = cost * (1 + margin / 100)
            self.price_usd_input.setValue(price_usd)
            self.calculate_price_ves()

    def calculate_price_ves(self):
        """Calcula precio en bolívares basado en USD"""
        price_usd = self.price_usd_input.value()
        price_ves = price_usd * self.exchange_rate
        self.price_ves_input.setValue(price_ves)

    def save_product(self):
        """Guarda el producto"""
        # Validaciones
        if not self.name_input.text().strip():
            QMessageBox.warning(self, "Error", "El nombre del producto es requerido")
            return
        
        if self.price_usd_input.value() <= 0:
            QMessageBox.warning(self, "Error", "El precio debe ser mayor a 0")
            return
        
        try:
            product_data = {
                'name': self.name_input.text().strip(),
                'description': self.description_input.toPlainText().strip(),
                'category': self.category_input.currentText().strip(),
                'price_ves': self.price_ves_input.value(),
                'price_usd': self.price_usd_input.value(),
                'stock': self.stock_input.value(),
                'min_stock': self.min_stock_input.value(),
                'barcode': self.barcode_input.text().strip(),
                'supplier': self.supplier_input.text().strip(),
                'cost_price': self.cost_price_input.value(),
                'profit_margin': self.profit_margin_input.value(),
                'location': self.location_input.text().strip()
            }
            
            if self.is_editing:
                # Actualizar producto existente
                product_id = self.product_data[0]  # ID del producto
                self.db_manager.update_product(product_id, product_data)
                QMessageBox.information(self, "Éxito", "Producto actualizado correctamente")
            else:
                # Agregar nuevo producto
                self.db_manager.add_product(product_data)
                QMessageBox.information(self, "Éxito", "Producto agregado correctamente")
            
            self.accept()
            
        except Exception as e:
            QMessageBox.critical(self, "Error", f"Error guardando producto: {str(e)}")

