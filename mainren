                ('FONTSIZE', (0, 0), (-1, -1), 9),
                ('BOTTOMPADDING', (0, 0), (-1, -1), 6),
                ('BACKGROUND', (0, 1), (-1, -3), colors.beige),
                ('BACKGROUND', (0, -2), (-1, -1), colors.lightgrey),
                ('FONTNAME', (0, -2), (-1, -1), 'Helvetica-Bold'),
                ('GRID', (0, 0), (-1, -1), 1, colors.black)
            ]))
            
            story.append(products_table)
            story.append(Spacer(1, 20))
            
            # Información de pago
            if sale_data['payment_method'] != 'Tarjeta':
                payment_info = []
                if sale_data['usd_received'] > 0:
                    payment_info.append(['USD Recibido:', f"${sale_data['usd_received']:.2f}"])
                if sale_data['ves_received'] > 0:
                    payment_info.append(['Bs Recibidos:', f"{sale_data['ves_received']:.2f} Bs"])
                if sale_data['usd_change'] > 0:
                    payment_info.append(['Cambio USD:', f"${sale_data['usd_change']:.2f}"])
                if sale_data['ves_change'] > 0:
                    payment_info.append(['Cambio Bs:', f"{sale_data['ves_change']:.2f} Bs"])
                
                if payment_info:
                    payment_table = Table(payment_info, colWidths=[2*inch, 2*inch])
                    payment_table.setStyle(TableStyle([
                        ('ALIGN', (0, 0), (-1, -1), 'LEFT'),
                        ('FONTNAME', (0, 0), (0, -1), 'Helvetica-Bold'),
                        ('FONTSIZE', (0, 0), (-1, -1), 10),
                        ('BOTTOMPADDING', (0, 0), (-1, -1), 6),
                    ]))
                    story.append(payment_table)
            
            story.append(Spacer(1, 30))
            story.append(Paragraph("¡Gracias por su compra!", styles['Normal']))
            
            # Generar PDF
            doc.build(story)
            
            QMessageBox.information(self, "Recibo Generado", f"Recibo guardado como: {filename}")
            
        except Exception as e:
            QMessageBox.warning(self, "Error", f"Error generando recibo: {str(e)}")

